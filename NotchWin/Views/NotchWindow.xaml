<Window x:Class="NotchWin.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:NotchWin.ViewModels"
        xmlns:converters="clr-namespace:NotchWin.Converters"
        mc:Ignorable="d"
        Title="NotchWin"
        Width="460"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Sleek Lyrics Toggle Button Style -->
        <Style x:Key="MediaLyricsToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="8,4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E2E35"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Media.IsLyricsExpanded}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#93C5FD"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Dark Control Button Style -->
        <Style x:Key="MediaControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="16" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33333A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#44444E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Play/Pause Button Style -->
        <Style x:Key="MediaPlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaControlButtonStyle}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="18" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive Sleek Seekbar Slider Style -->
        <Style x:Key="NotchSeekbarSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track -->
                            <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <!-- Track Fill & Draggable Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#3B82F6" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBorder" Width="8" Height="8" CornerRadius="4" Background="#FFFFFF">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.5"/>
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Width" Value="12"/>
                                                        <Setter TargetName="thumbBorder" Property="Height" Value="12"/>
                                                        <Setter TargetName="thumbBorder" Property="CornerRadius" Value="6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{x:Null}">
        <!-- The Pill Container with dynamic geometry for outward top ears -->
        <Grid x:Name="PillContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Cursor="Hand"
              MouseEnter="PillBorder_MouseEnter"
              MouseLeave="PillBorder_MouseLeave"
              MouseLeftButtonDown="PillBorder_MouseLeftButtonDown">

            <!-- 1. Background Filled Path with DropShadow -->
            <Path x:Name="NotchBackgroundPath"
                  Fill="#0C0C0E"
                  SnapsToDevicePixels="True">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>
                </Path.Effect>
            </Path>

            <!-- 2. Subtle Outer Border Stroke (only left, bottom, right; top bezel has no border) -->
            <Path x:Name="NotchStrokePath"
                  Stroke="#2A2A30"
                  StrokeThickness="1"
                  SnapsToDevicePixels="True"/>

            <!-- 3. Notch Content Host: Centered within the main body -->
            <Grid x:Name="ContentHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  ClipToBounds="True">

                <!-- 1. COLLAPSED CONTENT (Height ~32) -->
                <Grid x:Name="CollapsedContentGrid" Opacity="1">

                    <!-- A) DEFAULT VIEW (when NO active media) -->
                    <Grid Visibility="{Binding Media.HasMedia, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Glowing Active Dot Indicator -->
                        <Border Grid.Column="0" 
                                Width="8" Height="8" 
                                CornerRadius="4" 
                                Background="#10B981" 
                                Margin="14,0,0,0" 
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>

                        <!-- Center: Notch Title / Status -->
                        <TextBlock Grid.Column="1" 
                                   Text="NotchWin" 
                                   Foreground="#FAFAFA" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>

                        <!-- Right: Minimal Pill Dot Indicators -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Border Width="4" Height="4" CornerRadius="2" Background="#71717A" Margin="0,0,3,0"/>
                            <Border Width="4" Height="4" CornerRadius="2" Background="#71717A" Margin="0,0,3,0"/>
                            <Border Width="4" Height="4" CornerRadius="2" Background="#10B981"/>
                        </StackPanel>
                    </Grid>

                    <!-- B) ACTIVE MEDIA COLLAPSED VIEW (when playing music/video) -->
                    <Grid Visibility="{Binding Media.HasMedia, Converter={StaticResource BoolToVis}}" Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Mini Cover Artwork / Music icon -->
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4" ClipToBounds="True" Background="#1E1E22" VerticalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill"/>
                                <TextBlock Text="🎵" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Media.Thumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                            </Grid>
                        </Border>

                        <!-- Center: Song Title -->
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Media.Title}" 
                                   Foreground="#F4F4F5" 
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   TextTrimming="CharacterEllipsis" 
                                   Margin="8,0,8,0" 
                                   VerticalAlignment="Center"/>

                        <!-- Right: Music Icon Indicator (Static, 0% CPU) -->
                        <TextBlock Grid.Column="2" 
                                   Text="🎵" 
                                   FontSize="11" 
                                   Foreground="#10B981" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,2,0"/>
                    </Grid>
                </Grid>

                <!-- 2. EXPANDED CONTENT (Height ~150 / ~330 with Lyrics) -->
                <Grid x:Name="ExpandedContentGrid" Opacity="0" Visibility="Collapsed" Margin="16,10,16,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with App ID / Live Badge -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="🎵 Sekarang Memutar" 
                                       Foreground="#E4E4E7" 
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="11" 
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" Background="#222226" CornerRadius="10" Padding="8,3">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}">
                                    <Path Data="M 1,1 H 3 V 8 H 1 Z M 5,1 H 7 V 8 H 5 Z" Fill="#10B981" Stretch="Uniform" Width="6" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="MEMUTAR" Foreground="#10B981" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Media.IsPlaying, Converter={StaticResource InverseBoolToVis}}">
                                    <Path Data="M 1,1 L 6,4.5 L 1,8 Z" Fill="#A1A1AA" Stretch="Uniform" Width="6" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="JEDA" Foreground="#A1A1AA" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 1: Player Card (Artwork + Track Details + Interactive Seekbar) -->
                    <Border Grid.Row="1" Background="#16161A" CornerRadius="10" BorderBrush="#26262B" BorderThickness="1" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Large Album Artwork (56x56) -->
                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8" Background="#222226" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid>
                                    <Image Source="{Binding Media.Thumbnail}" Stretch="UniformToFill"/>
                                    <TextBlock Text="🎵" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Media.Thumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- Title, Artist, & Interactive Seekbar -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title -->
                                <TextBlock Grid.Row="0" 
                                           Text="{Binding Media.Title, FallbackValue='Tidak ada media yang diputar'}" 
                                           Foreground="#FFFFFF" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Artist -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Media.Artist, FallbackValue='Mulai putar lagu di Spotify atau YouTube'}" 
                                           Foreground="#A1A1AA" 
                                           FontSize="11" 
                                           TextTrimming="CharacterEllipsis" 
                                           Margin="0,2,0,4"/>

                                <!-- Interactive Seekbar Slider -->
                                <Grid Grid.Row="2">
                                    <Slider x:Name="MediaSeekSlider"
                                            Style="{StaticResource NotchSeekbarSliderStyle}"
                                            Minimum="0"
                                            Maximum="{Binding Media.DurationTotalSeconds}"
                                            Value="{Binding Media.PositionSeconds, Mode=TwoWay}"
                                            PreviewMouseDown="MediaSeekSlider_PreviewMouseDown"
                                            PreviewMouseUp="MediaSeekSlider_PreviewMouseUp"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 2: Control Buttons Row (Lyrics Button, Previous, Play/Pause, Next + Formatted Duration) -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <!-- Lyrics Button on the left -->
                        <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                                Style="{StaticResource MediaLyricsToggleButtonStyle}"
                                Command="{Binding Media.ToggleLyricsCommand}"
                                ToolTip="Tampilkan / Sembunyikan Lirik">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎤" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Lirik" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Playback Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Previous -->
                            <Button Style="{StaticResource MediaControlButtonStyle}" 
                                    Width="36" Height="30" 
                                    Command="{Binding Media.SkipPreviousCommand}"
                                    ToolTip="Lagu Sebelumnya">
                                <Path Data="M 1,2 V 12 H 3.5 V 2 Z M 13,2 L 4.5,7 L 13,12 Z" 
                                      Fill="#E4E4E7" 
                                      Stretch="Uniform" 
                                      Width="12" Height="12" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Play / Pause -->
                            <Button Style="{StaticResource MediaPlayPauseButtonStyle}" 
                                    Width="44" Height="32" 
                                    Margin="12,0"
                                    Command="{Binding Media.TogglePlayPauseCommand}"
                                    ToolTip="Play / Pause">
                                <Grid>
                                    <!-- Play icon (triangle) when paused -->
                                    <Path Data="M 2,1 L 13,7 L 2,13 Z" 
                                          Fill="#FFFFFF" 
                                          Stretch="Uniform" 
                                          Width="12" Height="13" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="2,0,0,0"
                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource InverseBoolToVis}}"/>

                                    <!-- Pause icon (two bars) when playing -->
                                    <Path Data="M 1,1 H 4.5 V 13 H 1 Z M 7.5,1 H 11 V 13 H 7.5 Z" 
                                          Fill="#FFFFFF" 
                                          Stretch="Uniform" 
                                          Width="11" Height="13" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding Media.IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>

                            <!-- Next -->
                            <Button Style="{StaticResource MediaControlButtonStyle}" 
                                    Width="36" Height="30" 
                                    Command="{Binding Media.SkipNextCommand}"
                                    ToolTip="Lagu Berikutnya">
                                <Path Data="M 1,2 L 9.5,7 L 1,12 Z M 10.5,2 V 12 H 13 V 2 Z" 
                                      Fill="#E4E4E7" 
                                      Stretch="Uniform" 
                                      Width="12" Height="12" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Duration string on the right -->
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Media.FormattedTime}" 
                                   Foreground="#71717A" 
                                   FontSize="10"/>
                    </Grid>

                    <!-- Row 3: Animated 3-Line Karaoke Lyrics Panel (Height 108 with Smooth Unfold) -->
                    <Border x:Name="LyricsPanelBorder"
                            Grid.Row="3" 
                            Margin="0,0,0,0" 
                            Height="0" 
                            Opacity="0"
                            Background="#111114" 
                            CornerRadius="12" 
                            BorderBrush="#242428" 
                            BorderThickness="1"
                            ClipToBounds="True"
                            PreviewMouseWheel="LyricsBorder_PreviewMouseWheel">
                        <!-- Top & Bottom smooth fade gradient mask -->
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.28"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.72"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>

                        <Grid ClipToBounds="True">
                            <!-- Status message (Loading or Not Found or Instrumental) -->
                            <TextBlock Text="{Binding Media.LyricsStatusMessage}"
                                       Foreground="#71717A"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Media.HasLyrics, Converter={StaticResource InverseBoolToVis}}"/>

                            <!-- 3-Line Sliding Container with TranslateTransform -->
                            <Grid VerticalAlignment="Top" Visibility="{Binding Media.HasLyrics, Converter={StaticResource BoolToVis}}">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="LyricsTranslateTransform" Y="36"/>
                                </Grid.RenderTransform>

                                <ItemsControl x:Name="LyricsItemsControl" ItemsSource="{Binding Media.LyricsLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="36" 
                                                    Background="Transparent" 
                                                    Cursor="Hand" 
                                                    MouseDown="LyricLine_MouseDown" 
                                                    SnapsToDevicePixels="True"
                                                    Padding="12,0">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="{Binding FontWeight}"
                                                           Foreground="{Binding ForegroundBrush}"
                                                           Opacity="{Binding Opacity}"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
