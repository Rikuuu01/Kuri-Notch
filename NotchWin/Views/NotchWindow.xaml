              <TextBlock Foreground="#E4E4E7" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding Clock.CurrentTime}" />
