                      <Button Style="{StaticResource MediaControlButtonStyle}" Width="34" Height="34" ToolTip="Lagu Berikutnya" Command="{Binding Media.SkipNextCommand}">
                        <Grid Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Path Data="M3,2.5 L11.5,8 L3,13.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                          <Path Data="M13.5,2 L13.5,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                      </Button>
                    </StackPanel>
                    <Border Grid.Column="2" Width="30" Height="30" />
                  </Grid>
                </Grid>
                <Border Name="LyricsDivider" Grid.Column="1" Width="1" Background="#1FFFFFFF" Margin="8,4,10,4" VerticalAlignment="Stretch" Opacity="0" />
                <Grid Name="LyricsContainer" Column="2" Height="150" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                  <UIElement.RenderTransform>
                    <TranslateTransform x:Name="LyricsContainerTranslate" X="60" Y="0" />
                  </UIElement.RenderTransform>
                  <Border ClipToBounds="True" Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="2,0" VerticalAlignment="Stretch">
                    <Grid VerticalAlignment="Stretch" ClipToBounds="True">
                      <!-- VIEW 1: TAMPILAN LIRIK AKTIF (Ketika Picker Tertutup) -->
                      <Grid Visibility="{Binding Media.IsLyricsVersionPickerOpen, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="26" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <!-- Unified Sleek Lyrics Top Bar (Version & Offset Controls) in Dedicated Row 0 -->
                        <Grid Grid.Row="0" VerticalAlignment="Center" Margin="8,2,8,2">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>


                          <!-- Left: Sleek Lyrics Version Chip -->
                          <Button Grid.Column="0" Name="LyricsVersionChipBtn" Height="22" Padding="7,0" Background="#E6161622" BorderBrush="#28FFFFFF" BorderThickness="1" Cursor="Hand" FocusVisualStyle="{x:Null}" Command="{Binding Media.ToggleLyricsVersionPickerCommand}" ToolTip="{Binding L10n[Media.LyricsVersionTooltip]}" Visibility="{Binding Media.HasLyricsCandidateChoices, Converter={StaticResource BoolToVis}}">
                            <Control.Template>
                              <ControlTemplate TargetType="{x:Type Button}">
                                <Border Name="vChipBdr" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M2,10 A2,2 0 1 1 0,8 A2,2 0 0 1 2,10 M2,8 L2,2 L7,1 L7,6 A2,2 0 1 1 5,4 A2,2 0 0 1 7,6" Fill="{DynamicResource AccentLightBrush}" Stretch="Uniform" Width="8" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" Text="{Binding DataContext.Media.SelectedLyricsVersionLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Path Data="M0,0 L3,3 L6,0" Stroke="#A1A1AA" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="6" Height="3.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="vChipBdr" Property="Border.Background" Value="#252538" />
                                    <Setter TargetName="vChipBdr" Property="Border.BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Control.Template>
                          </Button>


                          <!-- Right: Minimalist Modern Lyrics Offset Pill -->
                          <Border Grid.Column="2" Height="22" Background="#E6161622" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="11" Padding="3,1" SnapsToDevicePixels="True" Visibility="{Binding Media.HasLyrics, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Width="16" Height="16" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Perlambat lirik (-100ms)" Command="{Binding Media.DecreaseLyricOffsetCommand}" FocusVisualStyle="{x:Null}">
                                <Control.Template>
                                  <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Name="decBdr" Background="{TemplateBinding Control.Background}" CornerRadius="8">
                                      <Path Data="M0,0 L6,0" Stroke="#A1A1AA" StrokeThickness="1.4" StrokeStartLineCap="Round" Width="6" Height="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="decBdr" Property="Border.Background" Value="#30FFFFFF" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Control.Template>
                              </Button>


                              <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Offset Lirik (Klik untuk Reset ke 0.0s)" Margin="4,0" Command="{Binding Media.ResetLyricOffsetCommand}" FocusVisualStyle="{x:Null}">
                                <Control.Template>
                                  <ControlTemplate TargetType="{x:Type Button}">
                                    <TextBlock Name="offTxt" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI Variable Text, Segoe UI, sans-serif" Foreground="#E4E4E7" VerticalAlignment="Center" Text="{Binding DataContext.Media.FormattedLyricOffset, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="offTxt" Property="TextBlock.Foreground" Value="{DynamicResource AccentLightBrush}" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Control.Template>
                              </Button>


                              <Button Width="16" Height="16" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Percepat lirik (+100ms)" Command="{Binding Media.IncreaseLyricOffsetCommand}" FocusVisualStyle="{x:Null}">
                                <Control.Template>
                                  <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Name="incBdr" Background="{TemplateBinding Control.Background}" CornerRadius="8">
                                      <Path Data="M0,3 L6,3 M3,0 L3,6" Stroke="#A1A1AA" StrokeThickness="1.4" StrokeStartLineCap="Round" Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="incBdr" Property="Border.Background" Value="#30FFFFFF" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Control.Template>
                              </Button>
                            </StackPanel>
                          </Border>
                        </Grid>


                        <!-- Row 1: Content Grid -->
                        <Grid Grid.Row="1">
                          <!-- Scrolling lyrics canvas wrapped with OpacityMask gradient -->
                          <Grid ClipToBounds="True">
                            <UIElement.OpacityMask>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.20" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.76" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                              </LinearGradientBrush>
                            </UIElement.OpacityMask>
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,0,14,0" Visibility="{Binding Media.HasLyrics, Converter={StaticResource InverseBoolToVis}}">
                              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Text="{Binding Media.DisplayTitle}" />
                                <TextBlock Foreground="#A1A1AA" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" FontWeight="Normal" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Text="{Binding Media.DisplayArtist}" Visibility="{Binding Media.HasArtist, Converter={StaticResource BoolToVis}}" />
                                <Border Background="#16FFFFFF" CornerRadius="8" Padding="7,2" Margin="0,6,0,0" HorizontalAlignment="Center" Visibility="{Binding Media.HasLyricsStatusMessage, Converter={StaticResource BoolToVis}}">
                                  <TextBlock Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold" FontStyle="Italic" HorizontalAlignment="Center" Text="{Binding Media.LyricsStatusMessage}" />
                                </Border>
                              </StackPanel>
                            </Grid>
                            <Canvas Width="340" Height="114" ClipToBounds="True" VerticalAlignment="Top" Visibility="{Binding Media.HasLyrics, Converter={StaticResource BoolToVis}}" PreviewMouseWheel="Lyrics_PreviewMouseWheel">
                              <ItemsControl Name="LyricsItemsControl" Width="340" Canvas.Left="0" Canvas.Top="0" ItemsSource="{Binding Media.LyricsLines}">
                                <UIElement.RenderTransform>
                                  <TranslateTransform x:Name="LyricsTranslateTransform" Y="38" />
                                </UIElement.RenderTransform>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Height="36" Cursor="Hand" SnapsToDevicePixels="True" Padding="6,0" CornerRadius="8" MouseDown="LyricLine_MouseDown">
                                      <FrameworkElement.Style>
                                        <Style TargetType="{x:Type Border}">
                                          <Setter Property="Background" Value="#00FFFFFF" />
                                          <Style.Triggers>
                                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                                              <Setter Property="Background" Value="#14FFFFFF" />
                                            </Trigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                      <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Name="LyricText" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Opacity="0.45" TextWrapping="NoWrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="34" MaxWidth="328" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}" Foreground="{Binding ForegroundBrush}" Text="{Binding Text}" Visibility="{Binding IsInterlude, Converter={StaticResource InverseBoolToVis}}" />
                                        <TextBlock Name="LyricKaraokeText" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Foreground="#FFFFFF" TextWrapping="NoWrap" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="34" MaxWidth="328" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="{Binding FontSize}" FontWeight="{Binding FontWeight}" Text="{Binding Text}" Visibility="{Binding IsInterlude, Converter={StaticResource InverseBoolToVis}}">
                                          <UIElement.Clip>
                                            <MultiBinding Converter="{StaticResource KaraokeClipConverter}">
                                              <Binding RelativeSource="{RelativeSource Self}" />
                                              <Binding Path="IsActive" />
                                              <Binding Path="DataContext.Media.ActiveLyricProgress" RelativeSource="{RelativeSource AncestorType=Window}" />
                                              <Binding Path="DataContext.Media.LyricsKaraokeEnabled" RelativeSource="{RelativeSource AncestorType=Window}" />
                                              <Binding Path="DataContext.Media.IsCurrentLyricsUntimed" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                          </UIElement.Clip>
                                        </TextBlock>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsInterlude, Converter={StaticResource BoolToVis}}">
                                          <Path Data="M2,11 A2,2 0 1 1 0,9A2,2 0 0 1 2,11M2,9 L2,3 L8,1 L8,7 A2,2 0 1 1 6,5A2,2 0 0 1 8,7L8,2 L2,4 L2,9" Fill="{DynamicResource AccentLightBrush}" Stretch="Uniform" Width="12" Height="12" Opacity="0.80" VerticalAlignment="Center" />
                                        </Grid>
                                      </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding IsActive}">
                                        <TriggerBase.EnterActions>
                                          <BeginStoryboard>
                                            <Storyboard>
                                              <DoubleAnimation Storyboard.TargetName="LyricText" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                  <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                              </DoubleAnimation>
                                            </Storyboard>
                                          </BeginStoryboard>
                                        </TriggerBase.EnterActions>
                                        <TriggerBase.ExitActions>
                                          <BeginStoryboard>
                                            <Storyboard>
                                              <DoubleAnimation Storyboard.TargetName="LyricText" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                  <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                              </DoubleAnimation>
                                            </Storyboard>
                                          </BeginStoryboard>
                                        </TriggerBase.ExitActions>
                                      </DataTrigger>
                                    </DataTemplate.Triggers>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Canvas>
                          </Grid>


                          <!-- Crisp & Beautifully Padded Lyrics Source Micro-Badge (Outside OpacityMask) -->
                          <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,2" Background="#CC12121A" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="3.5" Padding="4.5,1" IsHitTestVisible="False" SnapsToDevicePixels="True" Visibility="{Binding Media.HasLyricsSourceInfo, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="#8E8E98" FontSize="8.5" FontWeight="SemiBold" ToolTip="Sumber &amp; tipe lirik" Text="{Binding Media.LyricsSourceInfo}" />
                          </Border>
                        </Grid>
                      </Grid>


                      <!-- VIEW 2: TAMPILAN PEMILIH VERSI LIRIK IN-PLACE (Ketika Picker Terbuka) -->
                      <Border Visibility="{Binding Media.IsLyricsVersionPickerOpen, Converter={StaticResource BoolToVis}}" Background="#161622" CornerRadius="10" Padding="8,6" VerticalAlignment="Stretch">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>


                          <!-- In-Place Header Bar -->
                          <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding Media.ToggleLyricsVersionPickerCommand}" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Padding="4,2">
                              <Control.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                  <Border Name="backBdr" Background="#00FFFFFF" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                      <Path Name="backArrow" Data="M4.5,1 L1.5,4.5 L4.5,8" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="6" Height="8" Margin="0,0,4,0" VerticalAlignment="Center" />
                                      <TextBlock Name="backTxt" Text="{Binding L10n[Media.LyricsBackToLyrics]}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                                      <Setter TargetName="backArrow" Property="Path.Stroke" Value="#FFFFFF" />
                                      <Setter TargetName="backTxt" Property="TextBlock.Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                      <Setter TargetName="backBdr" Property="UIElement.Opacity" Value="0.65" />
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Control.Template>
                            </Button>


                            <TextBlock Grid.Column="1" Text="{Binding L10n[Media.LyricsPickerTitle]}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />


                            <Button Grid.Column="2" Command="{Binding Media.ToggleLyricsVersionPickerCommand}" Width="20" Height="20" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Right">
                              <Control.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                  <Border Name="closeBdr" Background="#00FFFFFF" BorderThickness="0" CornerRadius="10">
                                    <Path Name="closeIcon" Data="M1,1 L7,7 M7,1 L1,7" Stroke="#A1A1AA" StrokeThickness="1.4" StrokeStartLineCap="Round" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                  <ControlTemplate.Triggers>
                                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                                      <Setter TargetName="closeIcon" Property="Path.Stroke" Value="#FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                      <Setter TargetName="closeBdr" Property="UIElement.Opacity" Value="0.65" />
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Control.Template>
                            </Button>
                          </Grid>


                          <!-- In-Place Candidate List -->
                          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ModernSlimScrollViewer}">
                            <StackPanel>
                              <!-- Auto option -->
                              <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,1" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.Media.UseAutoLyricsCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Control.Template>
                                  <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Name="autoBd" Background="#14FFFFFF" CornerRadius="6" Padding="8,4" Margin="0,1">
                                      <Grid>
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="14" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Text="{Binding L10n[Media.LyricsVersionAuto]}" />
                                        <Path Grid.Column="1" Data="M1,4.5 L4,7.5 L9.5,1.5" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding Media.IsAutoLyricsCandidateSelected, Converter={StaticResource BoolToVis}}" />
                                      </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="autoBd" Property="Border.Background" Value="#25FFFFFF" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Control.Template>
                              </Button>


                              <!-- Candidate Items -->
                              <ItemsControl ItemsSource="{Binding Media.LyricsCandidates}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,1" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.Media.SelectLyricsCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <Border Name="itemBd" Background="#00FFFFFF" CornerRadius="6" Padding="6,4">
                                            <Grid>
                                              <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="14" />
                                              </Grid.ColumnDefinitions>
                                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding TrackName}" />
                                                <TextBlock FontSize="10" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="{Binding Subtitle}" />
                                              </StackPanel>
                                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                                                <Border CornerRadius="3" Padding="4,1" Margin="0,0,4,0" VerticalAlignment="Center">
                                                  <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                      <Setter Property="Background" Value="#1AFFFFFF" />
                                                      <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpicyLyrics}" Value="True">
                                                          <Setter Property="Background" Value="#33E11D48" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLrcRed}" Value="True">
                                                          <Setter Property="Background" Value="#33EF4444" />
                                                        </DataTrigger>
                                                      </Style.Triggers>
                                                    </Style>
                                                  </Border.Style>
                                                  <TextBlock FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                      <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Setter Property="Text" Value="{Binding ProviderLabel}" />
                                                        <Style.Triggers>
                                                          <DataTrigger Binding="{Binding IsSpicyLyrics}" Value="True">
                                                            <Setter Property="Foreground" Value="#FDA4AF" />
                                                          </DataTrigger>
                                                          <DataTrigger Binding="{Binding IsLrcRed}" Value="True">
                                                            <Setter Property="Foreground" Value="#FCA5A5" />
                                                          </DataTrigger>
                                                        </Style.Triggers>
                                                      </Style>
                                                    </TextBlock.Style>
                                                  </TextBlock>
                                                </Border>
                                                <TextBlock FontSize="10" Foreground="#71717A" VerticalAlignment="Center" Text="{Binding DurationText}" />
                                                <Border Background="#16FFFFFF" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                                  <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding TypeLabel}" />
                                                </Border>
                                              </StackPanel>
                                              <Path Grid.Column="2" Data="M1,4.5 L4,7.5 L9.5,1.5" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="10" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                          </Border>
                                          <ControlTemplate.Triggers>
                                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                                              <Setter TargetName="itemBd" Property="Border.Background" Value="#2D2D3D" />
                                            </Trigger>
                                          </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </ScrollViewer>
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Grid>
            <Border Name="SlideWeatherCard" Width="584" Height="208" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Background="#00FFFFFF" BorderThickness="0" Visibility="Collapsed" Opacity="0" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="204" />
                  <ColumnDefinition Width="9" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="14" ClipToBounds="True" BorderBrush="#385F8A" BorderThickness="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                      <GradientStop Color="#2A537E" Offset="0.0" />
                      <GradientStop Color="#1C3F65" Offset="0.45" />
                      <GradientStop Color="#142F4D" Offset="1.0" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid>
                    <Grid Name="WeatherRainContainer" IsHitTestVisible="False" Visibility="{Binding Weather.IsRaining, Converter={StaticResource BoolToVis}}">
                      <UIElement.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#00000000" Offset="0.0" />
                          <GradientStop Color="#FF000000" Offset="0.08" />
                          <GradientStop Color="#FF000000" Offset="0.88" />
                          <GradientStop Color="#00000000" Offset="1.0" />
                        </LinearGradientBrush>
                      </UIElement.OpacityMask>
                      <Canvas Opacity="0.14">
                        <UIElement.RenderTransform>
                          <TranslateTransform x:Name="RainBgTranslate" />
                        </UIElement.RenderTransform>
                        <Line X1="20" Y1="10" X2="17" Y2="26" Stroke="#E0F2FE" StrokeThickness="0.8" />
                        <Line X1="55" Y1="70" X2="52" Y2="88" Stroke="#E0F2FE" StrokeThickness="0.8" />
                        <Line X1="85" Y1="30" X2="82" Y2="48" Stroke="#E0F2FE" StrokeThickness="0.8" />
