<Window x:Class="NotchWin.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:NotchWin.ViewModels"
        mc:Ignorable="d"
        Title="NotchWin"
        Width="440"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Grid Background="{x:Null}">
        <!-- The Pill Container with dynamic geometry for outward top ears -->
        <Grid x:Name="PillContainer"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Cursor="Hand"
              MouseEnter="PillBorder_MouseEnter"
              MouseLeave="PillBorder_MouseLeave"
              MouseLeftButtonDown="PillBorder_MouseLeftButtonDown">

            <!-- 1. Background Filled Path with DropShadow -->
            <Path x:Name="NotchBackgroundPath"
                  Fill="#0C0C0E"
                  SnapsToDevicePixels="True">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>
                </Path.Effect>
            </Path>

            <!-- 2. Subtle Outer Border Stroke (only left, bottom, right; top bezel has no border) -->
            <Path x:Name="NotchStrokePath"
                  Stroke="#2A2A30"
                  StrokeThickness="1"
                  SnapsToDevicePixels="True"/>

            <!-- 3. Notch Content Host: Centered within the main body -->
            <Grid x:Name="ContentHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  ClipToBounds="True">

                <!-- COLLAPSED CONTENT -->
                <Grid x:Name="CollapsedContentGrid" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing Active Dot Indicator -->
                    <Border Grid.Column="0" 
                            Width="8" Height="8" 
                            CornerRadius="4" 
                            Background="#10B981" 
                            Margin="14,0,0,0" 
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981" Opacity="0.8"/>
                        </Border.Effect>
                    </Border>

                    <!-- Center: Notch Title / Status -->
                    <TextBlock Grid.Column="1" 
                               Text="NotchWin" 
                               Foreground="#FAFAFA" 
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <!-- Right: Minimal Pill Dot Indicators -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border Width="4" Height="4" CornerRadius="2" Background="#71717A" Margin="0,0,3,0"/>
                        <Border Width="4" Height="4" CornerRadius="2" Background="#71717A" Margin="0,0,3,0"/>
                        <Border Width="4" Height="4" CornerRadius="2" Background="#10B981"/>
                    </StackPanel>
                </Grid>

                <!-- EXPANDED CONTENT -->
                <Grid x:Name="ExpandedContentGrid" Opacity="0" Visibility="Collapsed" Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6" Margin="0,0,8,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#3B82F6" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="Dynamic Notch" 
                                       Foreground="#F4F4F5" 
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                       FontSize="12" 
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" Background="#27272A" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="MVP Fase 1" Foreground="#A1A1AA" FontSize="10" FontWeight="Medium"/>
                        </Border>
                    </Grid>

                    <!-- Middle: Preview Card -->
                    <Border Grid.Row="1" Background="#18181B" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#27272A" Margin="0,0,12,0">
                                <TextBlock Text="🎵" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Media Widget Siap di Fase 2" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Lengkungan Bezel Apple Sempurna" Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0"/>
                                
                                <Border Height="3" Background="#3F3F46" CornerRadius="1.5" Margin="0,6,0,0">
                                    <Border HorizontalAlignment="Left" Width="70" Background="#3B82F6" CornerRadius="1.5"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Footer: Shortcuts info -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="Klik untuk Kunci Terbuka / Tutup • Tekan Esc untuk Keluar" Foreground="#71717A" FontSize="10" HorizontalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
