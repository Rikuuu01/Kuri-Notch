                <ColumnDefinition Width="Auto" />

              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding Battery.StatusIcon}" />

              <TextBlock Grid.Column="1" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Battery.StatusTitle}" Foreground="{Binding Battery.BatteryFillBrush}" />

              <Border Grid.Column="2" Background="#16161A" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" BorderBrush="{Binding Battery.BatteryOutlineBrush}">

                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" FontWeight="Bold" Text="{Binding Battery.FormattedPercent}" Foreground="{Binding Battery.BatteryTextBrush}" />

              </Border>

            </Grid>

            <Grid Margin="12,0,12,0" Visibility="{Binding WidgetHost.CurrentWidgetType, Converter={StaticResource WidgetTypeToVis}, ConverterParameter=Notification}">

              <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="Auto" />

              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">

                <!-- Maskot Companion saat notifikasi muncul di bilah collapsed -->
                <controls:MochiPetControl x:Name="NotificationCollapsedPet" Width="26" Height="19" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsPetEnabled, Converter={StaticResource BoolToVis}}" />

                <!-- Fallback ikon tradisional & ripple jika pet nonaktif -->
                <ContentControl VerticalAlignment="Center" Visibility="{Binding IsPetEnabled, Converter={StaticResource InverseBoolToVis}}">

                <Control.Template>

                  <ControlTemplate TargetType="{x:Type ContentControl}">

                    <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">

                      <Ellipse Name="NotifRippleRing" Width="18" Height="18" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">

                        <UIElement.RenderTransform>

                          <ScaleTransform x:Name="NotifRippleScale" ScaleX="0.75" ScaleY="0.75" />

                        </UIElement.RenderTransform>

                      </Ellipse>

                      <Grid Name="NotifIconContainer" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <UIElement.RenderTransform>

                          <ScaleTransform x:Name="NotifIconScale" ScaleX="1.0" ScaleY="1.0" />

                        </UIElement.RenderTransform>

                        <Path Name="NotifMosquePath" Data="M8,0 L9,2 L11,2 L11,3 C11,4.5 9.5,5.8 8,6 C6.5,5.8 5,4.5 5,3 L5,2 L7,2 M2,7 L8,3 L14,7 L14,15 L10,15 L10,10 C10,8.9 9.1,8 8,8 C6.9,8 6,8.9 6,10 L6,15 L2,15" Fill="{DynamicResource AccentLightBrush}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Notification.IsPrayer, Converter={StaticResource BoolToVis}}">

                          <UIElement.Effect>

                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#60A5FA" Opacity="0.75" RenderingBias="Performance" />

                          </UIElement.Effect>

                        </Path>

                        <TextBlock FontSize="14" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Notification.Icon}" Visibility="{Binding Notification.IsPrayer, Converter={StaticResource InverseBoolToVis}}" />

                      </Grid>

                    </Grid>

                    <ControlTemplate.Triggers>

                      <Trigger Property="UIElement.IsVisible" Value="True">

                        <TriggerBase.EnterActions>

                          <BeginStoryboard Name="NotifIconPulseAnim">

                            <Storyboard RepeatBehavior="3x">

                              <DoubleAnimation Storyboard.TargetName="NotifIconScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="1.18" Duration="0:0:0.75" AutoReverse="True">

                                <DoubleAnimation.EasingFunction>

                                  <QuadraticEase EasingMode="EaseInOut" />

                                </DoubleAnimation.EasingFunction>

                              </DoubleAnimation>

                              <DoubleAnimation Storyboard.TargetName="NotifIconScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="1.18" Duration="0:0:0.75" AutoReverse="True">

                                <DoubleAnimation.EasingFunction>

                                  <QuadraticEase EasingMode="EaseInOut" />

                                </DoubleAnimation.EasingFunction>

                              </DoubleAnimation>

                              <DoubleAnimation Storyboard.TargetName="NotifRippleScale" Storyboard.TargetProperty="ScaleX" From="0.75" To="1.75" Duration="0:0:1.35">

                                <DoubleAnimation.EasingFunction>

                                  <CircleEase EasingMode="EaseOut" />

                                </DoubleAnimation.EasingFunction>

                              </DoubleAnimation>

                              <DoubleAnimation Storyboard.TargetName="NotifRippleScale" Storyboard.TargetProperty="ScaleY" From="0.75" To="1.75" Duration="0:0:1.35">

                                <DoubleAnimation.EasingFunction>

                                  <CircleEase EasingMode="EaseOut" />

                                </DoubleAnimation.EasingFunction>

                              </DoubleAnimation>

                              <DoubleAnimation Storyboard.TargetName="NotifRippleRing" Storyboard.TargetProperty="Opacity" From="0.7" To="0.0" Duration="0:0:1.35">

                                <DoubleAnimation.EasingFunction>

                                  <QuadraticEase EasingMode="EaseOut" />

                                </DoubleAnimation.EasingFunction>

                              </DoubleAnimation>

                            </Storyboard>

                          </BeginStoryboard>

                        </TriggerBase.EnterActions>

                        <TriggerBase.ExitActions>

                          <StopStoryboard BeginStoryboardName="NotifIconPulseAnim" />

                        </TriggerBase.ExitActions>

                      </Trigger>

                    </ControlTemplate.Triggers>

                  </ControlTemplate>

                </Control.Template>

              </ContentControl>

              </Grid>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding Notification.Title}" />

                <TextBlock Foreground="#A1A1AA" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Notification.Message}" Visibility="{Binding Notification.IsWaterAlarm, Converter={StaticResource InverseBoolToVis}}" />

              </StackPanel>



              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Notification.IsWaterAlarm, Converter={StaticResource BoolToVis}}">

                <Button Style="{StaticResource WaterAlarmActionButtonStyle}" Command="{Binding SnoozeWaterAlarmCommand}" ToolTip="Snooze for 2 minutes">

                  <TextBlock Text="{Binding L10n[Notification.WaterSnoozeAction]}" Foreground="#F59E0B" />

                </Button>

                <Button Style="{StaticResource WaterAlarmActionButtonStyle}" Command="{Binding DrinkWaterFromAlarmCommand}" ToolTip="Log 250 ml and finish">

                  <TextBlock Text="{Binding L10n[Notification.WaterDrinkAction]}" Foreground="#4ADE80" />

                </Button>

              </StackPanel>

            </Grid>

          </Grid>

          <!-- Overlay privasi collapsed: melayang di bibir kanan notch, posisi independen dari karakter/widget -->

          <Grid Name="PrivacyOverlayHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,5,0" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">

            <UIElement.RenderTransform>

              <TranslateTransform x:Name="PrivacyOverlayTranslate" X="0" Y="0" />

            </UIElement.RenderTransform>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2.5,0,0">

              <Ellipse Width="5" Height="5" Fill="#F97316" Margin="1.5,0" Visibility="{Binding IsMicrophoneInUse, Converter={StaticResource BoolToVis}}">

                <UIElement.Effect>

                  <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#F97316" Opacity="0.95" RenderingBias="Performance" />

                </UIElement.Effect>

              </Ellipse>

              <Ellipse Width="5" Height="5" Fill="#22C55E" Margin="1.5,0" Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}">

                <UIElement.Effect>

                  <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#22C55E" Opacity="0.95" RenderingBias="Performance" />

                </UIElement.Effect>

              </Ellipse>

            </StackPanel>

          </Grid>

        </Grid>

        <Grid Name="ExpandedContentGrid" Opacity="0" Visibility="Collapsed" Margin="16,6,16,6" RenderTransformOrigin="0.5, 0" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" PreviewMouseWheel="ExpandedContentGrid_PreviewMouseWheel">

          <UIElement.RenderTransform>

            <TransformGroup>

              <ScaleTransform x:Name="ExpandedContentScale" ScaleX="1.0" ScaleY="1.0" />

              <TranslateTransform x:Name="ExpandedContentTranslate" X="0" Y="0" />

            </TransformGroup>

          </UIElement.RenderTransform>

          <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

          </Grid.RowDefinitions>

          <Grid Row="0" Margin="0,0,0,4">

            <Grid.ColumnDefinitions>

              <ColumnDefinition Width="Auto" />

              <ColumnDefinition Width="*" />

              <ColumnDefinition Width="Auto" />

            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="#A1A1AA" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="11" FontWeight="SemiBold" Text="{Binding Clock.FullDate}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

              <controls:MochiPetControl Width="26" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Pet Companion" Visibility="{Binding IsPetEnabled, Converter={StaticResource BoolToVis}}" />

              <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" Padding="2" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" Click="SettingsButton_Click" FocusVisualStyle="{x:Null}" ToolTip="{Binding L10n[Tab.Settings]}">

                <Control.Template>

                  <ControlTemplate TargetType="{x:Type Button}">

                    <Border Name="SettingsBorder" Background="#00FFFFFF" CornerRadius="4" Padding="2">

                      <Path Data="M2,3.5 L4.5,3.5 M7.5,3.5 L12,3.5 M4.5,2 L4.5,5 M2,7 L8,7 M11,7 L12,7 M8,5.5 L8,8.5 M2,10.5 L5.5,10.5 M8.5,10.5 L12,10.5 M5.5,9 L5.5,12" Stroke="#9CA3AF" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                      <Trigger Property="UIElement.IsMouseOver" Value="True">

                        <Setter TargetName="SettingsBorder" Property="Border.Background" Value="#2A2A38" />

                      </Trigger>

                    </ControlTemplate.Triggers>

                  </ControlTemplate>

                </Control.Template>

              </Button>

              <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Margin="0,0,6,0" Padding="2" VerticalAlignment="Center" Command="{Binding TogglePinCommand}" FocusVisualStyle="{x:Null}" ToolTip="{Binding PinToolTipText}">

                <Control.Template>

                  <ControlTemplate TargetType="{x:Type Button}">

                    <Border Name="PinBorder" Background="#00FFFFFF" CornerRadius="4" Padding="2">

                      <Path Data="M6,2 C5.4,2 5,2.4 5,3 L5,6 L3.5,8 C3.2,8.4 3.5,9 4,9 L7,9 L7,14 L8,15.5 L9,14 L9,9 L12,9 C12.5,9 12.8,8.4 12.5,8 L11,6 L11,3 C11,2.4 10.6,2 10,2" Width="10.5" Height="10.5" Stretch="Uniform" Fill="{DynamicResource AccentLightBrush}">

                        <UIElement.RenderTransform>

                          <RotateTransform CenterX="5" CenterY="5" Angle="{Binding PinRotationAngle}" />

                        </UIElement.RenderTransform>

                      </Path>

                    </Border>

                    <ControlTemplate.Triggers>

                      <Trigger Property="UIElement.IsMouseOver" Value="True">

                        <Setter TargetName="PinBorder" Property="Border.Background" Value="#2A2A38" />

                      </Trigger>

                    </ControlTemplate.Triggers>

                  </ControlTemplate>

                </Control.Template>

              </Button>

              <TextBlock Foreground="#E4E4E7" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding Clock.CurrentTime}" />

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding Battery.HasBattery, Converter={StaticResource BoolToVis}}">

                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0" Text="{Binding Battery.FormattedPercent}" Foreground="{Binding Battery.BatteryTextBrush}" />

                <Grid Width="22" Height="11" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">

                  <Border Width="19" Height="11" HorizontalAlignment="Left" CornerRadius="3" BorderThickness="1" Background="#161620" BorderBrush="{Binding Battery.BatteryOutlineBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True">

                    <Grid>

                      <Border HorizontalAlignment="Left" VerticalAlignment="Center" Height="7" Margin="1.5,0,0,0" CornerRadius="1.5" Width="{Binding Battery.BatteryFillWidth}" Background="{Binding Battery.BatteryFillBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True" />

                      <Path Data="M 3.8,0 L 0.5,5.2 H 3.2 L 2.2,9.2 L 6.2,3.8 H 3.4 Z" Fill="#FFFFFF" Stretch="Uniform" Width="5.5" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True" Visibility="{Binding Battery.IsChargingOrPluggedIn, Converter={StaticResource BoolToVis}}" />

                    </Grid>

                  </Border>

                  <Border Width="2" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="0,1.5,1.5,0" Background="{Binding Battery.BatteryOutlineBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True" />

                </Grid>

              </StackPanel>

            </StackPanel>

            <!-- Overlay privasi expanded: melayang di kanan-atas header, posisi independen dari karakter/widget -->

            <Grid Name="ExpandedPrivacyOverlayHost" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3.5,16,0" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">

              <UIElement.RenderTransform>

                <TranslateTransform x:Name="ExpandedPrivacyOverlayTranslate" X="0" Y="0" />

              </UIElement.RenderTransform>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                <Ellipse Width="5" Height="5" Fill="#F97316" Margin="1.5,0" Visibility="{Binding IsMicrophoneInUse, Converter={StaticResource BoolToVis}}">

                  <UIElement.Effect>

                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#F97316" Opacity="0.95" RenderingBias="Performance" />

                  </UIElement.Effect>

                </Ellipse>

                <Ellipse Width="5" Height="5" Fill="#22C55E" Margin="1.5,0" Visibility="{Binding IsCameraInUse, Converter={StaticResource BoolToVis}}">

                  <UIElement.Effect>

                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#22C55E" Opacity="0.95" RenderingBias="Performance" />

                  </UIElement.Effect>

                </Ellipse>

              </StackPanel>

            </Grid>

          </Grid>

          <Grid Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ClipToBounds="True">

            <Grid Name="SlideControlCenterCard" Width="584" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible" Opacity="1.0">

              <UIElement.RenderTransform>

                <TranslateTransform x:Name="Slide0Translate" X="0" Y="0" />

              </UIElement.RenderTransform>

              <Grid.RowDefinitions>

                <RowDefinition Height="136" />

                <RowDefinition Height="Auto" />

              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>

                <ColumnDefinition Width="178" />

                <ColumnDefinition Width="8" />

                <ColumnDefinition Width="212" />

                <ColumnDefinition Width="8" />

                <ColumnDefinition Width="178" />

              </Grid.ColumnDefinitions>

              <!-- COLUMN 0: Clock & Battery -->
              <Grid Column="0">

                <Grid.RowDefinitions>

                  <RowDefinition Height="Auto" />

                  <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <!-- Card 0.0: Clock & Date -->
                <Border Grid.Row="0" Background="#161622" CornerRadius="11" BorderBrush="#28283C" BorderThickness="1" Padding="10,6" Margin="0,0,0,6">

                  <Grid VerticalAlignment="Center">

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" LineHeight="23" Text="{Binding Clock.CurrentTime}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">

                      <!-- Calendar icon -->
                      <Path Data="M1,3 H9 M3,1 V3 M7,1 V3 M1,2 C1,1.5 1.5,1 2,1 H8 C8.5,1 9,1.5 9,2 V8 C9,8.5 8.5,9 8,9 H2 C1.5,9 1,8.5 1,8 Z" 
                            Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4.5,0"/>

                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Text="{Binding Clock.FullDate}" />

                    </StackPanel>

                  </Grid>

                </Border>

                <!-- Card 0.1: Battery & Power Status -->
                <Border Grid.Row="1" Background="#161622" CornerRadius="11" BorderBrush="#28283C" BorderThickness="1" Padding="9,6">

                  <Grid VerticalAlignment="Center">

                    <!-- Battery View -->
                    <Grid Visibility="{Binding Battery.HasBattery, Converter={StaticResource BoolToVis}}">

                      <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                      </Grid.RowDefinitions>

                      <!-- Top: Status & Percent -->
                      <Grid Row="0" Margin="0,0,0,4">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Grid Width="22" Height="11" VerticalAlignment="Center" Margin="0,0,6,0" SnapsToDevicePixels="True" UseLayoutRounding="True">

                            <Border Width="19" Height="11" HorizontalAlignment="Left" CornerRadius="3" BorderThickness="1" Background="#161620" BorderBrush="{Binding Battery.BatteryOutlineBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True">

                              <Grid>

                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Height="7" Margin="1.5,0,0,0" CornerRadius="1.5" Width="{Binding Battery.BatteryFillWidth}" Background="{Binding Battery.BatteryFillBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True" />

                                <Path Data="M 3.8,0 L 0.5,5.2 H 3.2 L 2.2,9.2 L 6.2,3.8 H 3.4 Z" Fill="#FFFFFF" Stretch="Uniform" Width="5.5" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True" Visibility="{Binding Battery.IsChargingOrPluggedIn, Converter={StaticResource BoolToVis}}" />

                              </Grid>

                            </Border>

                            <Border Width="2" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="0,1.5,1.5,0" Background="{Binding Battery.BatteryOutlineBrush}" SnapsToDevicePixels="True" UseLayoutRounding="True" />

                          </Grid>

                          <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Text="{Binding Battery.StatusTitle}" />

                        </StackPanel>

                        <TextBlock HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding Battery.FormattedPercent}" Foreground="{Binding Battery.BatteryTextBrush}" />

                      </Grid>

                      <!-- Middle: Rounded Progress Bar -->
                      <ProgressBar Grid.Row="1" Height="5" Minimum="0" Maximum="100" BorderThickness="0" Background="#222230" Margin="0,0,0,5" Value="{Binding Battery.RemainingPercent}">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type ProgressBar}">

                            <Grid Name="TemplateRoot">

                              <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="2.5" />

                              <Border Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left" Background="{Binding Battery.BatteryFillBrush}" />

                            </Grid>

                          </ControlTemplate>

                        </Control.Template>

                      </ProgressBar>

                      <!-- Bottom: Capacity & Power Flow Chips -->
                      <Grid Row="2">

                        <Grid.ColumnDefinitions>

                          <ColumnDefinition Width="*" />

                          <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">

                          <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="Real-Time Battery Capacity" Text="{Binding Battery.CapacityText}" />

                          <TextBlock FontSize="9" FontWeight="Medium" Foreground="#71717A" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="Battery Voltage" Margin="0,1,0,0" Text="{Binding Battery.VoltageText}" />

                        </StackPanel>

                        <Border Grid.Column="1" Background="#10281F" BorderBrush="#1E4738" BorderThickness="1" CornerRadius="5" Padding="5,2" VerticalAlignment="Center">

                          <TextBlock FontSize="9.5" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="Power Flow Rate" Text="{Binding Battery.PowerFlowText}" />

                        </Border>

                      </Grid>

                    </Grid>

                    <!-- Desktop (No Battery) View -->
                    <Grid VerticalAlignment="Center" Visibility="{Binding Battery.HasBattery, Converter={StaticResource InverseBoolToVis}}">

                      <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                          <Path Data="M1,1 L13,1 L13,9 L1,9 M5,9 L5,11 L9,11 L9,9 M3,11 L11,11" Stroke="#10B981" StrokeThickness="1.2" StrokeLineJoin="Round" Width="12" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />

                          <TextBlock Text="PC Desktop" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />

                        </StackPanel>

                        <Border Background="#10281F" BorderBrush="#1E4738" BorderThickness="1" CornerRadius="5" Padding="6,3" HorizontalAlignment="Left">

                          <TextBlock Text="AC Power Connected" FontSize="9.5" FontWeight="SemiBold" Foreground="#10B981" />

                        </Border>

                      </StackPanel>

                    </Grid>

                  </Grid>

                </Border>

              </Grid>

              <!-- COLUMN 2: Audio & Brightness / Network & Bluetooth -->
              <Grid Column="2">

                <Grid.RowDefinitions>

                  <RowDefinition Height="Auto" />

                  <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <!-- Card 2.0: Audio Volume & Brightness -->
                <Border Grid.Row="0" Background="#161622" CornerRadius="11" BorderBrush="#28283C" BorderThickness="1" Padding="9,5" Margin="0,0,0,6">

                  <Grid VerticalAlignment="Center">

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <!-- Row 0: Volume Row -->
                    <Grid Row="0" Margin="0,0,0,2">

                      <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="16" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="26" />

                      </Grid.ColumnDefinitions>

                      <Button Grid.Column="0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Mute / Unmute" FocusVisualStyle="{x:Null}" Command="{Binding ToggleMasterMuteCommand}">

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

                          <Path Data="M1,4 L4,4 L8,1 L8,11 L4,8 L1,8 M10,3 C11.5,4.5 11.5,7.5 10,9 M12,1 C14.5,3.5 14.5,8.5 12,11" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="10" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsMasterVolumeMuted, Converter={StaticResource InverseBoolToVis}}" />

                          <Path Data="M1,4 L4,4 L8,1 L8,11 L4,8 L1,8 M10,4 L14,8 M14,4 L10,8" Stroke="#EF4444" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="10" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsMasterVolumeMuted, Converter={StaticResource BoolToVis}}" />

                        </Grid>

                      </Button>

                      <Slider Grid.Column="1" Style="{StaticResource ControlCenterSliderStyle}" Minimum="0" Maximum="100" Margin="3,0,3,0" VerticalAlignment="Center" Value="{Binding MasterVolumePercent, Mode=TwoWay}" />

                      <TextBlock Grid.Column="2" Foreground="#D4D4D8" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding MasterVolumePercent, StringFormat={}{0}%}" />

                    </Grid>

                    <!-- Row 1: Audio Device Selector Chip -->
                    <Grid Row="1" Margin="20,0,0,2.5">

                      <Button Name="AudioDeviceSelectorBtn" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Select Audio Output Device" HorizontalAlignment="Left" FocusVisualStyle="{x:Null}" Command="{Binding Volume.ToggleDevicePickerCommand}">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type Button}">

                            <Border Name="bd" Background="#1C1C2A" BorderBrush="#2D2D42" BorderThickness="1" CornerRadius="6" Padding="6,2">

                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <Grid Margin="0,0,4,0" VerticalAlignment="Center" Width="9.5" Height="8.5">

                                  <Path Data="M1,4 L4,4 L8,1 L8,11 L4,8 L1,8 M10,3 C11.5,4.5 11.5,7.5 10,9 M12,1 C14.5,3.5 14.5,8.5 12,11" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Visibility="{Binding Volume.IsHeadphone, Converter={StaticResource InverseBoolToVis}}" />

                                  <Path Data="M1,7 C1,3.5 3.5,1 7,1 C10.5,1 13,3.5 13,7 L13,12 L10,12 L10,7 L11.5,7 M1,7 L4,7 L4,12 L1,12" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Visibility="{Binding Volume.IsHeadphone, Converter={StaticResource BoolToVis}}" />

                                </Grid>

                                <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#E4E4E7" TextTrimming="CharacterEllipsis" MaxWidth="138" VerticalAlignment="Center" Text="{Binding Volume.ActiveDeviceName}" />

                                <Path Data="M1,1 L4,4 L7,1" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="6" Height="4" Margin="4,0,0,0" VerticalAlignment="Center" />

                              </StackPanel>

                            </Border>

                            <ControlTemplate.Triggers>

                              <Trigger Property="UIElement.IsMouseOver" Value="True">

                                <Setter TargetName="bd" Property="Border.Background" Value="#262638" />

                                <Setter TargetName="bd" Value="{DynamicResource AccentLightBrush}" Property="Border.BorderBrush" />

                              </Trigger>

                            </ControlTemplate.Triggers>

                          </ControlTemplate>

                        </Control.Template>

                      </Button>

                      <!-- Device Picker Popup -->
                      <Popup x:Name="DevicePickerPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding Volume.IsDevicePickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AudioDeviceSelectorBtn}" Opened="DevicePickerPopup_Opened" Closed="DevicePickerPopup_Closed">

                        <Border Background="#1A1A24" BorderBrush="#2D2D3D" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,3,0,0" MinWidth="180">

                          <UIElement.Effect>

                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.6" />

                          </UIElement.Effect>

                          <StackPanel>

                            <TextBlock Text="SELECT AUDIO OUTPUT" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" Margin="6,3,6,4" />

                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                              <ItemsControl ItemsSource="{Binding Volume.AvailableDevices}">

                              <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                  <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch" Margin="0,1" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.Volume.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">

                                    <Control.Template>

                                      <ControlTemplate TargetType="{x:Type Button}">

                                        <Border Name="itemBd" Background="#00FFFFFF" CornerRadius="5" Padding="6,3.5">

                                          <Grid>

                                            <Grid.ColumnDefinitions>

                                              <ColumnDefinition Width="16" />

                                              <ColumnDefinition Width="*" />

                                              <ColumnDefinition Width="16" />

                                            </Grid.ColumnDefinitions>

                                            <Grid Column="0" VerticalAlignment="Center" Width="9.5" Height="8.5">

                                              <Path Data="M1,4 L4,4 L8,1 L8,11 L4,8 L1,8 M10,3 C11.5,4.5 11.5,7.5 10,9 M12,1 C14.5,3.5 14.5,8.5 12,11" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Visibility="{Binding IsHeadphone, Converter={StaticResource InverseBoolToVis}}" />

                                              <Path Data="M1,7 C1,3.5 3.5,1 7,1 C10.5,1 13,3.5 13,7 L13,12 L10,12 L10,7 L11.5,7 M1,7 L4,7 L4,12 L1,12" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Visibility="{Binding IsHeadphone, Converter={StaticResource BoolToVis}}" />

                                            </Grid>

                                            <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Name}" />

                                            <TextBlock Grid.Column="2" Text="✓" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                          </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                          <Trigger Property="UIElement.IsMouseOver" Value="True">

                                            <Setter TargetName="itemBd" Property="Border.Background" Value="#2D2D3D" />

                                          </Trigger>

                                        </ControlTemplate.Triggers>

                                      </ControlTemplate>

                                    </Control.Template>

                                  </Button>

                                </DataTemplate>

                              </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            </ScrollViewer>

                          </StackPanel>

                        </Border>

                      </Popup>

                    </Grid>

                    <!-- Row 2: Brightness Row -->
                    <Grid Row="2">

                      <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="16" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="26" />

                      </Grid.ColumnDefinitions>

                      <Path Grid.Column="0" Data="M6,1 L6,3 M6,9 L6,11 M1,6 L3,6 M9,6 L11,6 M2.5,2.5 L3.9,3.9 M8.1,8.1 L9.5,9.5 M2.5,9.5 L3.9,8.1 M8.1,3.9 L9.5,2.5 M8,6 A2,2 0 1 1 4,6A2,2 0 1 1 8,6" Stroke="#FBBF24" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9.5" Height="9.5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Screen Brightness" />

                      <Slider Grid.Column="1" Style="{StaticResource ControlCenterSliderStyle}" Foreground="#FBBF24" Minimum="0" Maximum="100" Margin="3,0,3,0" VerticalAlignment="Center" Value="{Binding ScreenBrightnessPercent, Mode=TwoWay}" IsEnabled="{Binding IsBrightnessSupported}" />

                      <TextBlock Grid.Column="2" Foreground="#D4D4D8" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ScreenBrightnessPercent, StringFormat={}{0}%}" />

                    </Grid>

                  </Grid>

                </Border>

                <!-- Card 2.1: Network & Bluetooth -->
                <Border Grid.Row="1" Background="#161622" CornerRadius="11" BorderBrush="#28283C" BorderThickness="1" Padding="9,6">

                  <Grid VerticalAlignment="Center">

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <!-- Row 0: Network Info & Active Badge -->
                    <Grid Row="0">

                      <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="16" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                      </Grid.ColumnDefinitions>

                      <Path Grid.Column="0" Data="M1,2.5 C3.5,0 8.5,0 11,2.5 M3,5 C4.5,3.5 7.5,3.5 9,5 M4.5,7.5 C5.2,6.7 6.8,6.7 7.5,7.5 M6,10 L6.01,10" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="11" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Wi-Fi" Visibility="{Binding SystemHealth.IsWirelessNetwork, Converter={StaticResource BoolToVis}}" />

                      <Path Grid.Column="0" Data="M1,1 L11,1 L11,8 L1,8 Z M4,8 L4,10.5 L8,10.5 L8,8 M3,10.5 L9,10.5" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="11" Height="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Ethernet LAN" Visibility="{Binding SystemHealth.IsWirelessNetwork, Converter={StaticResource InverseBoolToVis}}" />

                      <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding SystemHealth.NetworkName}" />

                      <Border Grid.Column="2" Background="#10281F" BorderBrush="#1E4738" BorderThickness="1" CornerRadius="5" Padding="5,1.5" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Border Width="4" Height="4" CornerRadius="2" Background="#10B981" Margin="0,0,3.5,0" VerticalAlignment="Center" />

                          <TextBlock Text="Active" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />

                        </StackPanel>

                      </Border>

                    </Grid>

                    <!-- Row 1: Speed Badges -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,3,0,4" VerticalAlignment="Center">

                      <Border Background="#0C1F2B" BorderBrush="#14415C" BorderThickness="1" CornerRadius="4" Padding="4.5,1" Margin="0,0,5,0">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M2.5,0 L2.5,5.5 M0.5,3.5 L2.5,5.5 L4.5,3.5" Stroke="#38BDF8" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="5.5" Height="6" VerticalAlignment="Center" Margin="0,0,2.5,0" />

                          <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" Text="{Binding SystemHealth.DownloadSpeed}" />

                        </StackPanel>

                      </Border>

                      <Border Background="#1C122B" BorderBrush="#401B64" BorderThickness="1" CornerRadius="4" Padding="4.5,1">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M2.5,5.5 L2.5,0 M0.5,2 L2.5,0 L4.5,2" Stroke="#A78BFA" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="5.5" Height="6" VerticalAlignment="Center" Margin="0,0,2.5,0" />

                          <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#A78BFA" VerticalAlignment="Center" Text="{Binding SystemHealth.UploadSpeed}" />

                        </StackPanel>

                      </Border>

                    </StackPanel>

                    <!-- Row 2: Bluetooth Status -->
                    <Grid Grid.Row="2" Margin="0,1,0,0">

                      <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="16" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                      </Grid.ColumnDefinitions>

                      <Path Grid.Column="0" Data="M2,3.5 L8,8 L5,11 L5,1 L8,4 L2,8.5" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="8.5" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Bluetooth Audio / Peripheral" />

                      <Grid Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding Volume.IsBluetoothAudio, Converter={StaticResource BoolToVis}}">

                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding Volume.BluetoothDeviceName}" />

                      </Grid>

                      <Grid Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding Volume.ShowBluetoothReady, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="Bluetooth Ready" FontSize="10.5" Foreground="#94A3B8" />

                      </Grid>

                      <Grid Column="1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding Volume.IsBluetoothRadioOff, Converter={StaticResource BoolToVis}}">

                        <TextBlock Text="Bluetooth Off" FontSize="10.5" Foreground="#94A3B8" />

                      </Grid>

                      <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="4.5,1.5" Margin="2,0,0,0" VerticalAlignment="Center" Visibility="{Binding Volume.IsBluetoothAudio, Converter={StaticResource BoolToVis}}">

                        <TextBlock FontSize="9.5" FontWeight="Bold" Foreground="#10B981" Text="{Binding Volume.BluetoothBatteryText}" />

                      </Border>

                    </Grid>

                  </Grid>

                </Border>

              </Grid>

              <!-- COLUMN 4: Telemetry Monitor & Quick Actions -->
              <Grid Column="4">

                <Grid.RowDefinitions>

                  <RowDefinition Height="Auto" />

                  <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <!-- Card 4.0: Hardware Telemetry -->
                <Button Grid.Row="0" Background="#161622" BorderBrush="#28283C" BorderThickness="1" Cursor="Hand" ToolTip="Open Windows Task Manager" Margin="0,0,0,6" Command="{Binding LaunchTaskManagerCommand}" FocusVisualStyle="{x:Null}">

                  <Control.Template>

                    <ControlTemplate TargetType="{x:Type Button}">

                      <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="11" Padding="9,6">

                        <ContentPresenter />

                      </Border>

                      <ControlTemplate.Triggers>

                        <Trigger Property="UIElement.IsMouseOver" Value="True">

                          <Setter TargetName="bd" Value="{DynamicResource AccentLightBrush}" Property="Border.BorderBrush" />

                          <Setter TargetName="bd" Property="Border.Background" Value="#1E1E2C" />

                        </Trigger>

                      </ControlTemplate.Triggers>

                    </ControlTemplate>

                  </Control.Template>

                  <Grid VerticalAlignment="Center">

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <!-- CPU -->
                    <Grid Row="0" Margin="0,0,0,3">

                      <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="24" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="26" />

                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Column="0" Text="CPU" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />

                      <ProgressBar Grid.Column="1" Height="5" Minimum="0" Maximum="100" BorderThickness="0" Background="#222230" Margin="3,0,4,0" VerticalAlignment="Center" Value="{Binding SystemHealth.CpuPercent}">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type ProgressBar}">

                            <Grid Name="TemplateRoot">

                              <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="2.5" />

                              <Border Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left" Background="{Binding SystemHealth.CpuBrush}" />

                            </Grid>

                          </ControlTemplate>

                        </Control.Template>

                      </ProgressBar>

                      <TextBlock Grid.Column="2" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SystemHealth.CpuFormatted}" Foreground="{Binding SystemHealth.CpuBrush}" />

                    </Grid>

                    <!-- RAM -->
                    <Grid Row="1" Margin="0,0,0,3">

                      <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="24" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="26" />

                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Column="0" Text="RAM" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />

                      <ProgressBar Grid.Column="1" Height="5" Minimum="0" Maximum="100" BorderThickness="0" Background="#222230" Margin="3,0,4,0" VerticalAlignment="Center" Value="{Binding SystemHealth.RamPercent}">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type ProgressBar}">

                            <Grid Name="TemplateRoot">

                              <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="2.5" />

                              <Border Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left" Background="{Binding SystemHealth.RamBrush}" />

                            </Grid>

                          </ControlTemplate>

                        </Control.Template>

                      </ProgressBar>

                      <TextBlock Grid.Column="2" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SystemHealth.RamPercentFormatted}" Foreground="{Binding SystemHealth.RamBrush}" />

                    </Grid>

                    <!-- GPU -->
                    <Grid Row="2">

                      <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="24" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="26" />

                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Column="0" Text="GPU" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />

                      <ProgressBar Grid.Column="1" Height="5" Minimum="0" Maximum="100" BorderThickness="0" Background="#222230" Margin="3,0,4,0" VerticalAlignment="Center" Value="{Binding SystemHealth.GpuPercent}">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type ProgressBar}">

                            <Grid Name="TemplateRoot">

                              <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="2.5" />

                              <Border Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left" Background="{Binding SystemHealth.GpuBrush}" />

                            </Grid>

                          </ControlTemplate>

                        </Control.Template>

                      </ProgressBar>

                      <TextBlock Grid.Column="2" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding SystemHealth.GpuFormatted}" Foreground="{Binding SystemHealth.GpuBrush}" />

                    </Grid>

                  </Grid>

                </Button>

                <!-- Card 4.1: Quick Actions -->
                <Border Grid.Row="1" Background="#161622" BorderBrush="#28283C" BorderThickness="1" CornerRadius="11" Padding="7,5">

                  <Grid>

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="9" FontWeight="Bold" Foreground="#828298" Margin="2,0,0,3" Text="{Binding L10n[Control.QuickActions]}" />

                    <UniformGrid Grid.Row="1" Rows="2" Columns="2">

                      <!-- Screenshot -->
                      <Button Style="{StaticResource QuickActionTileButtonStyle}" Margin="0,0,2.5,2.5" Command="{Binding CaptureScreenCommand}" ToolTip="{Binding L10n[Action.Screenshot]}">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M2,4 C2,3 3,2 4,2 L6,2 L7,1 L11,1 L12,2 L14,2 C15,2 16,3 16,4 L16,12 C16,13 15,14 14,14 L4,14 C3,14 2,13 2,12 Z M9,11 A3,3 0 1 0 9,5 A3,3 0 0 0 9,11" 
                                Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="9.5" Height="9.5" Margin="0,0,4,0" VerticalAlignment="Center" />

                          <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" Text="{Binding L10n[Action.Screenshot]}" />

                        </StackPanel>

                      </Button>

                      <!-- Lock -->
                      <Button Style="{StaticResource QuickActionTileButtonStyle}" Margin="2.5,0,0,2.5" Command="{Binding LockComputerCommand}" ToolTip="{Binding L10n[Action.Lock]}">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M3,5 V3.5 C3,1.6 4.6,0 6.5,0 C8.4,0 10,1.6 10,3.5 V5 M1,5 H12 V12 H1 Z" 
                                Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="8.5" Height="9.5" Margin="0,0,4,0" VerticalAlignment="Center" />

                          <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" Text="{Binding L10n[Action.Lock]}" />

                        </StackPanel>

                      </Button>

                      <!-- TaskMgr -->
                      <Button Style="{StaticResource QuickActionTileButtonStyle}" Margin="0,2.5,2.5,0" ToolTip="Task Manager" Command="{Binding LaunchTaskManagerCommand}">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M1,9 L10,9 M2,9 V5 M5.5,9 V2 M8.5,9 V6" 
                                Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9" Height="8.5" Margin="0,0,4,0" VerticalAlignment="Center" />

                          <TextBlock Text="TaskMgr" FontSize="9.5" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" />

                        </StackPanel>

                      </Button>

                      <!-- Settings -->
                      <Button Style="{StaticResource QuickActionTileButtonStyle}" Margin="2.5,2.5,0,0" Command="{Binding OpenSettingsCommand}" ToolTip="{Binding L10n[Action.Settings]}">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M5,1.5 H7 M5,10.5 H7 M1.5,5 V7 M10.5,5 V7 M2.5,2.5 L3.9,3.9 M8.1,8.1 L9.5,9.5 M2.5,9.5 L3.9,8.1 M8.1,3.9 L9.5,2.5 M6,4 C4.9,4 4,4.9 4,6 C4,7.1 4.9,8 6,8 C7.1,8 8,7.1 8,6 C8,4.9 7.1,4 6,4 Z" 
                                Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9" Height="9" Margin="0,0,4,0" VerticalAlignment="Center" />

                          <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" Text="{Binding L10n[Action.Settings]}" />

                        </StackPanel>

                      </Button>

                    </UniformGrid>

                  </Grid>

                </Border>

              </Grid>

              <!-- Active Downloads Banner -->
              <Border Grid.Row="1" Grid.ColumnSpan="5" Height="24" Margin="0,5,0,0" Background="#161622" BorderBrush="#28283C" BorderThickness="1" CornerRadius="8" Padding="8,0" ToolTip="{Binding Download.CardTooltip}" Visibility="{Binding Download.HasActiveDownloads, Converter={StaticResource BoolToVis}}">

                <Grid>

                  <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="Auto" />

                  </Grid.ColumnDefinitions>

                  <Path Grid.Column="0" Data="M6,0 L6,8 M3,5.5 L6,8.5 L9,5.5 M1,10 L1,11.5 L11,11.5 L11,10" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,5,0" />

                  <TextBlock Grid.Column="1" Text="{Binding Download.CardTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                  <TextBlock Grid.Column="2" Text="{Binding Download.CardDetail}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="8,0,0,0" />

                  <Border Grid.Column="3" Background="Transparent" Width="18" Height="16" Margin="6,0,0,0" Cursor="Hand" ToolTip="{Binding L10n[Download.OpenFolder]}">

                    <Border.InputBindings>

                      <MouseBinding MouseAction="LeftClick" Command="{Binding Download.OpenPrimaryFolderCommand}" />

                    </Border.InputBindings>

                    <Path Data="M1,3 L5,3 L6.5,4.5 L12,4.5 L12,11 L1,11 Z" Fill="#A1A1AA" Stretch="Uniform" Width="10" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" />

                  </Border>

                </Grid>

              </Border>

            </Grid>

            <Grid Name="SlideMediaCard" Height="136" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0">

              <UIElement.RenderTransform>

                <TranslateTransform x:Name="Slide1Translate" X="0" Y="0" />

              </UIElement.RenderTransform>

              <Grid Name="MediaHubGrid" Width="358" Height="136" HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>

                  <ColumnDefinition Width="Auto" />

                  <ColumnDefinition Width="Auto" />

                  <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <Grid Name="MediaPlayerContainer" Column="0" Width="358" Height="136" ClipToBounds="True">

                  <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                  </Grid.RowDefinitions>

                  <Grid Row="0" Margin="0,2,0,0">

                    <Grid.ColumnDefinitions>

                      <ColumnDefinition Width="Auto" />

                      <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#18181B" ClipToBounds="True" Margin="0,0,10,0" VerticalAlignment="Center">

                      <UIElement.Effect>

                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.55" />

                      </UIElement.Effect>

                      <Grid>

                        <Image Stretch="UniformToFill" Source="{Binding Media.Thumbnail}" />

                        <Path Data="M6,17 A3,3 0 1 1 3,14A3,3 0 0 1 6,17M6,14 L6,4 L16,1 L16,11 A3,3 0 1 1 13,8A3,3 0 0 1 16,11L16,3 L6,6 L6,14" Fill="#52525B" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Media.Thumbnail, Converter={StaticResource InverseBoolToVis}}" />

