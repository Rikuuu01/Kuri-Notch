                        </Control.Template>
                      </Button>
                    </Grid>


                    <!-- Footer: Undo & Reset -->
                    <DockPanel Grid.Row="2" VerticalAlignment="Center" LastChildFill="False" Margin="0,4,0,0">
                      <Button DockPanel.Dock="Left" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding Water.UndoCommand}" FocusVisualStyle="{x:Null}" Visibility="{Binding Water.CanUndo, Converter={StaticResource BoolToVis}}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="#00FFFFFF" BorderThickness="0" Padding="2,1">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M2,4 L0,2 L2,0 M0,2 L6,2 C7.5,2 8.5,3 8.5,4.5 C8.5,6 7.5,7 6,7 L3,7" Stroke="#94A3B8" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7.5" Height="6.5" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Name="undoText" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Text="{Binding L10n[Water.Undo]}" />
                              </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="undoText" Property="TextBlock.Foreground" Value="#F87171" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                      <Button DockPanel.Dock="Right" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding Water.ResetCommand}" FocusVisualStyle="{x:Null}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="#00FFFFFF" BorderThickness="0" Padding="2,1">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M8,1 A4,4 0 1 1 4,0 A4,4 0 0 1 7.5,2 M7.5,0 L7.5,2.5 L5,2.5" Stroke="#94A3B8" StrokeThickness="1.0" StrokeStartLineCap="Round" Width="7.5" Height="7.5" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center" />
                                <TextBlock Name="resetText" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" Text="{Binding L10n[Water.Reset]}" />
                              </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="resetText" Property="TextBlock.Foreground" Value="#FFFFFF" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                    </DockPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
            <Border Name="SlideNoteCard" Width="584" Height="194" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Background="#00FFFFFF" BorderThickness="0" Visibility="Collapsed" Opacity="0">
              <Grid Margin="0,2,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="342" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="232" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#14151C" BorderBrush="#252632" BorderThickness="1" CornerRadius="12" Padding="8,6">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="2,0,2,4">
                      <Button DockPanel.Dock="Right" Width="20" Height="20" Cursor="Hand" ToolTip="Add New Note" Margin="4,0,0,0" FocusVisualStyle="{x:Null}" Click="AddNote_Click">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="bdr" Background="#20212B" BorderBrush="#30313E" BorderThickness="1" CornerRadius="10">
                              <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Border.Background" Value="#2E2F3E" />
                                <Setter TargetName="bdr" Value="{DynamicResource AccentLightBrush}" Property="Border.BorderBrush" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Note.Notes}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Name="tabBdr" BorderThickness="1" CornerRadius="7" Margin="0,0,4,0" SnapsToDevicePixels="True">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#1C1D27" />
                                    <Setter Property="BorderBrush" Value="#2A2B38" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                        <Setter Property="Background" Value="#2D2F3E" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                                      </DataTrigger>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#262734" />
                                      </Trigger>
                                      <DataTrigger Value="True" Binding="{Binding IsConfirmingDelete}">
                                        <Setter Property="Background" Value="#38151D" />
                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                                <Grid>
                                  <DockPanel Name="normalTabPanel" Margin="7,2,5,2" VerticalAlignment="Center">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type DockPanel}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                          <DataTrigger Value="True" Binding="{Binding IsConfirmingDelete}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                    <Button Name="closeBtn" DockPanel.Dock="Right" Width="14" Height="14" Margin="5,0,0,0" Cursor="Hand" ToolTip="Delete Note" Command="{Binding DataContext.Note.RequestDeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" FocusVisualStyle="{x:Null}">
                                      <FrameworkElement.Style>
                                        <Style TargetType="{x:Type Button}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                          <Style.Triggers>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
                                                <Condition Value="True" Binding="{Binding DataContext.Note.CanDeleteNotes, RelativeSource={RelativeSource AncestorType=Window}}" />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <Border Name="cBdr" Background="#00FFFFFF" CornerRadius="7">
                                            <Path Name="cPath" Data="M2,2 L8,8 M8,2 L2,8" Stroke="#8E8E9E" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="6.5" Height="6.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                          </Border>
                                          <ControlTemplate.Triggers>
                                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                                              <Setter TargetName="cBdr" Property="Border.Background" Value="#3F2026" />
                                              <Setter TargetName="cPath" Property="Shape.Stroke" Value="#EF4444" />
                                            </Trigger>
                                          </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                    <Button Background="#00FFFFFF" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.Note.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <TextBlock Name="tabTitle" FontSize="11" VerticalAlignment="Center" Text="{Binding Title}">
                                            <FrameworkElement.Style>
                                              <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#8E8E9E" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                  <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </FrameworkElement.Style>
                                          </TextBlock>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                  </DockPanel>
                                  <StackPanel Name="confirmPanel" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">
                                    <FrameworkElement.Style>
                                      <Style TargetType="{x:Type StackPanel}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                          <DataTrigger Value="True" Binding="{Binding IsConfirmingDelete}">
                                            <Setter Property="Visibility" Value="Visible" />
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </FrameworkElement.Style>
                                    <Button Cursor="Hand" ToolTip="Click to confirm delete" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.Note.ConfirmDeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <Border Name="dBdr" Background="#DC2626" CornerRadius="5" Padding="5,1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                              <Path Data="M1,2 L7,2 M2.5,2 L2.5,6.5 L5.5,6.5 L5.5,2 M3,1 L5,1" Stroke="#FFFFFF" StrokeThickness="1" Width="6" Height="6" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center" />
                                              <TextBlock Text="Delete" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                            </StackPanel>
                                          </Border>
                                          <ControlTemplate.Triggers>
                                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                                              <Setter TargetName="dBdr" Property="Border.Background" Value="#B91C1C" />
                                            </Trigger>
                                          </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                    <Button Width="14" Height="14" Margin="3,0,0,0" Cursor="Hand" ToolTip="Cancel" FocusVisualStyle="{x:Null}" Command="{Binding DataContext.Note.CancelDeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <Border Name="cancelBdr" Background="#2E2026" CornerRadius="7">
                                            <Path Name="cancelPath" Data="M2,2 L6,6 M6,2 L2,6" Stroke="#A1A1AA" StrokeThickness="1" Width="5" Height="5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                          </Border>
                                          <ControlTemplate.Triggers>
                                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                                              <Setter TargetName="cancelBdr" Property="Border.Background" Value="#4B2A30" />
                                              <Setter TargetName="cancelPath" Property="Shape.Stroke" Value="#FFFFFF" />
                                            </Trigger>
                                          </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </DockPanel>
                    <Grid Row="1" Margin="2,2,2,2">
                      <TextBlock Name="NotePlaceholder" Text="Write anything here: an order number, a to-do list, a code snippet. It saves itself." FontSize="11" Foreground="#8E8E9E" TextWrapping="Wrap" Margin="4,2,4,2" IsHitTestVisible="False" />
                      <RichTextBox Name="NoteRichTextBox" Background="#00FFFFFF" Foreground="#F4F4F5" CaretBrush="{DynamicResource AccentLightBrush}" BorderThickness="0" Padding="2" FontSize="11" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SpellCheck.IsEnabled="False" TextChanged="NoteRichTextBox_TextChanged">
                        <FlowDocument PagePadding="0" Background="#00FFFFFF" Foreground="#F4F4F5">
                          <Paragraph Margin="0" FontSize="11" FontFamily="Segoe UI" />
                        </FlowDocument>
                      </RichTextBox>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="2,4,2,0">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Set Reminder" Command="{Binding Note.AddReminderCommand}">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M5,1 C5,0.4 5.4,0 6,0 C6.6,0 7,0.4 7,1 L7,1.2 C9,1.8 10,3.5 10,6 L10.5,7.5 L1.5,7.5 L2,6 C2,3.5 3,1.8 5,1.2 L5,1 M4.5,8.5 C4.5,9.3 5.2,10 6,10 C6.8,10 7.5,9.3 7.5,8.5" Fill="#9CA3AF" Width="7.5" Height="7.5" Stretch="Uniform" Margin="0,0,2,0" VerticalAlignment="Center" />
                            <TextBlock Text="Remind" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Copy Full Note" Click="CopyNote_Click">
                          <Path Data="M3,3 L9,3 L9,10 L3,10 M5,1 L11,1 L11,8" Stroke="#9CA3AF" StrokeThickness="1.2" Width="8" Height="8" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Delete Note" Command="{Binding Note.DeleteCurrentNoteCommand}">
                          <Path Data="M2,3 L10,3 M4,3 L4,1 L8,1 L8,3 M3,3 L4,10 L8,10 L9,3" Stroke="#EF4444" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7.5" Height="7.5" Stretch="Uniform" />
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Bold (Ctrl+B)" Click="FormatBold_Click">
                          <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" />
                        </Button>
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Italic (Ctrl+I)" Click="FormatItalic_Click">
                          <TextBlock Text="I" FontSize="11" FontStyle="Italic" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        </Button>
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Strikethrough" Click="FormatStrike_Click">
                          <TextBlock Text="S" FontSize="11" TextDecorations="Strikethrough" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        </Button>
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Code" Click="FormatCode_Click">
                          <TextBlock Text="&lt;/&gt;" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" />
                        </Button>
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Bullet List" Click="FormatBullet_Click">
                          <Path Data="M1,2 A1,1 0 1 1 1,2.01M4,2 L10,2 M1,5 A1,1 0 1 1 1,5.01M4,5 L10,5 M1,8 A1,1 0 1 1 1,8.01M4,8 L10,8" Stroke="#A1A1AA" StrokeThickness="1.1" Width="8.5" Height="8" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Numbered List" Click="FormatNumber_Click">
                          <TextBlock Text="1=" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />
                        </Button>
                      </StackPanel>
                    </DockPanel>
                  </Grid>
                </Border>
                <Border Grid.Column="2" Background="#14151C" BorderBrush="#252632" BorderThickness="1" CornerRadius="12" Padding="8,6">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                      <Border DockPanel.Dock="Right" Background="#1E202B" CornerRadius="8" Padding="5,1">
                        <TextBlock FontSize="10" Foreground="#8E8E9E" Text="{Binding Note.Reminders.Count, StringFormat='{}{0} Item'}" />
                      </Border>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M6,1 C3.5,1 1.5,3 1.5,5.5 C1.5,8 3.5,10 6,10 C8.5,10 10.5,8 10.5,5.5 C10.5,3 8.5,1 6,1 M6,3 L6,6 L8.5,7.5 M1,2.5 L3,0.5 M11,2.5 L9,0.5" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Reminders &amp; Alarm" FontSize="11" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#1C1D28" BorderBrush="#2A2B3A" BorderThickness="1" CornerRadius="8" Height="22" Padding="6,0" Margin="0,0,0,4">
                      <Grid VerticalAlignment="Center">
                        <TextBlock Text="Alarm / reminder note..." FontSize="11" Foreground="#8E8E9E" VerticalAlignment="Center" IsHitTestVisible="False">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Value="" Binding="{Binding Note.ReminderInput}">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </TextBlock>
                        <TextBox Background="#00FFFFFF" Foreground="#F4F4F5" CaretBrush="{DynamicResource AccentLightBrush}" BorderThickness="0" Padding="0" FontSize="11" VerticalAlignment="Center" Text="{Binding Note.ReminderInput, UpdateSourceTrigger=PropertyChanged}">
                          <UIElement.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Note.AddReminderCommand}" />
                          </UIElement.InputBindings>
                        </TextBox>
                      </Grid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,0,0,5">
                      <Button DockPanel.Dock="Right" Cursor="Hand" Margin="4,0,0,0" Command="{Binding Note.AddReminderCommand}" FocusVisualStyle="{x:Null}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type Button}">
                            <Border Name="bdr" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="7" Padding="7,3">
                              <TextBlock Text="Set" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="UIElement.Opacity" Value="0.88" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </Button>
                      <Border DockPanel.Dock="Left" Background="#1A1B24" BorderBrush="#2C2D3C" BorderThickness="1" CornerRadius="7" Padding="3,1" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBox MaxLength="2" Width="16" Background="#00FFFFFF" Foreground="#FFFFFF" BorderThickness="0" Padding="0" FontSize="11" FontWeight="Bold" TextAlignment="Center" Text="{Binding Note.AlarmHour, UpdateSourceTrigger=PropertyChanged}" />
                          <TextBlock Text=":" FontSize="11" FontWeight="Bold" Foreground="#8E8E9E" VerticalAlignment="Center" Margin="1,-1,1,0" />
                          <TextBox MaxLength="2" Width="16" Background="#00FFFFFF" Foreground="#FFFFFF" BorderThickness="0" Padding="0" FontSize="11" FontWeight="Bold" TextAlignment="Center" Text="{Binding Note.AlarmMinute, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </Border>
                      <UniformGrid Columns="4">
                        <Button Content="+15m" Style="{StaticResource NotePresetButtonStyle}" CommandParameter="+15m" Height="17" FontSize="10" Padding="0" Command="{Binding Note.SetQuickAlarmCommand}" />
                        <Button Content="+30m" Style="{StaticResource NotePresetButtonStyle}" CommandParameter="+30m" Height="17" FontSize="10" Padding="0" Command="{Binding Note.SetQuickAlarmCommand}" />
                        <Button Content="+1h" Style="{StaticResource NotePresetButtonStyle}" CommandParameter="+1h" Height="17" FontSize="10" Padding="0" Command="{Binding Note.SetQuickAlarmCommand}" />
                        <Button Content="Tmrw" Style="{StaticResource NotePresetButtonStyle}" CommandParameter="Tomorrow9" Height="17" FontSize="10" Padding="0" ToolTip="Tomorrow at 09:00" Command="{Binding Note.SetQuickAlarmCommand}" />
                      </UniformGrid>
                    </DockPanel>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding Note.Reminders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#1C1D27" BorderBrush="#2A2B38" BorderThickness="1" CornerRadius="7" Padding="5,3" Margin="0,1.5">
                              <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource NoteToolbarButtonStyle}" Padding="3,2" Cursor="Hand" ToolTip="Delete Reminder/Alarm" Command="{Binding DataContext.Note.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                  <Path Data="M1,1 L5,5 M5,1 L1,5" Stroke="#EF4444" StrokeThickness="1" Width="5" Height="5" Stretch="Uniform" />
                                </Button>
                                <Border DockPanel.Dock="Left" Background="#262738" BorderBrush="#36384C" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M4,1 C2.3,1 1,2.3 1,4 C1,5.7 2.3,7 4,7 C5.7,7 7,5.7 7,4 C7,2.3 5.7,1 4,1 M4,2.5 L4,4.2 L5.5,5.2" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="0.8" Width="5" Height="5" Stretch="Uniform" Margin="0,0,2.5,0" VerticalAlignment="Center" />
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" Text="{Binding FormattedDueTime}" />
                                  </StackPanel>
                                </Border>
                                <TextBlock FontSize="10" Foreground="#E4E4E7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,0" Text="{Binding Text}" ToolTip="{Binding Text}" />
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Border>
              </Grid>
            </Border>
            <Border Name="SlideClipboardCard" Width="584" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="#00FFFFFF" BorderThickness="0" Visibility="Collapsed" Opacity="0">
              <Grid Margin="6,4,6,4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Cursor="Hand" ToolTip="Clear all clipboard history" Command="{Binding Clipboard.ClearAllCommand}" FocusVisualStyle="{x:Null}">
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Name="bdr" Background="#26181C" BorderBrush="#3D2024" BorderThickness="1" CornerRadius="8" Padding="7,2">
                          <TextBlock Text="Clear All" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Border.Background" Value="#3F1D22" />
                            <Setter TargetName="bdr" Property="Border.BorderBrush" Value="#5C262C" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Control.Template>
                  </Button>
                  <Border DockPanel.Dock="Right" Background="#14141E" BorderBrush="#252536" BorderThickness="1" CornerRadius="8" Width="170" Height="21" Margin="0,0,8,0" Padding="6,0">
