                    </Grid.RowDefinitions>
                    <Grid Row="0" Margin="2,0,2,6">
                      <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding HomeCalendar.CurrentMonth}" />
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding HomeCalendar.CurrentYear}" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding HomeCalendar.WeekDays}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding DayLetter}">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                  <Setter Property="Foreground" Value="#94A3B8" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True" Binding="{Binding IsSunday}">
                                      <Setter Property="Foreground" Value="#EF4444" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                            </TextBlock>
                            <Grid Width="22" Height="22" Margin="0,3,0,0">
                              <Ellipse Fill="#34D399" Visibility="{Binding IsToday, Converter={StaticResource BoolToVis}}" />
                              <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DayNumber}">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#F1F5F9" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding IsToday}">
                                        <Setter Property="Foreground" Value="#0F172A" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </TextBlock>
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Text="{Binding HomeCalendar.TodaySummary}" />
                  </Grid>
                </Border>
              </Grid>
              <Border Name="ShortcutDockBorder" Grid.Row="1" Width="584" Height="42" HorizontalAlignment="Center" Margin="0,0,0,0" CornerRadius="16" Background="#161622" BorderBrush="#252538" BorderThickness="1" SnapsToDevicePixels="True" AllowDrop="True" PreviewDragOver="DockBorder_PreviewDragOver" Drop="DockBorder_Drop">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" ToolTip="Add to Dock..." Width="30" Height="30" Margin="8,0,0,0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding Shortcuts.AddShortcutCommand}" FocusVisualStyle="{x:Null}">
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Width="30" Height="30">
                          <Rectangle Name="rect" Stroke="#3F3F52" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="8" RadiusY="8" />
                          <TextBlock Text="+" FontSize="16" FontWeight="Normal" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter TargetName="rect" Property="Shape.Stroke" Value="#6366F1" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Control.Template>
                  </Button>
                  <Button Grid.Column="1" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding Shortcuts.IsEmpty, Converter={StaticResource BoolToVis}}" Command="{Binding Shortcuts.AddShortcutCommand}" FocusVisualStyle="{x:Null}">
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type Button}">
                        <TextBlock Text="Drop app shortcuts, folders or files here" Foreground="#A1A1AA" FontSize="12" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </Control.Template>
                  </Button>
                  <ScrollViewer Grid.Column="1" Style="{StaticResource ModernSlimScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="6,0,8,0" Visibility="{Binding Shortcuts.HasShortcuts, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Shortcuts.Shortcuts}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Width="36" Height="34" Margin="3,0" Padding="0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.Shortcuts.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding ToolTip}" FocusVisualStyle="{x:Null}">
                            <FrameworkElement.ContextMenu>
                              <ContextMenu Background="#1A1A28" BorderBrush="#2E2E44" Opened="ShortcutContextMenu_Opened" Closed="ShortcutContextMenu_Closed">
                                <MenuItem Header="{Binding LaunchActionHeader}" Click="ShortcutLaunchMenuItem_Click" />
                                <MenuItem Header="Remove from Dock" Click="ShortcutDeleteMenuItem_Click" />
                              </ContextMenu>
                            </FrameworkElement.ContextMenu>
                            <Control.Template>
                              <ControlTemplate TargetType="{x:Type Button}">
                                <Border Name="bdr" Width="36" Height="34" Background="#00FFFFFF" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <Grid Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding IconSource}" Visibility="{Binding HasIconSource, Converter={StaticResource BoolToVis}}" />
                                    <Path Fill="#F59E0B" Width="22" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M2,4.5 C2,3.7 2.7,3 3.5,3 L6.5,3 C7.1,3 7.6,3.3 7.9,3.8 L8.8,5 L14.5,5 C15.3,5 16,5.7 16,6.5 L16,13.5 C16,14.3 15.3,15 14.5,15 L3.5,15 C2.7,15 2,14.3 2,13.5">
                                      <FrameworkElement.Style>
                                        <Style TargetType="{x:Type Path}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                          <Style.Triggers>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition Value="False" Binding="{Binding HasIconSource}" />
                                                <Condition Value="True" Binding="{Binding IsFolder}" />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                    </Path>
                                    <Path Stroke="#94A3B8" StrokeThickness="1.2" Width="18" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M3,1.5 L9.5,1.5 L13.5,5.5 L13.5,14.5 C13.5,15.1 13.1,15.5 12.5,15.5 L3,15.5 C2.4,15.5 2,15.1 2,14.5 L2,2.5 C2,1.9 2.4,1.5 3,1.5 M9,1.5 L9,6 L13.5,6">
                                      <FrameworkElement.Style>
                                        <Style TargetType="{x:Type Path}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                          <Style.Triggers>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition Value="False" Binding="{Binding HasIconSource}" />
                                                <Condition Value="True" Binding="{Binding IsFile}" />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                    </Path>
                                    <Path StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{Binding IconColorHex}" Data="{Binding IconPathData}">
                                      <FrameworkElement.Style>
                                        <Style TargetType="{x:Type Path}">
                                          <Setter Property="Visibility" Value="Collapsed" />
                                          <Style.Triggers>
                                            <MultiDataTrigger>
                                              <MultiDataTrigger.Conditions>
                                                <Condition Value="False" Binding="{Binding HasIconSource}" />
                                                <Condition Value="True" Binding="{Binding HasPathData}" />
                                                <Condition Value="False" Binding="{Binding IsFolder}" />
                                                <Condition Value="False" Binding="{Binding IsFile}" />
                                              </MultiDataTrigger.Conditions>
                                              <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                    </Path>
                                  </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Border.Background" Value="#222236" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Control.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Grid.Row="2" Margin="0,8,0,0" Background="#0C1F1A" BorderBrush="#34D399" BorderThickness="1.5" CornerRadius="22" Padding="10,6" SnapsToDevicePixels="True" Visibility="{Binding IsHomeNotificationActive, Converter={StaticResource BoolToVis}}">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#34D399" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="M6,1.5 C6,1.2 6.2,1 6.5,1 C6.8,1 7,1.2 7,1.5 L7,2.1 C9.1,2.5 10.5,4.3 10.5,6.5 L10.5,9.5 L11.5,10.5 L1.5,10.5 L2.5,9.5 L2.5,6.5 C2.5,4.3 3.9,2.5 6,2.1 M4.8,11.5 C5,12.4 5.7,13 6.5,13 C7.3,13 8,12.4 8.2,11.5" Stroke="#09251D" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding HomeNotificationTitle}" />
                    <TextBlock FontSize="10.5" Foreground="#6EE7B7" Margin="0,1.5,0,0" TextTrimming="CharacterEllipsis" Text="{Binding HomeNotificationSubtitle}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HomeActionButtonStyle}" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" Padding="12,5" Margin="0,0,6,0" Command="{Binding SnoozeHomeNotificationCommand}">
                      <TextBlock Text="Tunda 5 mnt" FontSize="11" FontWeight="Medium" Foreground="#FFFFFF" />
                    </Button>
                    <Button Style="{StaticResource HomeActionButtonStyle}" Background="#34D399" BorderThickness="0" Padding="14,5" Command="{Binding DismissHomeNotificationCommand}">
                      <TextBlock FontSize="11" FontWeight="Bold" Foreground="#09251D" Text="{Binding HomeNotificationActionText}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
            <Grid Name="SlideControlCenterCard" Width="584" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="Visible" Opacity="1.0">
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="Slide0Translate" X="0" Y="0" />
              </UIElement.RenderTransform>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Row="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!-- Baris 1 Quick Actions (4 Kolom): Wi-Fi, Bluetooth, Airplane Mode, Dark Mode -->
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>


                  <!-- 1. Wi-Fi (Toggle kiri, Expand kanan) -->
                  <StackPanel Grid.Column="0">
                    <Border Height="46" CornerRadius="12" SnapsToDevicePixels="True">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Background" Value="#181824" />
                          <Setter Property="BorderBrush" Value="#262638" />
                          <Setter Property="BorderThickness" Value="1" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsWifiToggledOn}">
                              <Setter Property="Background" Value="#38BDF8" />
                              <Setter Property="BorderBrush" Value="#38BDF8" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="1" />
                          <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding L10n[Control.Wifi]}" Command="{Binding QuickToggleWifiCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="partBd" Background="#00FFFFFF" CornerRadius="11,0,0,11">
                                <Path Name="wifiIco" Data="M2,3 C5.5,0 12.5,0 16,3 M4.5,6 C7,4 11,4 13.5,6 M7,9 C8,8 10,8 11,9 M9,12.5 A0.9,0.9 0 1 1 9,12.4" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="17" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Path}">
                                      <Setter Property="Stroke" Value="#FFFFFF" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding IsWifiToggledOn}">
                                          <Setter Property="Stroke" Value="#09090B" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                </Path>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="partBd" Property="Border.Background" Value="#15FFFFFF" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                        <Border Grid.Column="1" Width="1" Margin="0,8">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Border}">
                              <Setter Property="Background" Value="#27273A" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsWifiToggledOn}">
                                  <Setter Property="Background" Value="#0284C7" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </Border>
                        <Button Grid.Column="2" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Daftar Jaringan Wi-Fi" FocusVisualStyle="{x:Null}" Command="{Binding ToggleWifiExpandCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="partBd" Background="#00FFFFFF" CornerRadius="0,11,11,0">
                                <Path Name="chevIco" Data="M1,1 L4.5,4.5 L1,8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="5" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                  <UIElement.RenderTransform>
                                    <RotateTransform Angle="0" x:Name="chevRot" />
                                  </UIElement.RenderTransform>
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Path}">
                                      <Setter Property="Stroke" Value="#A1A1AA" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding IsWifiToggledOn}">
                                          <Setter Property="Stroke" Value="#09090B" />
                                        </DataTrigger>
                                        <DataTrigger Value="True" Binding="{Binding IsWifiExpanded}">
                                          <Setter Property="RenderTransform">
                                            <Setter.Value>
                                              <RotateTransform Angle="90" />
                                            </Setter.Value>
                                          </Setter>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                </Path>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="partBd" Property="Border.Background" Value="#15FFFFFF" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </Grid>
                    </Border>
                    <TextBlock FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="125" Margin="0,5,0,0" Text="{Binding WifiStatusLabel}" />
                  </StackPanel>


                  <!-- 2. Bluetooth (Toggle kiri, Expand kanan) -->
                  <StackPanel Grid.Column="2">
                    <Border Height="46" CornerRadius="12" SnapsToDevicePixels="True">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Background" Value="#181824" />
                          <Setter Property="BorderBrush" Value="#262638" />
                          <Setter Property="BorderThickness" Value="1" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsBluetoothToggledOn}">
                              <Setter Property="Background" Value="#38BDF8" />
                              <Setter Property="BorderBrush" Value="#38BDF8" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="1" />
                          <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding L10n[Control.Bluetooth]}" Command="{Binding QuickToggleBluetoothCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="partBd" Background="#00FFFFFF" CornerRadius="11,0,0,11">
                                <Path Name="btIco" Data="M2,4.5 L9,10 L5.5,14 L5.5,1 L9,5 L2,10.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="10" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Path}">
                                      <Setter Property="Stroke" Value="#FFFFFF" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding IsBluetoothToggledOn}">
                                          <Setter Property="Stroke" Value="#09090B" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                </Path>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="partBd" Property="Border.Background" Value="#15FFFFFF" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                        <Border Grid.Column="1" Width="1" Margin="0,8">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Border}">
                              <Setter Property="Background" Value="#27273A" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsBluetoothToggledOn}">
                                  <Setter Property="Background" Value="#0284C7" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </Border>
                        <Button Grid.Column="2" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Daftar Perangkat Bluetooth" FocusVisualStyle="{x:Null}" Command="{Binding ToggleBluetoothExpandCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="partBd" Background="#00FFFFFF" CornerRadius="0,11,11,0">
                                <Path Name="chevIco" Data="M1,1 L4.5,4.5 L1,8" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="5" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                  <UIElement.RenderTransform>
                                    <RotateTransform Angle="0" x:Name="btChevRot" />
                                  </UIElement.RenderTransform>
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Path}">
                                      <Setter Property="Stroke" Value="#A1A1AA" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding IsBluetoothToggledOn}">
                                          <Setter Property="Stroke" Value="#09090B" />
                                        </DataTrigger>
                                        <DataTrigger Value="True" Binding="{Binding IsBluetoothExpanded}">
                                          <Setter Property="RenderTransform">
                                            <Setter.Value>
                                              <RotateTransform Angle="90" />
                                            </Setter.Value>
                                          </Setter>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                </Path>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="partBd" Property="Border.Background" Value="#15FFFFFF" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </Grid>
                    </Border>
                    <TextBlock FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="125" Margin="0,5,0,0" Text="{Binding BluetoothStatusLabel}" />
                  </StackPanel>


                  <!-- 3. Airplane mode -->
                  <StackPanel Grid.Column="4">
                    <Button Height="46" Background="#181824" BorderBrush="#262638" BorderThickness="1" Cursor="Hand" ToolTip="Airplane mode" FocusVisualStyle="{x:Null}" Command="{Binding ToggleAirplaneModeCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12">
                            <Path Name="ico" Data="M10,1 C9.5,1 9,1.5 9,2.5 L9,7.5 L2,11 L2,13 L9,11 L9,16 L7,17.5 L7,19.5 L10,18.5 L13,19.5 L13,17.5 L11,16 L11,11 L18,13 L18,11 L11,7.5 L11,2.5 C11,1.5 10.5,1 10,1" Fill="#FFFFFF" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsAirplaneModeOn}">
                              <Setter TargetName="bd" Property="Border.Background" Value="#38BDF8" />
                              <Setter TargetName="bd" Property="Border.BorderBrush" Value="#38BDF8" />
                              <Setter TargetName="ico" Property="Shape.Fill" Value="#09090B" />
                            </DataTrigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Border.Background" Value="#222232" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <TextBlock Text="Airplane mode" FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" />
                  </StackPanel>


                  <!-- 4. Dark mode -->
                  <StackPanel Grid.Column="6">
                    <Button Height="46" Background="#181824" BorderBrush="#262638" BorderThickness="1" Cursor="Hand" ToolTip="Dark mode" FocusVisualStyle="{x:Null}" Command="{Binding ToggleDarkModeCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15">
                              <Path Name="icoRing" Data="M8,1 A7,7 0 1 0 8,15A7,7 0 1 0 8,1" Stroke="#FFFFFF" StrokeThickness="1.4" Stretch="Uniform" />
                              <Path Name="icoFill" Data="M8,1 A7,7 0 0 0 8,15" Fill="#FFFFFF" Stretch="Uniform" />
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="False" Binding="{Binding IsDarkModeOn}">
                              <Setter TargetName="bd" Property="Border.Background" Value="#38BDF8" />
                              <Setter TargetName="bd" Property="Border.BorderBrush" Value="#38BDF8" />
                              <Setter TargetName="icoRing" Property="Shape.Stroke" Value="#09090B" />
                              <Setter TargetName="icoFill" Property="Shape.Fill" Value="#09090B" />
                            </DataTrigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Border.Background" Value="#222232" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <TextBlock Text="Dark mode" FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" />
                  </StackPanel>
                </Grid>


                <!-- Inline Expander: Wi-Fi Networks List (tepat dibawah baris pertama) -->
                <Border Grid.Row="1" Visibility="{Binding IsWifiExpanded, Converter={StaticResource BoolToVis}}"
                        Background="#121218" BorderBrush="#252538" BorderThickness="1" CornerRadius="12"
                        Margin="0,6,0,6" Padding="12,10" SnapsToDevicePixels="True">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M2,3 C5.5,0 12.5,0 16,3 M4.5,6 C7,4 11,4 13.5,6 M7,9 C8,8 10,8 11,9 M9,12.5 A0.9,0.9 0 1 1 9,12.4"
                              Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stretch="Uniform" Width="14" Height="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="JARINGAN WI-FI" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Pindai Ulang" Margin="0,0,6,0" Command="{Binding RefreshWifiCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="rfBd" Background="#1C1C2A" CornerRadius="6" Padding="6,3">
                                <Path Data="M13.6,2.4 C12.2,0.9 10.2,0 8,0 C3.6,0 0,3.6 0,8 C0,12.4 3.6,16 8,16 C11.7,16 14.8,13.4 15.7,9.9 L13.6,9.9 C12.8,12.3 10.6,14 8,14 C4.7,14 2,11.3 2,8 C2,4.7 4.7,2 8,2 C9.7,2 11.1,2.7 12.2,3.8 L9,7 L16,7 L16,0 L13.6,2.4" Fill="#9CA3AF" Width="10" Height="10" Stretch="Uniform" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="rfBd" Property="Border.Background" Value="#28283E" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                        <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Pengaturan Wi-Fi Windows" Margin="0,0,6,0" Command="{Binding OpenWifiSettingsCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="stBd" Background="#1C1C2A" CornerRadius="6" Padding="6,3">
                                <Path Data="M2,3.5 L4.5,3.5 M7.5,3.5 L12,3.5 M4.5,2 L4.5,5 M2,7 L8,7 M11,7 L12,7 M8,5.5 L8,8.5 M2,10.5 L5.5,10.5 M8.5,10.5 L12,10.5 M5.5,9 L5.5,12" Stroke="#9CA3AF" StrokeThickness="1.1" StrokeStartLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="stBd" Property="Border.Background" Value="#28283E" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                        <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Tutup" Command="{Binding ToggleWifiExpandCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="clBd" Background="#1C1C2A" CornerRadius="6" Padding="6,3">
                                <Path Data="M1,1 L7,7 M7,1 L1,7" Stroke="#9CA3AF" StrokeThickness="1.3" StrokeStartLineCap="Round" Width="8" Height="8" Stretch="Uniform" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="clBd" Property="Border.Background" Value="#28283E" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </StackPanel>
                    </DockPanel>
                    <!-- Fixed Height 128 Container -->
                    <Grid Height="128">
                      <!-- Searching View -->
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Visibility="{Binding Wifi.ShowSearching, Converter={StaticResource BoolToVis}}">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#181826" Margin="0,0,0,8" HorizontalAlignment="Center">
                          <Path Data="M2,3 C5.5,0 12.5,0 16,3 M4.5,6 C7,4 11,4 13.5,6 M7,9 C8,8 10,8 11,9 M9,12.5 A0.9,0.9 0 1 1 9,12.4"
                                Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                Stretch="Uniform" Width="15" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Searching for Wi-Fi..." FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" />
                      </StackPanel>


                      <!-- Empty View -->
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Visibility="{Binding Wifi.ShowEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Tidak ada jaringan Wi-Fi ditemukan" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" />
                        <Button Command="{Binding RefreshWifiCommand}" Margin="0,6,0,0" Background="#1C1C2A" BorderThickness="0" Cursor="Hand">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Background="#1C1C2A" CornerRadius="6" Padding="10,4">
                                <TextBlock Text="Pindai Ulang" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                              </Border>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </StackPanel>


                      <!-- Active List -->
                      <ScrollViewer Height="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    Style="{StaticResource ModernSlimScrollViewer}"
                                    Visibility="{Binding Wifi.ShowList, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Wifi.Networks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#181824" CornerRadius="8" Padding="10,6" Margin="0,2">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M2,3 C5.5,0 12.5,0 16,3 M4.5,6 C7,4 11,4 13.5,6 M7,9 C8,8 10,8 11,9 M9,12.5 A0.9,0.9 0 1 1 9,12.4"
                                      Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="Uniform" Width="14" Height="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                  <TextBlock Text="{Binding Ssid}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                  <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#A1A1AA" />
                                    <TextBlock Text=" &#x2022; " FontSize="10" Foreground="#52525B" Visibility="{Binding IsSecured, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding SecurityType}" FontSize="10" Foreground="#71717A" Visibility="{Binding IsSecured, Converter={StaticResource BoolToVis}}" />
                                  </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        Command="{Binding DataContext.ConnectWifiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                  <Control.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                      <Border Name="btnBd" CornerRadius="6" Padding="10,4">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="#222234" />
                                            <Setter Property="BorderBrush" Value="#32324A" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#1A2D24" />
                                                <Setter Property="BorderBrush" Value="#22C55E" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                          <TextBlock Text="&#x2713; " FontSize="10" FontWeight="Bold" Foreground="#22C55E" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                          <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                            <FrameworkElement.Style>
                                              <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#CBD5E1" />
                                                <Setter Property="Text" Value="Hubungkan" />
                                                <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                    <Setter Property="Text" Value="Terhubung" />
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </FrameworkElement.Style>
                                          </TextBlock>
                                        </StackPanel>
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                                          <Setter TargetName="btnBd" Property="Border.Background" Value="#32324C" />
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Control.Template>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </StackPanel>
                </Border>


                <!-- Inline Expander: Bluetooth Devices List (tepat dibawah baris pertama) -->
                <Border Grid.Row="1" Visibility="{Binding IsBluetoothExpanded, Converter={StaticResource BoolToVis}}"
                        Background="#121218" BorderBrush="#252538" BorderThickness="1" CornerRadius="12"
                        Margin="0,6,0,6" Padding="12,10" SnapsToDevicePixels="True">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M2,4.5 L9,10 L5.5,14 L5.5,1 L9,5 L2,10.5"
                              Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stretch="Uniform" Width="10" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="PERANGKAT BLUETOOTH" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Pindai Ulang" Margin="0,0,6,0" Command="{Binding RefreshBluetoothCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="rfBd" Background="#1C1C2A" CornerRadius="6" Padding="6,3">
                                <Path Data="M13.6,2.4 C12.2,0.9 10.2,0 8,0 C3.6,0 0,3.6 0,8 C0,12.4 3.6,16 8,16 C11.7,16 14.8,13.4 15.7,9.9 L13.6,9.9 C12.8,12.3 10.6,14 8,14 C4.7,14 2,11.3 2,8 C2,4.7 4.7,2 8,2 C9.7,2 11.1,2.7 12.2,3.8 L9,7 L16,7 L16,0 L13.6,2.4" Fill="#9CA3AF" Width="10" Height="10" Stretch="Uniform" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="rfBd" Property="Border.Background" Value="#28283E" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                        <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Pengaturan Bluetooth Windows" Margin="0,0,6,0" Command="{Binding OpenBluetoothSettingsCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="stBd" Background="#1C1C2A" CornerRadius="6" Padding="6,3">
                                <Path Data="M2,3.5 L4.5,3.5 M7.5,3.5 L12,3.5 M4.5,2 L4.5,5 M2,7 L8,7 M11,7 L12,7 M8,5.5 L8,8.5 M2,10.5 L5.5,10.5 M8.5,10.5 L12,10.5 M5.5,9 L5.5,12" Stroke="#9CA3AF" StrokeThickness="1.1" StrokeStartLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="stBd" Property="Border.Background" Value="#28283E" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                        <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Tutup" Command="{Binding ToggleBluetoothExpandCommand}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="clBd" Background="#1C1C2A" CornerRadius="6" Padding="6,3">
                                <Path Data="M1,1 L7,7 M7,1 L1,7" Stroke="#9CA3AF" StrokeThickness="1.3" StrokeStartLineCap="Round" Width="8" Height="8" Stretch="Uniform" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="clBd" Property="Border.Background" Value="#28283E" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </StackPanel>
                    </DockPanel>
                    <!-- Fixed Height 128 Container -->
                    <Grid Height="128">
                      <!-- Searching View -->
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Visibility="{Binding BluetoothMgr.ShowSearching, Converter={StaticResource BoolToVis}}">
                        <Border Width="30" Height="30" CornerRadius="15" Background="#181826" Margin="0,0,0,8" HorizontalAlignment="Center">
                          <Path Data="M2,4.5 L9,10 L5.5,14 L5.5,1 L9,5 L2,10.5"
                                Stroke="#38BDF8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                Stretch="Uniform" Width="11" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Searching for Bluetooth..." FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" />
                      </StackPanel>


                      <!-- Empty View -->
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Visibility="{Binding BluetoothMgr.ShowEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Tidak ada perangkat Bluetooth ditemukan" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" />
                        <Button Command="{Binding RefreshBluetoothCommand}" Margin="0,6,0,0" Background="#1C1C2A" BorderThickness="0" Cursor="Hand">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Background="#1C1C2A" CornerRadius="6" Padding="10,4">
                                <TextBlock Text="Pindai Ulang" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                              </Border>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </StackPanel>


                      <!-- Active List -->
                      <ScrollViewer Height="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                    Style="{StaticResource ModernSlimScrollViewer}"
                                    Visibility="{Binding BluetoothMgr.ShowList, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding BluetoothMgr.Devices}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="#181824" CornerRadius="8" Padding="10,6" Margin="0,2">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Column="0" VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,10,0">
                                  <Path Data="M1,7 C1,3.5 3.5,1 7,1 C10.5,1 13,3.5 13,7 L13,12 L10,12 L10,7 L11.5,7 M1,7 L4,7 L4,12 L1,12"
                                        Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" Stretch="Uniform" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                  <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#A1A1AA" Margin="0,1,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        Command="{Binding DataContext.SelectBluetoothDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                  <Control.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                      <Border Name="btnBd" CornerRadius="6" Padding="10,4">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="#222234" />
                                            <Setter Property="BorderBrush" Value="#32324A" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Background" Value="#1A2D24" />
                                                <Setter Property="BorderBrush" Value="#22C55E" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                          <TextBlock Text="&#x2713; " FontSize="10" FontWeight="Bold" Foreground="#22C55E" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                                          <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                            <FrameworkElement.Style>
                                              <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#CBD5E1" />
                                                <Setter Property="Text" Value="Sambungkan" />
                                                <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Foreground" Value="#22C55E" />
                                                    <Setter Property="Text" Value="Terhubung" />
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </FrameworkElement.Style>
                                          </TextBlock>
                                        </StackPanel>
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                                          <Setter TargetName="btnBd" Property="Border.Background" Value="#32324C" />
                                        </Trigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Control.Template>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </StackPanel>
                </Border>


                <!-- Baris 2 Quick Actions (4 Kolom): Microphone, Screenshot, Lock, Task Manager -->
                <Grid Grid.Row="2" Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>


                  <!-- 1. Microphone -->
                  <StackPanel Grid.Column="0">
                    <Button Height="46" Background="#181824" BorderBrush="#262638" BorderThickness="1" Cursor="Hand" ToolTip="Mikrofon" FocusVisualStyle="{x:Null}" Command="{Binding ToggleMicrophoneMuteCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="15">
                              <Path Name="icoCapsule" Data="M7,2 C5.9,2 5,2.9 5,4 L5,8 C5,9.1 5.9,10 7,10 C8.1,10 9,9.1 9,8 L9,4 C9,2.9 8.1,2 7,2" Fill="#FFFFFF" Stretch="Uniform" />
                              <Path Name="icoArc" Data="M3,7 C3,10 5,12 7,12 C9,12 11,10 11,7 M7,12 L7,15 M4.5,15 L9.5,15" Stroke="#FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" Stretch="Uniform" />
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsMicrophoneMuted}">
                              <Setter TargetName="bd" Property="Border.Background" Value="#38BDF8" />
                              <Setter TargetName="bd" Property="Border.BorderBrush" Value="#38BDF8" />
                              <Setter TargetName="icoCapsule" Property="Shape.Fill" Value="#09090B" />
                              <Setter TargetName="icoArc" Property="Shape.Stroke" Value="#09090B" />
                            </DataTrigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Border.Background" Value="#222232" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <TextBlock Text="Mikrofon" FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" />
                  </StackPanel>


                  <!-- 2. Screenshot -->
                  <StackPanel Grid.Column="2">
                    <Button Height="46" Background="#181824" BorderBrush="#262638" BorderThickness="1" Cursor="Hand" ToolTip="Screenshot" FocusVisualStyle="{x:Null}" Command="{Binding CaptureScreenCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="12">
                            <Path Name="ico" Data="M4,1 L4,12 L15,12 M1,4 L12,4 L12,15" Stroke="#FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Border.Background" Value="#222232" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <TextBlock Text="Screenshot" FontSize="11" FontWeight="Medium" Foreground="#A1A1AA" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,5,0,0" />
                  </StackPanel>


                  <!-- 3. Lock -->
