                <Control.Template>
                  <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Viewbox Stretch="Uniform">
                      <Canvas Width="12" Height="12">
                        <!-- Stationary Tray -->
                        <Path Data="M1.5,8.5 L1.5,11 L10.5,11 L10.5,8.5"
                              Stroke="{DynamicResource AccentLightBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <!-- Moving Arrow -->
                        <Path x:Name="CollapsedDownloadArrow"
                              Data="M6,1.5 L6,7.5 M3.5,5 L6,7.5 L8.5,5"
                              Stroke="{DynamicResource AccentLightBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round">
                          <Path.RenderTransform>
                            <TranslateTransform x:Name="CollapsedDownloadArrowTrans" X="0" Y="0" />
                          </Path.RenderTransform>
                        </Path>
                      </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsVisible" Value="True">
                        <TriggerBase.EnterActions>
                          <BeginStoryboard Name="CollapsedDownloadIconAnim">
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetName="CollapsedDownloadArrowTrans"
                                               Storyboard.TargetProperty="Y"
                                               From="-1.5" To="1.8"
                                               Duration="0:0:0.75"
                                               AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                  <QuadraticEase EasingMode="EaseInOut" />
                                </DoubleAnimation.EasingFunction>
                              </DoubleAnimation>
                            </Storyboard>
                          </BeginStoryboard>
                        </TriggerBase.EnterActions>
                        <TriggerBase.ExitActions>
                          <StopStoryboard BeginStoryboardName="CollapsedDownloadIconAnim" />
                        </TriggerBase.ExitActions>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </ContentControl>


              <!-- Di samping icon: Nama File -->
              <TextBlock Grid.Column="1"
                         Foreground="#FFFFFF"
