                <RowDefinition Height="*" />

              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">

                <Border Background="#1E293B" CornerRadius="4" Padding="6,1.5" Margin="0,0,8,0">

                  <TextBlock Text="PILIHAN DROP" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />

                </Border>

                <Border Name="InNotchToastBorder" Grid.Row="0" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Background="#F012121E" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="14" Padding="12,5" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="120">

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Name="InNotchToastIcon" Text="&#x1F680;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />

                    <TextBlock Name="InNotchToastTitle" Text="Ditambahkan ke Dock" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Name="InNotchToastMsg" Text="Visual Studio Code" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />

                  </StackPanel>

                </Border>

                <TextBlock Text="Arahkan dan lepaskan file pada pilihan tujuan di bawah:" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />

              </StackPanel>

              <Grid Row="1">

                <Grid.ColumnDefinitions>

                  <ColumnDefinition Width="*" />

                  <ColumnDefinition Width="12" />

                  <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <Border Name="DropTargetShelf" Grid.Column="0" Background="#131320" BorderBrush="#252538" BorderThickness="1.5" CornerRadius="12" AllowDrop="True" SnapsToDevicePixels="True" PreviewDragEnter="DropTargetShelf_PreviewDragEnter" PreviewDragOver="DropTargetShelf_PreviewDragOver" PreviewDragLeave="DropTargetShelf_PreviewDragLeave" Drop="DropTargetShelf_Drop">

                  <Grid Margin="12,10" IsHitTestVisible="False">

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="*" />

                      <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <Border Name="DropTargetShelfIconBg" Grid.Row="0" Width="36" Height="36" CornerRadius="18" Background="#16253C" HorizontalAlignment="Center" Margin="0,2,0,6">

                      <Path Data="M4,16 L4,17 A3,3 0 0 0 7,20L17,20 A3,3 0 0 0 20,17L20,16 M16,12 L12,16 M12,16 L8,12 M12,16 L12,4" Stroke="#38BDF8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <TextBlock Name="DropTargetShelfTitle" Grid.Row="1" Text="Simpan di Shelf" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Center" Margin="0,0,0,2" />

                    <TextBlock Grid.Row="2" Text="Stash file atau folder sementara untuk disalin atau dipindahkan nanti" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="4,0,4,6" />

                    <Border Name="DropTargetShelfBadge" Grid.Row="3" Background="#162235" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">

                      <TextBlock Name="DropTargetShelfBadgeText" Text="&#x1F4E5; Lepaskan ke Shelf" FontSize="11" FontWeight="Medium" Foreground="#38BDF8" />

                    </Border>

                  </Grid>

                </Border>

                <Border Name="DropTargetDock" Grid.Column="2" Background="#131320" BorderBrush="#252538" BorderThickness="1.5" CornerRadius="12" AllowDrop="True" SnapsToDevicePixels="True" PreviewDragEnter="DropTargetDock_PreviewDragEnter" PreviewDragOver="DropTargetDock_PreviewDragOver" PreviewDragLeave="DropTargetDock_PreviewDragLeave" Drop="DropTargetDock_Drop">

                  <Grid Margin="12,10" IsHitTestVisible="False">

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="*" />

                      <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <Border Name="DropTargetDockIconBg" Grid.Row="0" Width="36" Height="36" CornerRadius="18" Background="#261A40" HorizontalAlignment="Center" Margin="0,2,0,6">

                      <Path Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 L12,2" Stroke="#A78BFA" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <TextBlock Name="DropTargetDockTitle" Grid.Row="1" Text="Tambahkan ke Dock" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Center" Margin="0,0,0,2" />

                    <TextBlock Grid.Row="2" Text="Jadikan pintasan permanen di bar bawah notch untuk akses cepat" FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="4,0,4,6" />

                    <Border Name="DropTargetDockBadge" Grid.Row="3" Background="#251A38" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">

                      <TextBlock Name="DropTargetDockBadgeText" Text="&#x1F680; Lepaskan ke Dock" FontSize="11" FontWeight="Medium" Foreground="#A78BFA" />

                    </Border>

                  </Grid>

                </Border>

              </Grid>

            </Grid>

          </Border>

        </Grid>

      </Grid>

      <!-- Sapaan startup: maskot melambai di tengah notch, lalu bergeser ke posisi pet dan memudar -->
      <Grid x:Name="WelcomeOverlay" Width="36" Height="26"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="WelcomeOverlayTranslate" X="0" Y="0" />
        </Grid.RenderTransform>
        <Grid Width="28" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5, 0.5">
          <Grid.RenderTransform>
            <ScaleTransform x:Name="WelcomePetScale" ScaleX="1.3" ScaleY="1.3" />
          </Grid.RenderTransform>
          <controls:MochiPetControl x:Name="WelcomePet" Width="28" Height="20" IsHitTestVisible="False" />
        </Grid>
      </Grid>

    </Grid>

    <!-- Fullscreen Slim Bar: garis tipis pengganti notch saat aplikasi fullscreen aktif -->
    <Grid x:Name="FullscreenSlimBarHost"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          Visibility="Collapsed" Opacity="0"
          IsHitTestVisible="False"
          SnapsToDevicePixels="True" UseLayoutRounding="True">
      <Border x:Name="FullscreenSlimBar"
              Width="220" Height="6"
              CornerRadius="0,0,6,6"
              Background="{DynamicResource NotchBackgroundBrush}"
              BorderBrush="{DynamicResource NotchStrokeBrush}"
              BorderThickness="1,0,1,1"
              RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="FullscreenSlimBarScale" ScaleX="0.6" ScaleY="1"/>
            <ScaleTransform x:Name="SlimBarHoverScale" ScaleX="1" ScaleY="1"/>
          </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.35" RenderingBias="Performance"/>
        </Border.Effect>
      </Border>
    </Grid>

  </Grid>

</Window>
