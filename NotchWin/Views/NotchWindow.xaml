                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                              <TextBlock Text="25m" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" />
                              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" Text="{Binding L10n[Timer.Pomodoro]}" />
                            </StackPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="tile" Property="Border.Background" Value="#201C2E" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </Grid>
                </Grid>
                <Rectangle Grid.Column="1" Width="1" Fill="#28283C" Margin="0,4,0,4" VerticalAlignment="Stretch" />
                <Grid Column="2" Margin="10,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#12121B" BorderBrush="#242436" BorderThickness="1" CornerRadius="12" Padding="7,6" Margin="0,0,6,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid Row="0" HorizontalAlignment="Center" Margin="0,5,0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <TextBlock FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Text="{Binding TimerStopwatch.StopwatchMinutesSeconds}" />
                          <Border Background="#1C1C2C" CornerRadius="5" Padding="3,1" Margin="3,3,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Text="{Binding TimerStopwatch.StopwatchCentiseconds}" />
                          </Border>
                        </StackPanel>
                      </Grid>
                      <Grid Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="4" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="23" Cursor="Hand" Command="{Binding TimerStopwatch.StartPauseStopwatchCommand}" FocusVisualStyle="{x:Null}">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Button}">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Name="pillBorder" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="11.5" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                      <TextBlock FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TimerStopwatch.StopwatchStartPauseText}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding TimerStopwatch.IsStopwatchRunning}">
                                        <Setter TargetName="pillBorder" Property="Border.Background" Value="#F59E0B" />
                                      </DataTrigger>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="pillBorder" Property="UIElement.Opacity" Value="0.9" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </FrameworkElement.Style>
                        </Button>
                        <Button Grid.Column="2" Height="23" Width="33" Cursor="Hand" Command="{Binding TimerStopwatch.AddLapCommand}" IsEnabled="{Binding TimerStopwatch.IsStopwatchRunning}" FocusVisualStyle="{x:Null}">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Button}">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Name="bdr" Background="#181824" BorderBrush="#262638" BorderThickness="1" CornerRadius="11.5">
                                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding L10n[Timer.Lap]}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Border.Background" Value="#242436" />
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter Property="UIElement.Opacity" Value="0.35" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </Button>
                        <Button Grid.Column="4" Height="23" Width="34" Cursor="Hand" Command="{Binding TimerStopwatch.ResetStopwatchCommand}" FocusVisualStyle="{x:Null}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="bdr" Background="#181824" BorderBrush="#262638" BorderThickness="1" CornerRadius="11.5">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding L10n[Timer.Reset]}" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="bdr" Property="Border.Background" Value="#2A1B1B" />
                                  <Setter TargetName="bdr" Property="Border.BorderBrush" Value="#4C2222" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                  <Border Grid.Column="1" Background="#12121B" BorderBrush="#242436" BorderThickness="1" CornerRadius="12" Padding="6,4">
                    <Grid>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding TimerStopwatch.HasNoLaps, Converter={StaticResource BoolToVis}}">
                        <Path Data="M3,1 L3,13 M3,2 L10,2 L8.5,5 L10,8 L3,8" Stroke="#525264" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="13" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,3" />
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Center" Text="{Binding L10n[Timer.NoLaps]}" />
                        <TextBlock FontSize="10" Foreground="#8E8E9E" HorizontalAlignment="Center" Margin="0,1,0,0" Text="{Binding L10n[Timer.PressLap]}" />
                      </StackPanel>
                      <ScrollViewer Style="{StaticResource ModernSlimScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding TimerStopwatch.HasLaps, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding TimerStopwatch.Laps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="#161622" CornerRadius="5" Margin="0,1" Padding="5,2">
                                <DockPanel>
                                  <TextBlock DockPanel.Dock="Left" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" Text="{Binding LapNumber, StringFormat=Lap {0}}" />
                                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="10" Foreground="#A1A1AA" Margin="0,0,4,0" VerticalAlignment="Center" Text="{Binding DeltaText}" />
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Text="{Binding TimeText}" />
                                  </StackPanel>
                                </DockPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <Border Name="SlideShelfCard" Width="584" MinHeight="136" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Background="#00FFFFFF" BorderThickness="0" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" Visibility="Collapsed" Opacity="0">
              <Grid Margin="10,0,10,0" MinHeight="136">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Area Drop Zone Kosong (Center Penuh Saat Barcode Tutup, Kolom Kiri Saat Barcode Buka) -->
                <Border Name="ShelfEmptyDropZone" MinHeight="136" Background="#00FFFFFF" BorderThickness="0" CornerRadius="12" AllowDrop="True" Cursor="Hand" Visibility="{Binding Shelf.IsEmpty, Converter={StaticResource BoolToVis}}" Drop="ShelfDropZone_Drop" DragOver="ShelfDropZone_DragOver" MouseLeftButtonDown="ShelfEmptyState_MouseLeftButtonDown">
                  <Border.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Grid.Column" Value="0" />
                      <Setter Property="Grid.ColumnSpan" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding PhoneShare.IsPanelOpen}" Value="False">
                          <Setter Property="Grid.Column" Value="0" />
                          <Setter Property="Grid.ColumnSpan" Value="2" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="34" Height="34" CornerRadius="17" Background="#161626" BorderBrush="#2A2A42" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Path Data="M3,8 L8,3 L13,8 M8,3 L8,13 M2,13 L14,13" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Text="{Binding L10n[Shelf.EmptyTitle]}" />
                      <TextBlock FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,3,0,0" Text="{Binding L10n[Shelf.EmptyDesc]}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- 2. Area Berkas Shelf (Tampil Saat Memiliki Berkas) -->
                <Grid Column="0" Visibility="{Binding Shelf.HasItems, Converter={StaticResource BoolToVis}}">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,3,2,6">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                      <Path Data="M2,3 L12,3 L13,8 L9.5,8 C9.5,9.2 8.5,10.2 7,10.2 C5.5,10.2 4.5,9.2 4.5,8 L1,8 L2,3 M1,8 L1,12 C1,12.5 1.5,13 2,13 L12,13 C12.5,13 13,12.5 13,12 L13,8" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                      <TextBlock FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center" Text="{Binding L10n[Shelf.Header]}" />
                      <Border Background="#1A1A28" CornerRadius="5" Padding="6,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding Shelf.ItemsCountText}" />
                      </Border>
                      <TextBlock FontSize="11" Foreground="#8E8E9E" Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Shelf.TotalSizeText, StringFormat='&#x2022; {0}'}" />
                    </StackPanel>
                  </DockPanel>
                  <Border Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" CornerRadius="12" Padding="8,6" AllowDrop="True" IsHitTestVisible="{Binding Shelf.HasItems}" Drop="ShelfDropZone_Drop" DragOver="ShelfDropZone_DragOver">
                    <Grid>
                      <ScrollViewer Style="{StaticResource ModernSlimScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Name="ShelfItemsControl" ItemsSource="{Binding Shelf.Items}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="120" Height="96" Background="#00FFFFFF" BorderBrush="#28283E" BorderThickness="1" CornerRadius="9" Margin="0,0,7,0" Padding="7,6" Cursor="Hand" PreviewMouseMove="ShelfItemCard_PreviewMouseMove" MouseLeftButtonDown="ShelfItemCard_MouseLeftButtonDown">
                                <Grid>
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                  </Grid.RowDefinitions>
                                  <DockPanel Grid.Row="0">
                                    <Button DockPanel.Dock="Right" Background="#00FFFFFF" BorderThickness="0" Width="20" Height="20" Cursor="Hand" ToolTip="{Binding DataContext.L10n[Shelf.RemoveTooltip], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.Shelf.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" PreviewMouseLeftButtonDown="ShelfItemDeleteButton_PreviewMouseLeftButtonDown" Click="ShelfItemDeleteButton_Click">
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <Border Name="delBdr" Background="#222234" CornerRadius="5" Width="18" Height="18">
                                            <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="#A1A1AA" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                          </Border>
                                          <ControlTemplate.Triggers>
                                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                                              <Setter TargetName="delBdr" Property="Border.Background" Value="#E11D48" />
                                            </Trigger>
                                          </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                    <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True" Background="#1E1E2C" HorizontalAlignment="Left">
                                      <Grid>
                                        <Image Stretch="UniformToFill" Source="{Binding Thumbnail}" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                        <Path Data="M2,1.5 L9,1.5 L12,4.5 L12,12.5 C12,13 11.5,13.5 11,13.5 L2,13.5 C1.5,13.5 1,13 1,12.5 L1,2.5 C1,2 1.5,1.5 2,1.5" Stroke="#A1A1AA" StrokeThickness="1.1" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                                      </Grid>
                                    </Border>
                                  </DockPanel>
                                  <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding FileName}" ToolTip="{Binding FilePath}" />
                                    <TextBlock FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                      <FrameworkElement.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                          <Setter Property="Foreground" Value="#8E8E9E" />
                                          <Setter Property="Text" Value="{Binding FileSizeFormatted}" />
                                          <Style.Triggers>
                                            <DataTrigger Value="True" Binding="{Binding IsMissing}">
                                              <Setter Property="Text" Value="{Binding StatusText}" />
                                              <Setter Property="Foreground" Value="#F87171" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                    </TextBlock>
                                  </StackPanel>
                                  <Grid Row="2" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="3" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="18" Background="#1E1E2E" BorderThickness="0" Cursor="Hand" ToolTip="{Binding DataContext.L10n[Shelf.OpenButton], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.Shelf.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <FrameworkElement.Style>
                                        <Style TargetType="{x:Type Button}">
                                          <Style.Triggers>
                                            <DataTrigger Value="True" Binding="{Binding IsMissing}">
                                              <Setter Property="IsEnabled" Value="False" />
                                              <Setter Property="UIElement.Opacity" Value="0.4" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </FrameworkElement.Style>
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <Border Background="{TemplateBinding Control.Background}" CornerRadius="3">
                                            <TextBlock FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DataContext.L10n[Shelf.OpenButton], RelativeSource={RelativeSource AncestorType=Window}}" />
                                          </Border>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                    <Button Grid.Column="2" Height="18" Background="#1E1E2E" BorderThickness="0" Cursor="Hand" ToolTip="{Binding DataContext.L10n[Shelf.CopyButton], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.Shelf.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <Control.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                          <Border Background="{TemplateBinding Control.Background}" CornerRadius="3">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DataContext.L10n[Shelf.CopyButton], RelativeSource={RelativeSource AncestorType=Window}}" />
                                          </Border>
                                        </ControlTemplate>
                                      </Control.Template>
                                    </Button>
                                  </Grid>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <Canvas Name="ShelfBurstCanvas" ClipToBounds="False" IsHitTestVisible="False" ZIndex="-1" />
                    </Grid>
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" Width="144" Margin="8,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" Panel.ZIndex="10">
                  <!-- Baris Tombol Aksi: Phone Share Toggle + Tambah File (+) + Hapus Semua (Trash) -->
                  <Grid Height="26" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="5" />
                      <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <!-- 1. Tombol Phone Share Toggle -->
                    <Button Grid.Column="0" Height="26" Cursor="Hand" ToolTip="{Binding L10n[Shelf.PhoneTooltip]}" Command="{Binding ShowPhoneShareCommand}" Visibility="{Binding IsPhoneShareEnabled, Converter={StaticResource BoolToVis}}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="phoneBdr" Background="#181826" BorderBrush="#28283E" BorderThickness="1" CornerRadius="7" Padding="6,2">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Path Grid.Column="0" Data="M4,1 L10,1 C10.8,1 11.5,1.7 11.5,2.5 L11.5,13.5 C11.5,14.3 10.8,15 10,15 L4,15 C3.2,15 2.5,14.3 2.5,13.5 L2.5,2.5 C2.5,1.7 3.2,1 4,1 M6,12.6 L8,12.6" Stroke="#38BDF8" StrokeThickness="1.1" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" FontSize="10.5" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0,3,0" Text="{Binding L10n[Shelf.PhoneButton]}" TextTrimming="CharacterEllipsis" />
                              <Ellipse Grid.Column="2" Width="5.5" Height="5.5" Fill="#34D399" VerticalAlignment="Center" Visibility="{Binding PhoneShare.IsRunning, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding PhoneShare.IsPanelOpen}" Value="True">
                              <Setter TargetName="phoneBdr" Property="Border.Background" Value="#222238" />
                              <Setter TargetName="phoneBdr" Property="Border.BorderBrush" Value="#38BDF8" />
                            </DataTrigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="phoneBdr" Property="Border.Background" Value="#282842" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <!-- 2. Tombol Add File (+) -->
                    <Button Grid.Column="2" Width="26" Height="26" Cursor="Hand" ToolTip="{Binding L10n[Shelf.AddButton]}" Command="{Binding Shelf.PickFilesCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="addBdr" Background="#181826" BorderBrush="#28283E" BorderThickness="1" CornerRadius="7">
                            <Path Data="M7,1 L7,13 M1,7 L13,7" Stroke="#CBD5E1" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="addBdr" Property="Border.Background" Value="#202032" />
                              <Setter TargetName="addBdr" Property="Border.BorderBrush" Value="#38BDF8" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <!-- 3. Tombol Clear All (Trash) -->
                    <Button Grid.Column="4" Width="26" Height="26" Cursor="Hand" ToolTip="{Binding L10n[Shelf.ClearButton]}" Command="{Binding Shelf.ClearAllCommand}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="clearBdr" Background="#181826" BorderBrush="#28283E" BorderThickness="1" CornerRadius="7">
                            <Path Data="M2,3.5 L12,3.5 M5,3.5 L5,1.8 L9,1.8 L9,3.5 M3.5,3.5 L4.2,13.2 L9.8,13.2 L10.5,3.5 M6,6 L6,11 M8,6 L8,11" Stroke="#F87171" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Shelf.IsEmpty}" Value="True">
                              <Setter Property="UIElement.IsEnabled" Value="False" />
                              <Setter Property="UIElement.Opacity" Value="0.35" />
                            </DataTrigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="clearBdr" Property="Border.Background" Value="#231018" />
                              <Setter TargetName="clearBdr" Property="Border.BorderBrush" Value="#EF4444" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </Grid>


                  <!-- Modern Barcode under Buttons with crisp high-contrast typography -->
                  <Border Name="ShelfPhoneUnderBarcode" Visibility="{Binding PhoneShare.IsPanelOpen, Converter={StaticResource BoolToVis}}" Background="#12121E" BorderBrush="#25253A" BorderThickness="1" CornerRadius="8" Padding="6,6" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
                    <StackPanel HorizontalAlignment="Center">
                      <Border Background="#FFFFFF" CornerRadius="6" Padding="3" HorizontalAlignment="Center">
                        <Image Width="70" Height="70" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding PhoneShare.Qrcode}" />
                      </Border>
                      <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="132" Margin="0,4,0,0" Text="{Binding L10n[Phone.ScanHint]}" ToolTip="{Binding L10n[Phone.OpenHint]}" />
                      <TextBlock FontSize="9.5" FontWeight="Medium" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" MaxWidth="132" HorizontalAlignment="Center" Margin="0,2,0,0" Text="{Binding PhoneShare.Url}" ToolTip="{Binding PhoneShare.Url}" />
                      <Grid Margin="0,5,0,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="5" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Height="21" Padding="8,1" Cursor="Hand" ToolTip="{Binding L10n[Phone.CopyLink]}" Click="ShelfPhoneCopyLink_Click">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="cpBdr" Background="#1C1C2A" BorderBrush="#2D2D42" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Control.Padding}">
                                <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding L10n[Phone.CopyLink]}" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="cpBdr" Property="Border.Background" Value="#252538" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                        <Button Grid.Column="2" Height="21" Padding="8,1" Cursor="Hand" ToolTip="{Binding L10n[Phone.Stop]}" Click="ShelfPhoneStop_Click">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="stBdr" Background="#231018" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Control.Padding}">
                                <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#F87171" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding L10n[Phone.Stop]}" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="stBdr" Property="Border.Background" Value="#321420" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </Grid>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Ellipse Width="5" Height="5" Fill="#34D399" VerticalAlignment="Center" />
                        <TextBlock FontSize="9" FontWeight="Medium" Foreground="#A1A1AA" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding PhoneShare.StatusText}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <Border Name="SlideScreenTimeCard" Width="584" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Background="#00FFFFFF" BorderThickness="0" UseLayoutRounding="True" SnapsToDevicePixels="True" Visibility="Collapsed" Opacity="0">
              <Grid Margin="4,4,4,4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!-- ROW 0: 24h Hourly Histogram & Most Used Applications -->
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="282" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- LEFT BENTO BOX: Total Waktu & Grafik 24 Jam -->
                <Border Grid.Column="0" Background="#12121C" BorderBrush="#222232" BorderThickness="1" CornerRadius="12" Padding="12,9" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- Row 0: Header & Switches Badge -->
                    <DockPanel Grid.Row="0" LastChildFill="False">
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M2,12 L2,7 M6,12 L6,3 M10,12 L10,5 M14,12 L14,8 M1,13 L15,13" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10.5" Height="10.5" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center" Text="{Binding L10n[ScreenTime.Header]}" />
                      </StackPanel>
                      <Border DockPanel.Dock="Right" Background="#1C1C28" BorderBrush="#2A2A3C" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ScreenTime.SwitchesCountText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                          <TextBlock Text=" " FontSize="9.5" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding L10n[ScreenTime.AppSwitches]}" FontSize="9.5" Foreground="#A1A1AA" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </DockPanel>


                    <!-- Row 1: Big Time Display & Idle Excluded Badge -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                      <TextBlock FontSize="25" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Text="{Binding ScreenTime.TotalTimeTodayText}" VerticalAlignment="Center" />
                      <Border Background="#1A1A28" BorderBrush="#26263A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding L10n[ScreenTime.IdleExcluded]}" />
                      </Border>
                    </StackPanel>


                    <!-- Row 2: 24h Hourly Histogram Chart -->
                    <Border Grid.Row="2" Background="#0C0C14" BorderBrush="#1C1C28" BorderThickness="1" CornerRadius="7" Padding="6,3,6,2" Margin="0,2,0,0">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="*" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>


                        <!-- 24 Bars -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding ScreenTime.HourlyBars}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="1" Columns="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid ToolTip="{Binding Tooltip}" Cursor="Hand" Background="Transparent" Margin="0.5,0">
                                <Border VerticalAlignment="Bottom" Height="{Binding HeightPercent}" MaxHeight="32" MinHeight="2" CornerRadius="1.5">
                                  <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Setter Property="Background" Value="#252538" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentHour}" Value="True">
                                          <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Border.Style>
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <!-- Hour Labels -->
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                          <TextBlock Text="00" FontSize="8.5" Foreground="#71717A" HorizontalAlignment="Left" />
                          <TextBlock Text="06" FontSize="8.5" Foreground="#71717A" HorizontalAlignment="Left" Margin="52,0,0,0" />
                          <TextBlock Text="12" FontSize="8.5" Foreground="#71717A" HorizontalAlignment="Center" />
                          <TextBlock Text="18" FontSize="8.5" Foreground="#71717A" HorizontalAlignment="Right" Margin="0,0,52,0" />
                          <TextBlock Text="23" FontSize="8.5" Foreground="#71717A" HorizontalAlignment="Right" />
                        </Grid>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>


                <!-- RIGHT BENTO BOX: Paling Sering Digunakan -->
                <Border Grid.Column="2" Background="#12121C" BorderBrush="#222232" BorderThickness="1" CornerRadius="12" Padding="12,9" SnapsToDevicePixels="True" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- Header: Most Used Apps -->
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,7">
                      <TextBlock DockPanel.Dock="Left" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" Text="{Binding L10n[ScreenTime.MostUsed]}" />
                      <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="#71717A" Text="{Binding ScreenTime.TodayDateText}" />
                    </DockPanel>


                    <!-- Top Apps List -->
                    <Grid Grid.Row="1">
                      <!-- Empty State -->
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ScreenTime.HasData, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="&#x23F3;" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding L10n[ScreenTime.NoActivity]}" FontSize="10.5" Foreground="#71717A" HorizontalAlignment="Center" />
                      </StackPanel>


                      <!-- Top 4 Apps List -->
                      <ItemsControl ItemsSource="{Binding ScreenTime.TopApps}" Visibility="{Binding ScreenTime.HasData, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,2,0,2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>


                              <!-- Category Dot -->
                              <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding CategoryColorHex}" />


                              <!-- App Name & Progress Bar -->
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                <Border Height="3.5" Width="130" Background="#1C1C2A" CornerRadius="2" Margin="0,3,0,0" HorizontalAlignment="Left">
                                  <Border Height="3.5" Width="{Binding BarWidth}" Background="{Binding CategoryColorHex}" CornerRadius="2" HorizontalAlignment="Left" />
                                </Border>
                              </StackPanel>


                              <!-- Duration & Percent -->
                              <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DurationText}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding PercentOfTotal, StringFormat={}{0}%}" FontSize="9.5" Foreground="#71717A" HorizontalAlignment="Right" Margin="0,1,0,0" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Grid>
                </Border>
                </Grid>


                <!-- ROW 1: Sedentary / Screen Time Posture Monitor (Moved from Hydration) -->
                <Border Name="SittingCardContainer" Grid.Row="1" Margin="0,8,0,0" CornerRadius="12" Padding="14,8" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonUp="SittingCard_MouseLeftButtonUp" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" RenderOptions.ClearTypeHint="Enabled" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
                  <UIElement.RenderTransform>
                    <ScaleTransform x:Name="SittingCardScaleTransform" ScaleX="1" />
                  </UIElement.RenderTransform>
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#12121B" />
                      <Setter Property="BorderBrush" Value="#242436" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding Water.IsAlarmActive}">
                          <Setter Property="Background" Value="#1E1418" />
                          <Setter Property="BorderBrush" Value="#EF4444" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <Grid>
                    <!-- Front View: Live Sitting Timer & Actions -->
                    <Grid Name="SittingFrontView" Visibility="{Binding Water.IsSittingCardFlipped, Converter={StaticResource InverseBoolToVis}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="220" />
                      </Grid.ColumnDefinitions>


                      <!-- Left Column: Sitting Time & Status -->
                      <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <!-- Row 0: Header & Standard Info -->
                        <DockPanel Grid.Row="0" LastChildFill="False">
                          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M2,1 L2,6 L8,6 M2,6 L2,10 M8,6 L8,10" Stroke="#F59E0B" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9.5" Height="10.5" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#8E8E9E" VerticalAlignment="Center" Text="{Binding L10n[Sedentary.Title]}" />
                          </StackPanel>
                          <TextBlock DockPanel.Dock="Right" Text="Standard: 45m" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" />
                        </DockPanel>


                        <!-- Row 1: Big Sitting Duration & Posture Status -->
                        <Grid Grid.Row="1" Margin="0,3,0,3">
                          <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Bottom">
                              <TextBlock FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Text="{Binding Water.SittingDurationText}" />
                              <TextBlock FontSize="11" Foreground="#A1A1AA" Margin="5,0,0,3" VerticalAlignment="Bottom" Text="{Binding L10n[Sedentary.SittingTime]}" />
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="#161622" CornerRadius="4" Padding="6,2" VerticalAlignment="Bottom" Margin="0,0,0,2">
                              <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding Water.SittingStatusText}">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding Water.IsAlarmActive}">
                                        <Setter Property="Foreground" Value="#EF4444" />
                                      </DataTrigger>
                                      <DataTrigger Value="True" Binding="{Binding Water.IsUserIdle}">
                                        <Setter Property="Foreground" Value="#F59E0B" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </TextBlock>
                            </Border>
                          </DockPanel>
                        </Grid>


                        <!-- Row 2: Progress Bar -->
                        <ProgressBar Grid.Row="2" Height="4" Minimum="0" Maximum="1" Background="#1E1E2A" BorderThickness="0" Margin="0,3,0,2" Value="{Binding Water.SittingProgress}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type ProgressBar}">
                              <Grid Name="TemplateRoot">
                                <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="2" />
                                <Border Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left">
                                  <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Border}">
                                      <Setter Property="Background" Value="#F59E0B" />
                                      <Style.Triggers>
                                        <DataTrigger Value="True" Binding="{Binding Water.IsAlarmActive}">
                                          <Setter Property="Background" Value="#EF4444" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </FrameworkElement.Style>
                                </Border>
                              </Grid>
                            </ControlTemplate>
                          </Control.Template>
                        </ProgressBar>


                        <!-- Row 3: Click to Flip Prompt -->
                        <TextBlock Grid.Row="3" FontSize="10" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding L10n[Sedentary.ClickToFlip]}" VerticalAlignment="Center" Margin="0,3,0,0" />
                      </Grid>


                      <!-- Vertical Divider -->
                      <Rectangle Grid.Column="1" Fill="#222234" Margin="0,2" VerticalAlignment="Stretch" />


                      <!-- Right Column: Countdown Badge & Actions -->
                      <Grid Grid.Column="2" Margin="14,0,0,0">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <!-- Countdown Timer Pill -->
                        <Border Grid.Row="0" Background="#241B14" BorderBrush="#38281C" BorderThickness="1" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{Binding L10n[Sedentary.ClickToFlip]}">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M1,6 A5,5 0 0 1 6,1A5,5 0 0 1 11,6M6,1 L6,6 L8.5,7.5" Stroke="#F59E0B" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8.5" Height="8.5" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Text="{Binding Water.CountdownText}" />
                          </StackPanel>
                        </Border>


                        <!-- Action Buttons: Stand & Snooze -->
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Button Grid.Column="0" Height="25" Cursor="Hand" ToolTip="Press once you have stood up / taken a break" Command="{Binding Water.ConfirmStoodUpCommand}" FocusVisualStyle="{x:Null}">
                            <Control.Template>
                              <ControlTemplate TargetType="{x:Type Button}">
                                <Border Name="bdr" Background="#181826" BorderBrush="#28283E" BorderThickness="1" CornerRadius="7">
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M5.5,1.5 A1.2,1.2 0 1 1 5.5,3.9A1.2,1.2 0 0 1 5.5,1.5M5.5,4.5 L5.5,8.5 M5.5,8.5 L3.5,12.5 M5.5,8.5 L7.5,12.5 M3,6 L8,6" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="9.5" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Stand" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Border.Background" Value="#242436" />
                                    <Setter TargetName="bdr" Value="{DynamicResource AccentLightBrush}" Property="Border.BorderBrush" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Control.Template>
                          </Button>
                          <Button Grid.Column="2" Height="25" Cursor="Hand" ToolTip="Snooze alarm for 2 minutes" Command="{Binding Water.SnoozeAlarmCommand}" FocusVisualStyle="{x:Null}">
                            <Control.Template>
                              <ControlTemplate TargetType="{x:Type Button}">
                                <Border Name="bdr" Background="#181826" BorderBrush="#28283E" BorderThickness="1" CornerRadius="7">
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="M2,2 L5,2 L2,5.5 L5,5.5 M5.5,5.5 L8.5,5.5 L5.5,9 L8.5,9" Stroke="#F59E0B" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Snooze 2m" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Border.Background" Value="#242436" />
                                    <Setter TargetName="bdr" Property="Border.BorderBrush" Value="#F59E0B" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Control.Template>
                          </Button>
                        </Grid>
                      </Grid>
                    </Grid>


                    <!-- Back View: Daily Sedentary Statistics -->
                    <Grid Name="SittingBackView" Visibility="{Binding Water.IsSittingCardFlipped, Converter={StaticResource BoolToVis}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="220" />
                      </Grid.ColumnDefinitions>


                      <!-- Left Column: Summary & Total Today -->
                      <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <!-- Header -->
                        <DockPanel Grid.Row="0" LastChildFill="False">
                          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M1,9 L4,5 L7,7 L11,2 M11,2 L8,2 M11,2 L11,5" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#8E8E9E" VerticalAlignment="Center" Text="{Binding L10n[Sedentary.StatsHeader]}" />
                          </StackPanel>
                          <Border DockPanel.Dock="Right" Background="#181826" CornerRadius="5" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding L10n[Weather.Today]}" />
                          </Border>
                        </DockPanel>


                        <!-- Total Sitting Today Display -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,3,0,0">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Text="{Binding Water.TotalSittingTodayText}" />
                            <TextBlock FontSize="10" Foreground="#A1A1AA" Margin="5,0,0,2" VerticalAlignment="Bottom" Text="{Binding L10n[Sedentary.StatsDesc]}" />
                          </StackPanel>
                          <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0" Text="{Binding L10n[Sedentary.TotalToday]}" />
                        </StackPanel>


                        <!-- Standby Status & Back Button -->
                        <DockPanel Grid.Row="2" VerticalAlignment="Bottom" LastChildFill="False" Margin="0,3,0,0">
                          <TextBlock DockPanel.Dock="Left" FontSize="10" Foreground="#94A3B8" Text="{Binding L10n[Sedentary.Standby]}" />
                          <TextBlock DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding L10n[Sedentary.Back]}" />
                        </DockPanel>
                      </Grid>


                      <!-- Vertical Divider -->
                      <Rectangle Grid.Column="1" Fill="#222234" Margin="0,2" VerticalAlignment="Stretch" />


                      <!-- Right Column: Sesi Terlama & Frekuensi Berdiri -->
                      <Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="1" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" Text="{Binding L10n[Sedentary.LongestSession]}" />
                          <TextBlock FontSize="14" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,3,0,0" Text="{Binding Water.LongestSessionTodayText}" />
                        </StackPanel>


                        <Border Grid.Column="1" Background="#262638" Margin="0,4" />


                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" Text="{Binding L10n[Sedentary.StandBreaks]}" />
                          <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" Text="{Binding Water.BreaksCountTodayText}" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
          <Grid Name="NavDockHost" Row="1" Height="28" Margin="0,0,0,8" HorizontalAlignment="Center" Background="#00FFFFFF">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Name="NavDockTrack" Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="3,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Name="NavTabsHost" HorizontalAlignment="Center" VerticalAlignment="Center">
