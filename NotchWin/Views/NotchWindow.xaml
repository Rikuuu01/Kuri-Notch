                    </Grid>
                  </ControlTemplate>
                </Control.Template>
              </ProgressBar>
            </Grid>
          </Grid>
          <Grid Name="PrivacyOverlayHost" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,5,0" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
