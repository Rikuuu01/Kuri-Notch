                                <Setter TargetName="undoText" Property="TextBlock.Foreground" Value="#38BDF8" />

                                <Setter TargetName="undoIcon" Property="Shape.Stroke" Value="#38BDF8" />

                              </Trigger>

                            </ControlTemplate.Triggers>

                          </ControlTemplate>

                        </Control.Template>

                      </Button>

                      <Button DockPanel.Dock="Right" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding Water.ResetCommand}" FocusVisualStyle="{x:Null}">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type Button}">

                            <Border Background="#00FFFFFF" BorderThickness="0" Padding="2,1">

                              <TextBlock Name="rstText" Text="Reset" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" />

                            </Border>

                            <ControlTemplate.Triggers>

                              <Trigger Property="UIElement.IsMouseOver" Value="True">

                                <Setter TargetName="rstText" Property="TextBlock.Foreground" Value="#EF4444" />

                              </Trigger>

                            </ControlTemplate.Triggers>

                          </ControlTemplate>

                        </Control.Template>

                      </Button>

                    </DockPanel>

                  </Grid>

                </Border>

                <Rectangle Grid.Column="1" Width="1" Fill="#242436" Margin="6,4,6,4" VerticalAlignment="Stretch" />

                <Border Name="SittingCardContainer" Grid.Column="2" CornerRadius="12" Padding="12,8" RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonUp="SittingCard_MouseLeftButtonUp">

                  <UIElement.RenderTransform>

                    <ScaleTransform x:Name="SittingCardScaleTransform" ScaleX="1" />

                  </UIElement.RenderTransform>

                  <FrameworkElement.Style>

                    <Style TargetType="{x:Type Border}">

                      <Setter Property="Background" Value="#12121B" />

                      <Setter Property="BorderBrush" Value="#242436" />

                      <Setter Property="BorderThickness" Value="1" />

                      <Style.Triggers>

                        <DataTrigger Value="True" Binding="{Binding Water.IsAlarmActive}">

                          <Setter Property="Background" Value="#1E1418" />

                          <Setter Property="BorderBrush" Value="#EF4444" />

                        </DataTrigger>

                      </Style.Triggers>

                    </Style>

                  </FrameworkElement.Style>

                  <Grid>

                    <Grid Name="SittingFrontView" Visibility="{Binding Water.IsSittingCardFlipped, Converter={StaticResource InverseBoolToVis}}">

                      <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                      </Grid.RowDefinitions>

                      <DockPanel Grid.Row="0" LastChildFill="False">

                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M2,1 L2,6 L8,6 M2,6 L2,10 M8,6 L8,10" Stroke="#F59E0B" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9.5" Height="10.5" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />

                          <TextBlock FontSize="11" FontWeight="Bold" Foreground="#8E8E9E" VerticalAlignment="Center" Text="{Binding L10n[Sedentary.Title]}" />

                        </StackPanel>

                        <Border DockPanel.Dock="Right" Background="#241B14" BorderBrush="#38281C" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center" ToolTip="{Binding L10n[Sedentary.ClickToFlip]}">

                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Path Data="M1,6 A5,5 0 0 1 6,1A5,5 0 0 1 11,6M6,1 L6,6 L8.5,7.5" Stroke="#F59E0B" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center" />

                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Text="{Binding Water.CountdownText}" />

                          </StackPanel>

                        </Border>

                      </DockPanel>

                      <Grid Row="1" Margin="0,3,0,3">

                        <DockPanel LastChildFill="False">

                          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Bottom">

                            <TextBlock FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Text="{Binding Water.SittingDurationText}" />

                            <TextBlock FontSize="11" Foreground="#A1A1AA" Margin="4,0,0,3" VerticalAlignment="Bottom" Text="{Binding L10n[Sedentary.SittingTime]}" />

                          </StackPanel>

                          <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" Text="{Binding Water.SittingStatusText}">

                            <FrameworkElement.Style>

                              <Style TargetType="{x:Type TextBlock}">

                                <Setter Property="Foreground" Value="#94A3B8" />

                                <Style.Triggers>

                                  <DataTrigger Value="True" Binding="{Binding Water.IsAlarmActive}">

                                    <Setter Property="Foreground" Value="#EF4444" />

                                  </DataTrigger>

                                  <DataTrigger Value="True" Binding="{Binding Water.IsUserIdle}">

                                    <Setter Property="Foreground" Value="#F59E0B" />

                                  </DataTrigger>

                                </Style.Triggers>

                              </Style>

                            </FrameworkElement.Style>

                          </TextBlock>

                        </DockPanel>

                      </Grid>

                      <ProgressBar Grid.Row="2" Height="4" Minimum="0" Maximum="1" Background="#1E1E2A" BorderThickness="0" Margin="0,2,0,8" Value="{Binding Water.SittingProgress}">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type ProgressBar}">

                            <Grid Name="TemplateRoot">

                              <Border Name="PART_Track" Background="{TemplateBinding Control.Background}" CornerRadius="2" />

                              <Border Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left">

                                <FrameworkElement.Style>

                                  <Style TargetType="{x:Type Border}">

                                    <Setter Property="Background" Value="#F59E0B" />

                                    <Style.Triggers>

                                      <DataTrigger Value="True" Binding="{Binding Water.IsAlarmActive}">

                                        <Setter Property="Background" Value="#EF4444" />

                                      </DataTrigger>

                                    </Style.Triggers>

                                  </Style>

                                </FrameworkElement.Style>

                              </Border>

                            </Grid>

                          </ControlTemplate>

                        </Control.Template>

                      </ProgressBar>

                      <Grid Row="3" Margin="0,0,0,4">

                        <Grid.ColumnDefinitions>

                          <ColumnDefinition Width="*" />

                          <ColumnDefinition Width="6" />

                          <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="24" Cursor="Hand" ToolTip="Press once you have stood up / taken a break" Command="{Binding Water.ResetSittingCommand}" FocusVisualStyle="{x:Null}">

                          <Control.Template>

                            <ControlTemplate TargetType="{x:Type Button}">

                              <Border Name="bdr" Background="#181826" BorderBrush="#28283E" BorderThickness="1" CornerRadius="7">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                  <Path Data="M5.5,1.5 A1.2,1.2 0 1 1 5.5,3.9A1.2,1.2 0 0 1 5.5,1.5M5.5,4.5 L5.5,8.5 M5.5,8.5 L3.5,12.5 M5.5,8.5 L7.5,12.5 M3,6 L8,6" Stroke="#FFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="9.5" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />

                                  <TextBlock Text="Stand" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />

                                </StackPanel>

                              </Border>

                              <ControlTemplate.Triggers>

                                <Trigger Property="UIElement.IsMouseOver" Value="True">

                                  <Setter TargetName="bdr" Property="Border.Background" Value="#242436" />

                                  <Setter TargetName="bdr" Value="{DynamicResource AccentLightBrush}" Property="Border.BorderBrush" />

                                </Trigger>

                              </ControlTemplate.Triggers>

                            </ControlTemplate>

                          </Control.Template>

                        </Button>

                        <Button Grid.Column="2" Height="24" Cursor="Hand" ToolTip="Snooze alarm for 2 minutes" Command="{Binding Water.SnoozeCommand}" FocusVisualStyle="{x:Null}">

                          <Control.Template>

                            <ControlTemplate TargetType="{x:Type Button}">

                              <Border Name="bdr" Background="#181826" BorderBrush="#28283E" BorderThickness="1" CornerRadius="7">

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                  <Path Data="M2,2 L5,2 L2,5.5 L5,5.5 M5.5,5.5 L8.5,5.5 L5.5,9 L8.5,9" Stroke="#F59E0B" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />

                                  <TextBlock Text="Snooze 2m" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />

                                </StackPanel>

                              </Border>

                              <ControlTemplate.Triggers>

                                <Trigger Property="UIElement.IsMouseOver" Value="True">

                                  <Setter TargetName="bdr" Property="Border.Background" Value="#242436" />

                                  <Setter TargetName="bdr" Property="Border.BorderBrush" Value="#F59E0B" />

                                </Trigger>

                              </ControlTemplate.Triggers>

                            </ControlTemplate>

                          </Control.Template>

                        </Button>

                      </Grid>

                      <DockPanel Grid.Row="4" VerticalAlignment="Center" LastChildFill="False">

                        <TextBlock DockPanel.Dock="Left" Text="Standard: 45m" FontSize="10" Foreground="#94A3B8" />

                        <TextBlock DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding L10n[Sedentary.ClickToFlip]}" />

                      </DockPanel>

                    </Grid>

                    <Grid Name="SittingBackView" Visibility="{Binding Water.IsSittingCardFlipped, Converter={StaticResource BoolToVis}}">

                      <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                      </Grid.RowDefinitions>

                      <DockPanel Grid.Row="0" LastChildFill="False">

                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M1,9 L4,5 L7,7 L11,2 M11,2 L8,2 M11,2 L11,5" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />

                          <TextBlock FontSize="11" FontWeight="Bold" Foreground="#8E8E9E" VerticalAlignment="Center" Text="{Binding L10n[Sedentary.StatsHeader]}" />

                        </StackPanel>

                        <Border DockPanel.Dock="Right" Background="#181826" CornerRadius="5" Padding="4,1" VerticalAlignment="Center">

                          <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding L10n[Weather.Today]}" />

                        </Border>

                      </DockPanel>

                      <Grid Row="1" Margin="0,3,0,2">

                        <StackPanel VerticalAlignment="Center">

                          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">

                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" Text="{Binding Water.TotalSittingTodayText}" />

                            <TextBlock FontSize="10" Foreground="#A1A1AA" Margin="4,0,0,2" VerticalAlignment="Bottom" Text="{Binding L10n[Sedentary.StatsDesc]}" />

                          </StackPanel>

                          <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0" Text="{Binding L10n[Sedentary.TotalToday]}" />

                        </StackPanel>

                      </Grid>

                      <Border Grid.Row="2" Background="#161622" CornerRadius="6" Padding="6,4" Margin="0,3,0,4">

                        <Grid>

                          <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*" />

                            <ColumnDefinition Width="1" />

                            <ColumnDefinition Width="*" />

                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0" HorizontalAlignment="Center">

                            <TextBlock FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" Text="{Binding L10n[Sedentary.LongestSession]}" />

                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Text="{Binding Water.LongestSessionTodayText}" />

                          </StackPanel>

                          <Border Grid.Column="1" Background="#262638" Margin="0,1" />

                          <StackPanel Grid.Column="2" HorizontalAlignment="Center">

                            <TextBlock FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" Text="{Binding L10n[Sedentary.StandBreaks]}" />

                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" Text="{Binding Water.BreaksCountTodayText}" />

                          </StackPanel>

                        </Grid>

                      </Border>

                      <DockPanel Grid.Row="3" VerticalAlignment="Center" LastChildFill="False">

                        <TextBlock DockPanel.Dock="Left" FontSize="10" Foreground="#94A3B8" Text="{Binding L10n[Sedentary.Standby]}" />

                        <TextBlock DockPanel.Dock="Right" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}" Text="{Binding L10n[Sedentary.Back]}" />

                      </DockPanel>

                    </Grid>

                  </Grid>

                </Border>

              </Grid>

            </Border>

            <Border Name="SlideNoteCard" Width="584" Height="194" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="#00FFFFFF" BorderThickness="0" Visibility="Collapsed" Opacity="0">

              <Grid Margin="0,2,0,2">

                <Grid.ColumnDefinitions>

                  <ColumnDefinition Width="342" />

                  <ColumnDefinition Width="10" />

                  <ColumnDefinition Width="232" />

                </Grid.ColumnDefinitions>



                <!-- LEFT: NOTE EDITOR & FORMATTING SUITE -->

                <Border Grid.Column="0" Background="#14151C" BorderBrush="#252632" BorderThickness="1" CornerRadius="12" Padding="8,6">

                  <Grid>

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="*" />

                      <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>



                    <!-- Row 0: Note Tabs & Plus Button -->

                    <DockPanel Grid.Row="0" Margin="2,0,2,4">

                      <!-- Plus Button on Right -->

                      <Button DockPanel.Dock="Right" Width="20" Height="20" Cursor="Hand" ToolTip="Add New Note" Click="AddNote_Click" FocusVisualStyle="{x:Null}" Margin="4,0,0,0">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type Button}">

                            <Border Name="bdr" Background="#20212B" BorderBrush="#30313E" BorderThickness="1" CornerRadius="10">

                              <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                            </Border>

                            <ControlTemplate.Triggers>

                              <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bdr" Property="Background" Value="#2E2F3E" />

                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />

                              </Trigger>

                            </ControlTemplate.Triggers>

                          </ControlTemplate>

                        </Control.Template>

                      </Button>



                      <!-- Note Tabs Strip (Scrollable horizontally) -->

                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">

                        <ItemsControl ItemsSource="{Binding Note.Notes}">

                          <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                              <StackPanel Orientation="Horizontal" />

                            </ItemsPanelTemplate>

                          </ItemsControl.ItemsPanel>

                          <ItemsControl.ItemTemplate>

                            <DataTemplate>

                              <Border Name="tabBdr" BorderThickness="1" CornerRadius="7" Margin="0,0,4,0" SnapsToDevicePixels="True">

                                <Border.Style>

                                  <Style TargetType="{x:Type Border}">

                                    <Setter Property="Background" Value="#1C1D27" />

                                    <Setter Property="BorderBrush" Value="#2A2B38" />

                                    <Style.Triggers>

                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">

                                        <Setter Property="Background" Value="#2D2F3E" />

                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />

                                      </DataTrigger>

                                      <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#262734" />

                                      </Trigger>

                                      <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">

                                        <Setter Property="Background" Value="#38151D" />

                                        <Setter Property="BorderBrush" Value="#EF4444" />

                                      </DataTrigger>

                                    </Style.Triggers>

                                  </Style>

                                </Border.Style>

                                <Grid>

                                  <!-- Normal Tab View -->

                                  <DockPanel Name="normalTabPanel" Margin="7,2,5,2" VerticalAlignment="Center">

                                    <DockPanel.Style>

                                      <Style TargetType="{x:Type DockPanel}">

                                        <Setter Property="Visibility" Value="Visible" />

                                        <Style.Triggers>

                                          <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                          </DataTrigger>

                                        </Style.Triggers>

                                      </Style>

                                    </DockPanel.Style>



                <!-- Close Button (shown when tab is hovered) -->

                                    <Button Name="closeBtn" DockPanel.Dock="Right" Width="14" Height="14" Margin="5,0,0,0" Cursor="Hand"

                                            ToolTip="Delete Note"

                                            Command="{Binding DataContext.Note.RequestDeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}"

                                            FocusVisualStyle="{x:Null}">

                                      <Button.Style>

                                        <Style TargetType="{x:Type Button}">

                                          <Setter Property="Visibility" Value="Collapsed" />

                                          <Style.Triggers>

                                            <MultiDataTrigger>

                                              <MultiDataTrigger.Conditions>

                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True" />

                                                <Condition Binding="{Binding DataContext.Note.CanDeleteNotes, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />

                                              </MultiDataTrigger.Conditions>

                                              <Setter Property="Visibility" Value="Visible" />

                                            </MultiDataTrigger>

                                          </Style.Triggers>

                                        </Style>

                                      </Button.Style>

                                      <Control.Template>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                          <Border Name="cBdr" Background="#00FFFFFF" CornerRadius="7">

                                            <Path Name="cPath" Data="M2,2 L8,8 M8,2 L2,8" Stroke="#8E8E9E" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="6.5" Height="6.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                          </Border>

                                          <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                              <Setter TargetName="cBdr" Property="Background" Value="#3F2026" />

                                              <Setter TargetName="cPath" Property="Stroke" Value="#EF4444" />

                                            </Trigger>

                                          </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                      </Control.Template>

                                    </Button>



                                    <!-- Tab Title Button (click selects note) -->

                                    <Button Background="#00FFFFFF" BorderThickness="0" Padding="0" Cursor="Hand" FocusVisualStyle="{x:Null}"

                                            Command="{Binding DataContext.Note.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}">

                                      <Control.Template>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                          <TextBlock Name="tabTitle" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center">

                                            <TextBlock.Style>

                                              <Style TargetType="{x:Type TextBlock}">

                                                <Setter Property="Foreground" Value="#8E8E9E" />

                                                <Setter Property="FontWeight" Value="SemiBold" />

                                                <Style.Triggers>

                                                  <DataTrigger Binding="{Binding IsSelected}" Value="True">

                                                    <Setter Property="Foreground" Value="#FFFFFF" />

                                                    <Setter Property="FontWeight" Value="Bold" />

                                                  </DataTrigger>

                                                </Style.Triggers>

                                              </Style>

                                            </TextBlock.Style>

                                          </TextBlock>

                                        </ControlTemplate>

                                      </Control.Template>

                                    </Button>

                                  </DockPanel>



                                  <!-- Confirm Delete View (shown when confirming delete) -->

                                  <StackPanel Name="confirmPanel" Orientation="Horizontal" Margin="4,2" VerticalAlignment="Center">

                                    <StackPanel.Style>

                                      <Style TargetType="{x:Type StackPanel}">

                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>

                                          <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">

                                            <Setter Property="Visibility" Value="Visible" />

                                          </DataTrigger>

                                        </Style.Triggers>

                                      </Style>

                                    </StackPanel.Style>



                                    <!-- Delete Button (Confirmation) -->

                                    <Button Cursor="Hand" ToolTip="Click to confirm delete" FocusVisualStyle="{x:Null}"

                                            Command="{Binding DataContext.Note.ConfirmDeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}">

                                      <Control.Template>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                          <Border Name="dBdr" Background="#DC2626" CornerRadius="5" Padding="5,1">

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                              <Path Data="M1,2 L7,2 M2.5,2 L2.5,6.5 L5.5,6.5 L5.5,2 M3,1 L5,1" Stroke="#FFFFFF" StrokeThickness="1" Width="6" Height="6" Stretch="Uniform" Margin="0,0,3,0" VerticalAlignment="Center" />

                                              <TextBlock Text="Delete" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />

                                            </StackPanel>

                                          </Border>

                                          <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                              <Setter TargetName="dBdr" Property="Background" Value="#B91C1C" />

                                            </Trigger>

                                          </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                      </Control.Template>

                                    </Button>



                                    <!-- Cancel Button -->

                                    <Button Width="14" Height="14" Margin="3,0,0,0" Cursor="Hand" ToolTip="Cancel" FocusVisualStyle="{x:Null}"

                                            Command="{Binding DataContext.Note.CancelDeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                            CommandParameter="{Binding}">

                                      <Control.Template>

                                        <ControlTemplate TargetType="{x:Type Button}">

                                          <Border Name="cancelBdr" Background="#2E2026" CornerRadius="7">

                                            <Path Name="cancelPath" Data="M2,2 L6,6 M6,2 L2,6" Stroke="#A1A1AA" StrokeThickness="1" Width="5" Height="5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                          </Border>

                                          <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                              <Setter TargetName="cancelBdr" Property="Background" Value="#4B2A30" />

                                              <Setter TargetName="cancelPath" Property="Stroke" Value="#FFFFFF" />

                                            </Trigger>

                                          </ControlTemplate.Triggers>

                                        </ControlTemplate>

                                      </Control.Template>

                                    </Button>

                                  </StackPanel>

                                </Grid>

                              </Border>

                            </DataTemplate>

                          </ItemsControl.ItemTemplate>

                        </ItemsControl>

                      </ScrollViewer>

                    </DockPanel>



                    <!-- Row 1: Note Rich Text Area with Placeholder -->

                    <Grid Grid.Row="1" Margin="2,2,2,2">

                      <TextBlock Name="NotePlaceholder"

                                 Text="Write anything here: an order number, a to-do list, a code snippet. It saves itself."

                                 FontSize="11" Foreground="#8E8E9E" TextWrapping="Wrap" Margin="4,2,4,2" IsHitTestVisible="False" />

                      <RichTextBox Name="NoteRichTextBox"

                                   Background="#00FFFFFF" Foreground="#F4F4F5" CaretBrush="{DynamicResource AccentLightBrush}"

                                   BorderThickness="0" Padding="2" FontSize="11" AcceptsReturn="True" AcceptsTab="True"

                                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"

                                   TextChanged="NoteRichTextBox_TextChanged"

                                   SpellCheck.IsEnabled="False">

                        <FlowDocument PagePadding="0" Background="#00FFFFFF" Foreground="#F4F4F5">

                          <Paragraph Margin="0" FontSize="11" FontFamily="Segoe UI" />

                        </FlowDocument>

                      </RichTextBox>

                    </Grid>



                    <!-- Row 2: Bottom Formatting Toolbar & Actions -->

                    <DockPanel Grid.Row="2" Margin="2,4,2,0">

                <!-- Right Action Buttons (NO redundant checkmark button) -->

                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Set Reminder" Command="{Binding Note.AddReminderCommand}">

                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Path Data="M5,1 C5,0.4 5.4,0 6,0 C6.6,0 7,0.4 7,1 L7,1.2 C9,1.8 10,3.5 10,6 L10.5,7.5 L1.5,7.5 L2,6 C2,3.5 3,1.8 5,1.2 L5,1 M4.5,8.5 C4.5,9.3 5.2,10 6,10 C6.8,10 7.5,9.3 7.5,8.5" Fill="#9CA3AF" Width="7.5" Height="7.5" Stretch="Uniform" Margin="0,0,2,0" VerticalAlignment="Center" />

                            <TextBlock Text="Remind" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center" />

                          </StackPanel>

                        </Button>

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Margin="0,0,4,0" ToolTip="Copy Full Note" Click="CopyNote_Click">

                          <Path Data="M3,3 L9,3 L9,10 L3,10 Z M5,1 L11,1 L11,8" Stroke="#9CA3AF" StrokeThickness="1.2" Width="8" Height="8" Stretch="Uniform" />

                        </Button>

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" ToolTip="Delete Note" Command="{Binding Note.DeleteCurrentNoteCommand}">

                          <Path Data="M2,3 L10,3 M4,3 L4,1 L8,1 L8,3 M3,3 L4,10 L8,10 L9,3" Stroke="#EF4444" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="7.5" Height="7.5" Stretch="Uniform" />

                        </Button>

                      </StackPanel>



                      <!-- Left Formatting Buttons -->

                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Click="FormatBold_Click" ToolTip="Bold (Ctrl+B)">

                          <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" />

                        </Button>

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Click="FormatItalic_Click" ToolTip="Italic (Ctrl+I)">

                          <TextBlock Text="I" FontSize="11" FontStyle="Italic" FontWeight="SemiBold" Foreground="#A1A1AA" />

                        </Button>

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Click="FormatStrike_Click" ToolTip="Strikethrough">

                          <TextBlock Text="S" FontSize="11" TextDecorations="Strikethrough" FontWeight="SemiBold" Foreground="#A1A1AA" />

                        </Button>

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Click="FormatCode_Click" ToolTip="Code">

                          <TextBlock Text="&lt;/&gt;" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" />

                        </Button>

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Click="FormatBullet_Click" ToolTip="Bullet List">

                          <Path Data="M1,2 A1,1 0 1 1 1,2.01 M4,2 L10,2 M1,5 A1,1 0 1 1 1,5.01 M4,5 L10,5 M1,8 A1,1 0 1 1 1,8.01 M4,8 L10,8" Stroke="#A1A1AA" StrokeThickness="1.1" Width="8.5" Height="8" Stretch="Uniform" />

                        </Button>

                        <Button Style="{StaticResource NoteToolbarButtonStyle}" Click="FormatNumber_Click" ToolTip="Numbered List">

                          <TextBlock Text="1=" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" />

                        </Button>

                      </StackPanel>

                    </DockPanel>

                  </Grid>

                </Border>



                <!-- RIGHT: PENGINGAT & ALARM -->

                <Border Grid.Column="2" Background="#14151C" BorderBrush="#252632" BorderThickness="1" CornerRadius="12" Padding="8,6">

                  <Grid>

                    <Grid.RowDefinitions>

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="Auto" />

                      <RowDefinition Height="*" />

                    </Grid.RowDefinitions>



                    <!-- Row 0: Header -->

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">

                      <Border DockPanel.Dock="Right" Background="#1E202B" CornerRadius="8" Padding="5,1">

                        <TextBlock Text="{Binding Note.Reminders.Count, StringFormat='{}{0} Item'}" FontSize="10" Foreground="#8E8E9E" />

                      </Border>

                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Path Data="M6,1 C3.5,1 1.5,3 1.5,5.5 C1.5,8 3.5,10 6,10 C8.5,10 10.5,8 10.5,5.5 C10.5,3 8.5,1 6,1 M6,3 L6,6 L8.5,7.5 M1,2.5 L3,0.5 M11,2.5 L9,0.5"

                              Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"

                              Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />

                        <TextBlock Text="Reminders &amp; Alarm" FontSize="11" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center" />

                      </StackPanel>

                    </DockPanel>



                    <!-- Row 1: Task Input Field -->

                    <Border Grid.Row="1" Background="#1C1D28" BorderBrush="#2A2B3A" BorderThickness="1" CornerRadius="8" Height="22" Padding="6,0" Margin="0,0,0,4">

                      <Grid VerticalAlignment="Center">

                        <TextBlock Text="Alarm / reminder note..." FontSize="11" Foreground="#8E8E9E" VerticalAlignment="Center" IsHitTestVisible="False">

                          <TextBlock.Style>

                            <Style TargetType="{x:Type TextBlock}">

                              <Setter Property="Visibility" Value="Collapsed" />

                              <Style.Triggers>

                                <DataTrigger Value="" Binding="{Binding Note.ReminderInput}">

                                  <Setter Property="Visibility" Value="Visible" />

                                </DataTrigger>

                              </Style.Triggers>

                            </Style>

                          </TextBlock.Style>

                        </TextBlock>

                        <TextBox Text="{Binding Note.ReminderInput, UpdateSourceTrigger=PropertyChanged}"

                                 Background="#00FFFFFF" Foreground="#F4F4F5" CaretBrush="{DynamicResource AccentLightBrush}"

                                 BorderThickness="0" Padding="0" FontSize="11" VerticalAlignment="Center">

                          <TextBox.InputBindings>

                            <KeyBinding Key="Enter" Command="{Binding Note.AddReminderCommand}" />

                          </TextBox.InputBindings>

                        </TextBox>

                      </Grid>

                    </Border>



                    <!-- Row 2: Alarm Time Setter & Quick Presets -->

                    <DockPanel Grid.Row="2" Margin="0,0,0,5">

                      <!-- Set Button -->

                      <Button DockPanel.Dock="Right" Cursor="Hand" Command="{Binding Note.AddReminderCommand}" FocusVisualStyle="{x:Null}" Margin="4,0,0,0">

                        <Control.Template>

                          <ControlTemplate TargetType="{x:Type Button}">

                            <Border Name="bdr" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="7" Padding="7,3">

                              <TextBlock Text="Set" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />

                            </Border>

                            <ControlTemplate.Triggers>

                              <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bdr" Property="Opacity" Value="0.88" />

                              </Trigger>

                            </ControlTemplate.Triggers>

                          </ControlTemplate>

                        </Control.Template>

                      </Button>



                      <!-- Hour : Minute input capsule -->

                      <Border DockPanel.Dock="Left" Background="#1A1B24" BorderBrush="#2C2D3C" BorderThickness="1" CornerRadius="7" Padding="3,1" Margin="0,0,4,0">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <TextBox Text="{Binding Note.AlarmHour, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" Width="16"

                                   Background="#00FFFFFF" Foreground="#FFFFFF" BorderThickness="0" Padding="0" FontSize="11" FontWeight="Bold" TextAlignment="Center" />

                          <TextBlock Text=":" FontSize="11" FontWeight="Bold" Foreground="#8E8E9E" VerticalAlignment="Center" Margin="1,-1,1,0" />

                          <TextBox Text="{Binding Note.AlarmMinute, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" Width="16"

                                   Background="#00FFFFFF" Foreground="#FFFFFF" BorderThickness="0" Padding="0" FontSize="11" FontWeight="Bold" TextAlignment="Center" />

                        </StackPanel>

                      </Border>



                      <!-- Quick Presets -->

                      <UniformGrid Columns="4">

                        <Button Content="+15m" Style="{StaticResource NotePresetButtonStyle}" Command="{Binding Note.SetQuickAlarmCommand}" CommandParameter="+15m" Height="17" FontSize="10" Padding="0" />

                        <Button Content="+30m" Style="{StaticResource NotePresetButtonStyle}" Command="{Binding Note.SetQuickAlarmCommand}" CommandParameter="+30m" Height="17" FontSize="10" Padding="0" />

                        <Button Content="+1h" Style="{StaticResource NotePresetButtonStyle}" Command="{Binding Note.SetQuickAlarmCommand}" CommandParameter="+1h" Height="17" FontSize="10" Padding="0" />

                        <Button Content="Tmrw" Style="{StaticResource NotePresetButtonStyle}" Command="{Binding Note.SetQuickAlarmCommand}" CommandParameter="Tomorrow9" Height="17" FontSize="10" Padding="0" ToolTip="Tomorrow at 09:00" />

                      </UniformGrid>

                    </DockPanel>



                    <!-- Row 3: Reminders & Alarm List -->

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                      <ItemsControl ItemsSource="{Binding Note.Reminders}">

                        <ItemsControl.ItemTemplate>

                          <DataTemplate>

                            <Border Background="#1C1D27" BorderBrush="#2A2B38" BorderThickness="1" CornerRadius="7" Padding="5,3" Margin="0,1.5">

                              <DockPanel LastChildFill="True">

                                <Button DockPanel.Dock="Right" Style="{StaticResource NoteToolbarButtonStyle}" Padding="3,2" Cursor="Hand" ToolTip="Delete Reminder/Alarm" Command="{Binding DataContext.Note.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">

                                  <Path Data="M1,1 L5,5 M5,1 L1,5" Stroke="#EF4444" StrokeThickness="1" Width="5" Height="5" Stretch="Uniform" />

                                </Button>

                                <!-- Time Badge -->

                                <Border DockPanel.Dock="Left" Background="#262738" BorderBrush="#36384C" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,5,0" VerticalAlignment="Center">

                                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Path Data="M4,1 C2.3,1 1,2.3 1,4 C1,5.7 2.3,7 4,7 C5.7,7 7,5.7 7,4 C7,2.3 5.7,1 4,1 M4,2.5 L4,4.2 L5.5,5.2" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="0.8" Width="5" Height="5" Stretch="Uniform" Margin="0,0,2.5,0" VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding FormattedDueTime}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />

                                  </StackPanel>

                                </Border>

                                <!-- Task Text -->

                                <TextBlock Text="{Binding Text}" FontSize="10" Foreground="#E4E4E7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip="{Binding Text}" />

                              </DockPanel>

                            </Border>

                          </DataTemplate>

                        </ItemsControl.ItemTemplate>

                      </ItemsControl>

                    </ScrollViewer>

                  </Grid>

                </Border>

              </Grid>

            </Border>



            <!-- ================= SLIDE 6: CLIPBOARD HISTORY ================= -->

            <Border Name="SlideClipboardCard" Width="584" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="#00FFFFFF" BorderThickness="0" Visibility="Collapsed" Opacity="0">

              <Grid Margin="6,4,6,4">

                <Grid.RowDefinitions>

                  <RowDefinition Height="Auto" />

                  <RowDefinition Height="*" />

                </Grid.RowDefinitions>



                <!-- Header Bar: Title, Search, Clear All -->

                <DockPanel Grid.Row="0" Margin="0,0,0,6">

                  <Button DockPanel.Dock="Right" Cursor="Hand" Command="{Binding Clipboard.ClearAllCommand}" FocusVisualStyle="{x:Null}" ToolTip="Clear all clipboard history">

                    <Control.Template>

                      <ControlTemplate TargetType="{x:Type Button}">

                        <Border Name="bdr" Background="#26181C" BorderBrush="#3D2024" BorderThickness="1" CornerRadius="8" Padding="7,2">

                          <TextBlock Text="Clear All" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />

                        </Border>

                        <ControlTemplate.Triggers>

                          <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="bdr" Property="Background" Value="#3F1D22" />

                            <Setter TargetName="bdr" Property="BorderBrush" Value="#5C262C" />

                          </Trigger>

                        </ControlTemplate.Triggers>

                      </ControlTemplate>

                    </Control.Template>

                  </Button>



                  <Border DockPanel.Dock="Right" Background="#14141E" BorderBrush="#252536" BorderThickness="1" CornerRadius="8" Width="170" Height="21" Margin="0,0,8,0" Padding="6,0">

                    <Grid VerticalAlignment="Center">

                      <TextBlock Text="Search clipboard history..." FontSize="11" Foreground="#8E8E9E" VerticalAlignment="Center" IsHitTestVisible="False">

                        <TextBlock.Style>

                          <Style TargetType="{x:Type TextBlock}">

                            <Setter Property="Visibility" Value="Collapsed" />

                            <Style.Triggers>

                              <DataTrigger Value="" Binding="{Binding Clipboard.SearchQuery}">

                                <Setter Property="Visibility" Value="Visible" />

                              </DataTrigger>

                            </Style.Triggers>

                          </Style>

                        </TextBlock.Style>

                      </TextBlock>

                      <TextBox Text="{Binding Clipboard.SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="#00FFFFFF" Foreground="#FFFFFF" CaretBrush="{DynamicResource AccentLightBrush}" BorderThickness="0" Padding="0" FontSize="11" VerticalAlignment="Center" />

                    </Grid>

                  </Border>



                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Path Data="M4,2 L10,2 M5,1 L9,1 M3,3 L11,3 C11.5,3 12,3.5 12,4 L12,12 C12,12.5 11.5,13 11,13 L3,13 C2.5,13 2,12.5 2,12 L2,4 C2,3.5 2.5,3 3,3" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />

                    <TextBlock Text="RECENT CLIPBOARD" FontSize="11" FontWeight="Bold" Foreground="#A1A1AA" VerticalAlignment="Center" />

                  </StackPanel>

                </DockPanel>



                <!-- Content Area: Split Columns - Left: Screenshots, Right: Copied Text -->

                <Grid Grid.Row="1">

                  <!-- Empty State (When neither screenshots nor text exist) -->

                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Clipboard.HasNoItems, Converter={StaticResource BoolToVis}}">

                    <Path Data="M4,2 L10,2 M5,1 L9,1 M3,3 L11,3 C11.5,3 12,3.5 12,4 L12,12 C12,12.5 11.5,13 11,13 L3,13 C2.5,13 2,12.5 2,12 L2,4 C2,3.5 2.5,3 3,3" Stroke="#383848" StrokeThickness="1.2" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />

                    <TextBlock Text="Clipboard is Empty" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Center" />

                    <TextBlock Text="Copied text or screenshots will automatically appear here" FontSize="10" Foreground="#8E8E9E" HorizontalAlignment="Center" Margin="0,1,0,0" />

                  </StackPanel>



                  <!-- Two-Column Split Layout -->

                  <Grid Visibility="{Binding Clipboard.HasItems, Converter={StaticResource BoolToVis}}">

                    <Grid.ColumnDefinitions>

                      <!-- Left: Screenshots -->

                      <ColumnDefinition Width="*" />

                      <!-- Center Divider -->

                      <ColumnDefinition Width="Auto" />

                      <!-- Right: Copied Text -->

                      <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>



                    <!-- LEFT COLUMN: SCREENSHOTS -->

                    <Grid Grid.Column="0" Margin="0,0,4,0">

                      <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                      </Grid.RowDefinitions>



                      <DockPanel Grid.Row="0" Margin="2,0,0,4">

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                          <Button Style="{StaticResource NoteToolbarButtonStyle}" Padding="4,1" Margin="0,0,4,0" ToolTip="Clear all screenshots" Command="{Binding Clipboard.ClearImagesCommand}" Visibility="{Binding Clipboard.HasImageItems, Converter={StaticResource BoolToVis}}">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                              <Path Data="M1,1 L5,5 M5,1 L1,5" Stroke="#EF4444" StrokeThickness="0.9" Width="4.5" Height="4.5" Stretch="Uniform" Margin="0,0,2.5,0" VerticalAlignment="Center" />

                              <TextBlock Text="Clear" FontSize="10" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" />

                            </StackPanel>

                          </Button>

                          <Border Background="#162338" CornerRadius="4" Padding="4.5,1" Margin="0,0,2,0" VerticalAlignment="Center" Visibility="{Binding Clipboard.HasImageItems, Converter={StaticResource BoolToVis}}">

                            <TextBlock Text="{Binding Clipboard.FilteredImageItems.Count}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />

                          </Border>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M2,3.5 L4,2 L8,2 L10,3.5 L12,3.5 C12.6,3.5 13,3.9 13,4.5 L13,10.5 C13,11.1 12.6,11.5 12,11.5 L2,11.5 C1.4,11.5 1,11.1 1,10.5 L1,4.5 C1,3.9 1.4,3.5 2,3.5 Z M7,9.5 C8.1,9.5 9,8.6 9,7.5 C9,6.4 8.1,5.5 7,5.5 C5.9,5.5 5,6.4 5,7.5 C5,8.6 5.9,9.5 7,9.5 Z" Stroke="#38BDF8" StrokeThickness="1.1" Width="8.5" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />

                          <TextBlock Text="Screenshots" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />

                        </StackPanel>

                      </DockPanel>



                      <!-- Empty Screenshots placeholder -->

                      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Clipboard.HasNoImageItems, Converter={StaticResource BoolToVis}}">

                        <Path Data="M2,3.5 L4,2 L8,2 L10,3.5 L12,3.5 C12.6,3.5 13,3.9 13,4.5 L13,10.5 C13,11.1 12.6,11.5 12,11.5 L2,11.5 C1.4,11.5 1,11.1 1,10.5 L1,4.5 C1,3.9 1.4,3.5 2,3.5 Z" Stroke="#323344" StrokeThickness="1" Width="14" Height="13" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />

                        <TextBlock Text="No screenshots yet" FontSize="10" Foreground="#8E8E9E" HorizontalAlignment="Center" />

                      </StackPanel>



                      <!-- Horizontal Scroll of Screenshots -->

                      <ScrollViewer Grid.Row="1" Style="{StaticResource ModernSlimScrollViewer}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding Clipboard.HasImageItems, Converter={StaticResource BoolToVis}}">

                        <ItemsControl ItemsSource="{Binding Clipboard.FilteredImageItems}">

                          <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                              <StackPanel Orientation="Horizontal" />

                            </ItemsPanelTemplate>

                          </ItemsControl.ItemsPanel>

                          <ItemsControl.ItemTemplate>

                            <DataTemplate>

                              <Border BorderThickness="1" CornerRadius="8" Padding="6,5" Margin="0,0,6,0" Width="124" Height="92">

                                <Border.Style>

                                  <Style TargetType="{x:Type Border}">

                                    <Setter Property="Background" Value="#14151E" />

                                    <Setter Property="BorderBrush" Value="#242534" />

                                    <Style.Triggers>

                                      <Trigger Property="UIElement.IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#171824" />

                                        <Setter Property="BorderBrush" Value="#38BDF8" />

                                      </Trigger>

                                    </Style.Triggers>

                                  </Style>

                                </Border.Style>

                                <Grid>

                                  <Grid.RowDefinitions>

                                    <RowDefinition Height="*" />

                                    <RowDefinition Height="Auto" />

                                  </Grid.RowDefinitions>



                                  <Button Grid.Row="0" Style="{StaticResource ClipboardContentButtonStyle}" ToolTip="Click to copy image" Command="{Binding DataContext.Clipboard.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">

                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="54" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                  </Button>



                                  <DockPanel Grid.Row="1" Margin="0,3,0,0">

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                                      <Button Style="{StaticResource NoteToolbarButtonStyle}" Padding="3,2" ToolTip="Copy Image" Command="{Binding DataContext.Clipboard.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">

                                        <Path Data="M2,2 L7,2 L7,8 L2,8 Z M4,0 L9,0 L9,6" Stroke="{DynamicResource AccentLightBrush}" StrokeThickness="1" Width="6.5" Height="6.5" Stretch="Uniform" />

                                      </Button>

                                      <Button Style="{StaticResource NoteToolbarButtonStyle}" Padding="3,2" Margin="2,0,0,0" ToolTip="Delete" Command="{Binding DataContext.Clipboard.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">

                                        <Path Data="M1,1 L5,5 M5,1 L1,5" Stroke="#EF4444" StrokeThickness="1" Width="5" Height="5" Stretch="Uniform" />

                                      </Button>

                                    </StackPanel>

                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center" />

                                  </DockPanel>

                                </Grid>

                              </Border>

                            </DataTemplate>

                          </ItemsControl.ItemTemplate>

                        </ItemsControl>

                      </ScrollViewer>

                    </Grid>



                    <!-- VERTICAL SEPARATOR -->

                    <Border Grid.Column="1" Width="1" Background="#20212E" Margin="4,2,4,2" HorizontalAlignment="Center" />



                    <!-- RIGHT COLUMN: COPIED TEXT -->

                    <Grid Grid.Column="2" Margin="4,0,0,0">

                      <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                      </Grid.RowDefinitions>



                      <DockPanel Grid.Row="0" Margin="2,0,0,4">

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                          <Button Style="{StaticResource NoteToolbarButtonStyle}" Padding="4,1" Margin="0,0,4,0" ToolTip="Clear all copied text" Command="{Binding Clipboard.ClearTextsCommand}" Visibility="{Binding Clipboard.HasTextItems, Converter={StaticResource BoolToVis}}">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                              <Path Data="M1,1 L5,5 M5,1 L1,5" Stroke="#EF4444" StrokeThickness="0.9" Width="4.5" Height="4.5" Stretch="Uniform" Margin="0,0,2.5,0" VerticalAlignment="Center" />

                              <TextBlock Text="Clear" FontSize="10" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" />

                            </StackPanel>

                          </Button>

                          <Border Background="#142C20" CornerRadius="4" Padding="4.5,1" Margin="0,0,2,0" VerticalAlignment="Center" Visibility="{Binding Clipboard.HasTextItems, Converter={StaticResource BoolToVis}}">

                            <TextBlock Text="{Binding Clipboard.FilteredTextItems.Count}" FontSize="10" FontWeight="Bold" Foreground="#34D399" />

                          </Border>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                          <Path Data="M3,1 L8,1 L11,4 L11,11 C11,11.5 10.5,12 10,12 L3,12 C2.5,12 2,11.5 2,11 L2,2 C2,1.5 2.5,1 3,1 Z M7.5,1.5 L7.5,4.5 L10.5,4.5 M4,6 L9,6 M4,8 L9,8 M4,10 L7.5,10" Stroke="#34D399" StrokeThickness="1" Width="8" Height="8.5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />

                          <TextBlock Text="Copied Text" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />

                        </StackPanel>

                      </DockPanel>



                      <!-- Empty Text placeholder -->

                      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Clipboard.HasNoTextItems, Converter={StaticResource BoolToVis}}">

                        <Path Data="M3,1 L8,1 L11,4 L11,11 C11,11.5 10.5,12 10,12 L3,12 C2.5,12 2,11.5 2,11 L2,2 C2,1.5 2.5,1 3,1 Z" Stroke="#323344" StrokeThickness="1" Width="13" Height="14" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,4" />

                        <TextBlock Text="No copied text yet" FontSize="10" Foreground="#8E8E9E" HorizontalAlignment="Center" />

                      </StackPanel>



                      <!-- Vertical Scrollable List of Copied Text -->

                      <ScrollViewer Grid.Row="1" Style="{StaticResource ModernSlimScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding Clipboard.HasTextItems, Converter={StaticResource BoolToVis}}">

                        <ItemsControl ItemsSource="{Binding Clipboard.FilteredTextItems}">

                          <ItemsControl.ItemTemplate>

                            <DataTemplate>

                              <Border BorderThickness="1" CornerRadius="7" Padding="6,4" Margin="0,0,4,4">

                                <Border.Style>

                                  <Style TargetType="{x:Type Border}">

                                    <Setter Property="Background" Value="#14151E" />

                                    <Setter Property="BorderBrush" Value="#242534" />

                                    <Style.Triggers>

                                      <Trigger Property="UIElement.IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="#171824" />

                                        <Setter Property="BorderBrush" Value="#34D399" />

                                      </Trigger>

                                    </Style.Triggers>

                                  </Style>

                                </Border.Style>

                                <Grid>

                                  <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                  </Grid.RowDefinitions>



                                  <Button Grid.Row="0" Style="{StaticResource ClipboardContentButtonStyle}" HorizontalContentAlignment="Stretch" ToolTip="{Binding TextContent}" Command="{Binding DataContext.Clipboard.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">

                                    <TextBlock Text="{Binding PreviewText}" FontSize="10" Foreground="#E4E4E7" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" LineHeight="14" />

                                  </Button>



                                  <DockPanel Grid.Row="1" Margin="0,3,0,0">

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

