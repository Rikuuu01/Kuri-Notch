<UserControl x:Class="NotchWin.Controls.MusicVisualizer"
             x:Name="RootVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="12" Height="12"
             Background="Transparent"
             Focusable="False"
             IsHitTestVisible="False">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Left Bar (Bar 1) -->
            <Border x:Name="Bar1" 
                    Width="2.2" 
                    Height="11" 
                    CornerRadius="1.1" 
                    Background="{Binding BarBrush, ElementName=RootVisualizer}" 
                    Margin="0,0,1.8,0" 
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Bar1Scale" ScaleY="0.22"/>
                </Border.RenderTransform>
            </Border>

            <!-- Center Bar (Bar 2 - Primary Pulse / Epicenter) -->
            <Border x:Name="Bar2" 
                    Width="2.2" 
                    Height="11" 
                    CornerRadius="1.1" 
                    Background="{Binding BarBrush, ElementName=RootVisualizer}" 
                    Margin="0,0,1.8,0" 
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Bar2Scale" ScaleY="0.22"/>
                </Border.RenderTransform>
            </Border>

            <!-- Right Bar (Bar 3) -->
            <Border x:Name="Bar3" 
                    Width="2.2" 
                    Height="11" 
                    CornerRadius="1.1" 
                    Background="{Binding BarBrush, ElementName=RootVisualizer}" 
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Bar3Scale" ScaleY="0.22"/>
                </Border.RenderTransform>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
