<UserControl x:Class="NotchWin.Controls.EggMascotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="28" Height="20"
             Background="Transparent"
             Focusable="False"
             SnapsToDevicePixels="False">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BodyBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InkBrush" Color="#111111"/>
        <SolidColorBrush x:Key="BlushBrush" Color="#FFB0C6"/>

        <!-- Headphone berwarna pastel agar tetap terlihat di latar notch yang hitam -->
        <SolidColorBrush x:Key="HeadphoneBrush" Color="#8E9BFF"/>
        <SolidColorBrush x:Key="CupBrush" Color="#7B88F5"/>

        <SolidColorBrush x:Key="PlateBrush" Color="#1E1E2A"/>
        <SolidColorBrush x:Key="PlateEdgeBrush" Color="#454568"/>
    </UserControl.Resources>

    <Canvas Width="28" Height="20">

        <!-- ============ TELUR (bergerak sebagai satu kesatuan) ============ -->
        <Canvas Width="28" Height="20" RenderTransformOrigin="0.5,0.9">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BodyScale"/>
                    <RotateTransform x:Name="BodyTilt"/>
                    <TranslateTransform x:Name="BodyShift"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Lengan untuk animasi Welcome: di belakang badan, pangkalnya tersembunyi di balik telur.
                 Pivot bahu (20.3, 12.2). Sudut 0 = menggantung ke bawah, -135 = terangkat ke kanan-atas. -->
            <Canvas x:Name="ArmWave" Canvas.Left="19" Canvas.Top="11.2" Width="2.6" Height="6"
                    Opacity="0" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ArmScale" CenterX="1.3" CenterY="1"/>
                        <RotateTransform x:Name="ArmRotate" Angle="-60" CenterX="1.3" CenterY="1"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Border Width="2.6" Height="6" CornerRadius="1.3"
                        Background="{StaticResource BodyBrush}"
                        BorderBrush="{StaticResource InkBrush}" BorderThickness="0.6"/>
            </Canvas>

            <!-- Badan telur -->
            <Path Data="M 14,2.6 C 18.6,2.6 21.1,7.8 21.1,12.5 C 21.1,16.5 18,19 14,19 C 10,19 6.9,16.5 6.9,12.5 C 6.9,7.8 9.4,2.6 14,2.6 Z"
                  Fill="{StaticResource BodyBrush}"
                  Stroke="{StaticResource InkBrush}" StrokeThickness="0.7" StrokeLineJoin="Round"/>

            <!-- Pipi merona -->
            <Ellipse x:Name="BlushL" Canvas.Left="8.6" Canvas.Top="11.9" Width="2.6" Height="1.4"
                     Fill="{StaticResource BlushBrush}" Opacity="0"/>
            <Ellipse x:Name="BlushR" Canvas.Left="16.8" Canvas.Top="11.9" Width="2.6" Height="1.4"
                     Fill="{StaticResource BlushBrush}" Opacity="0"/>

            <!-- Mata terbuka: oval hitam polos (digerakkan lewat PupilTranslate) -->
            <Canvas x:Name="EyesOpen" Width="28" Height="20" RenderTransformOrigin="0.5,0.465">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="EyeWide"/>
                        <ScaleTransform x:Name="EyeBlink"/>
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- Clip menjaga mata tetap di dalam badan telur -->
                <Canvas>
                    <Canvas.Clip>
                        <EllipseGeometry Center="14,10.8" RadiusX="6" RadiusY="7.2"/>
                    </Canvas.Clip>
                    <Canvas>
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="PupilTranslate"/>
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="10.9" Canvas.Top="7.2" Width="1.8" Height="4.2"
                                 Fill="{StaticResource InkBrush}"/>
                        <Ellipse Canvas.Left="15.3" Canvas.Top="7.2" Width="1.8" Height="4.2"
                                 Fill="{StaticResource InkBrush}"/>
                    </Canvas>
                </Canvas>
            </Canvas>

            <!-- Mata senang (^ ^) -->
            <Path x:Name="EyesHappy"
                  Opacity="0"
                  Data="M 10.6,10.4 Q 11.8,7.4 13,10.4 M 15,10.4 Q 16.2,7.4 17.4,10.4"
                  Stroke="{StaticResource InkBrush}"
                  StrokeThickness="1.1"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"/>

            <!-- Mata tidur (- -) -->
            <Path x:Name="EyesSleep"
                  Opacity="0"
                  Data="M 10.7,9.6 L 12.9,9.6 M 15.1,9.6 L 17.3,9.6"
                  Stroke="{StaticResource InkBrush}"
                  StrokeThickness="1"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

            <!-- Headphone (skala 0 = tersembunyi, 1 = tampil penuh) -->
            <Canvas Width="28" Height="20" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="HeadphoneScale" ScaleX="0" ScaleY="0"/>
                </Canvas.RenderTransform>

                <Path Data="M 7.2,8.6 C 6.6,4.4 9.6,1.5 14,1.5 C 18.4,1.5 21.4,4.4 20.8,8.6"
                      Stroke="{StaticResource HeadphoneBrush}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
                <Border Canvas.Left="5.6" Canvas.Top="6.4" Width="3" Height="5.4"
                        CornerRadius="1.5"
                        Background="{StaticResource CupBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="0.5"/>
                <Border Canvas.Left="19.4" Canvas.Top="6.4" Width="3" Height="5.4"
                        CornerRadius="1.5"
                        Background="{StaticResource CupBrush}"
                        BorderBrush="{StaticResource InkBrush}"
                        BorderThickness="0.5"/>
            </Canvas>

            <!-- Kilat kamera (screenshot): telur putih yang sedikit lebih besar dari badan,
                 sehingga kontur hitam hilang sesaat dan terlihat "menyala" di latar hitam -->
            <Path x:Name="FlashOverlay"
                  Data="M 14,2.6 C 18.6,2.6 21.1,7.8 21.1,12.5 C 21.1,16.5 18,19 14,19 C 10,19 6.9,16.5 6.9,12.5 C 6.9,7.8 9.4,2.6 14,2.6 Z"
                  Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"
                  Opacity="0" IsHitTestVisible="False"/>
        </Canvas>

        <!-- ============ EFEK (tidak ikut bergoyang bersama badan) ============ -->

        <!-- Not musik -->
        <Canvas x:Name="NoteA" Canvas.Left="24.2" Canvas.Top="7" Opacity="0" IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="NoteATranslate"/>
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="0.2" Canvas.Top="3.3" Width="2.2" Height="1.6" Fill="#C9D6FF"/>
            <Path Data="M 2.3,4 L 2.3,0.4 Q 3.6,0.9 3.6,2.4"
                  Stroke="#C9D6FF" StrokeThickness="0.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>
        <Canvas x:Name="NoteB" Canvas.Left="24.2" Canvas.Top="9" Opacity="0" IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="NoteBTranslate"/>
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="0.2" Canvas.Top="3.3" Width="2.2" Height="1.6" Fill="#FFC9E4"/>
            <Path Data="M 2.3,4 L 2.3,0.4 Q 3.6,0.9 3.6,2.4"
                  Stroke="#FFC9E4" StrokeThickness="0.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Canvas>

        <!-- Huruf Z (tidur) -->
        <Path x:Name="ZA" Canvas.Left="22.5" Canvas.Top="5" Opacity="0" IsHitTestVisible="False"
              Data="M 0,0 L 2.4,0 L 0,2.4 L 2.4,2.4"
              Stroke="#D5E0FF" StrokeThickness="0.7" StrokeLineJoin="Round">
            <Path.RenderTransform>
                <TranslateTransform x:Name="ZATranslate"/>
            </Path.RenderTransform>
        </Path>
        <Path x:Name="ZB" Canvas.Left="22.5" Canvas.Top="5" Opacity="0" IsHitTestVisible="False"
              Data="M 0,0 L 3.2,0 L 0,3.2 L 3.2,3.2"
              Stroke="#D5E0FF" StrokeThickness="0.7" StrokeLineJoin="Round">
            <Path.RenderTransform>
                <TranslateTransform x:Name="ZBTranslate"/>
            </Path.RenderTransform>
        </Path>
        <Path x:Name="ZC" Canvas.Left="22.5" Canvas.Top="5" Opacity="0" IsHitTestVisible="False"
              Data="M 0,0 L 4,0 L 0,4 L 4,4"
              Stroke="#D5E0FF" StrokeThickness="0.7" StrokeLineJoin="Round">
            <Path.RenderTransform>
                <TranslateTransform x:Name="ZCTranslate"/>
            </Path.RenderTransform>
        </Path>

        <!-- Kilau (senang / welcome) -->
        <Path x:Name="Spark1" Canvas.Left="22.5" Canvas.Top="1.5" Opacity="0" IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5"
              Data="M 2,0 L 2.6,1.4 L 4,2 L 2.6,2.6 L 2,4 L 1.4,2.6 L 0,2 L 1.4,1.4 Z"
              Fill="#FFE98A">
            <Path.RenderTransform>
                <ScaleTransform x:Name="Spark1Scale" ScaleX="0.3" ScaleY="0.3"/>
            </Path.RenderTransform>
        </Path>
        <Path x:Name="Spark2" Canvas.Left="1" Canvas.Top="1.5" Opacity="0" IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5"
              Data="M 2,0 L 2.6,1.4 L 4,2 L 2.6,2.6 L 2,4 L 1.4,2.6 L 0,2 L 1.4,1.4 Z"
              Fill="#FFE98A">
            <Path.RenderTransform>
                <ScaleTransform x:Name="Spark2Scale" ScaleX="0.3" ScaleY="0.3"/>
            </Path.RenderTransform>
        </Path>

        <!-- ============ BADGE PERINGATAN (pojok kanan atas) ============ -->
        <Canvas Canvas.Left="19.2" Canvas.Top="0" Width="9" Height="9"
                RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BadgeScale" ScaleX="0" ScaleY="0"/>
                    <ScaleTransform x:Name="BadgePulse"/>
                    <TranslateTransform x:Name="BadgeShift"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <Ellipse Width="9" Height="9"
                     Fill="{StaticResource PlateBrush}"
                     Stroke="{StaticResource PlateEdgeBrush}"
                     StrokeThickness="0.6"/>

            <!-- Notifikasi: lonceng -->
            <Canvas x:Name="IconBell" Width="9" Height="9" Visibility="Collapsed">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BellRotate" CenterX="4.5" CenterY="1.6"/>
                </Canvas.RenderTransform>
                <Path Fill="#FFD66B"
                      Data="M 4.5,1.6 C 3.1,1.6 2.6,2.8 2.6,4 L 2.6,5.1 L 1.9,6 L 7.1,6 L 6.4,5.1 L 6.4,4 C 6.4,2.8 5.9,1.6 4.5,1.6 Z"/>
                <Ellipse Canvas.Left="3.8" Canvas.Top="6.4" Width="1.4" Height="1.1" Fill="#FFD66B"/>
            </Canvas>

            <!-- Alarm: jam weker -->
            <Canvas x:Name="IconAlarm" Width="9" Height="9" Visibility="Collapsed">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="AlarmRotate" CenterX="4.5" CenterY="5.2"/>
                </Canvas.RenderTransform>
                <Ellipse Canvas.Left="2" Canvas.Top="2.7" Width="5" Height="5"
                         Stroke="#FF8A8A" StrokeThickness="0.8"/>
                <Path Data="M 4.5,5.2 L 4.5,3.9 M 4.5,5.2 L 5.5,5.8"
                      Stroke="#FF8A8A" StrokeThickness="0.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse Canvas.Left="1.2" Canvas.Top="1.7" Width="2" Height="1.3" Fill="#FF8A8A"/>
                <Ellipse Canvas.Left="5.8" Canvas.Top="1.7" Width="2" Height="1.3" Fill="#FF8A8A"/>
            </Canvas>

            <!-- Minum: tetes air -->
            <Canvas x:Name="IconDrink" Width="9" Height="9" Visibility="Collapsed">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="DropShift"/>
                </Canvas.RenderTransform>
                <Path Fill="#6EC8FF"
                      Data="M 4.5,1.4 C 4.5,1.4 2.4,4.1 2.4,5.5 C 2.4,6.8 3.3,7.6 4.5,7.6 C 5.7,7.6 6.6,6.8 6.6,5.5 C 6.6,4.1 4.5,1.4 4.5,1.4 Z"/>
                <Ellipse Canvas.Left="3.3" Canvas.Top="5" Width="0.9" Height="1.4" Fill="White" Opacity="0.7"/>
            </Canvas>

            <!-- Timer: stopwatch -->
            <Canvas x:Name="IconTimer" Width="9" Height="9" Visibility="Collapsed">
                <Ellipse Canvas.Left="2" Canvas.Top="2.6" Width="5" Height="5"
                         Stroke="#9CF0B5" StrokeThickness="0.8"/>
                <Path Data="M 3.7,1.7 L 5.3,1.7"
                      Stroke="#9CF0B5" StrokeThickness="0.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="M 4.5,5.1 L 4.5,3.7"
                      Stroke="#9CF0B5" StrokeThickness="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="TimerHandRotate" CenterX="4.5" CenterY="5.1"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <!-- Adzan: bulan sabit + bintang -->
            <Canvas x:Name="IconAdzan" Width="9" Height="9" Visibility="Collapsed">
                <Path Fill="#FFE9A8">
                    <Path.Data>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <EllipseGeometry Center="4.1,4.6" RadiusX="2.9" RadiusY="2.9"/>
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <EllipseGeometry Center="5.2,3.9" RadiusX="2.5" RadiusY="2.5"/>
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </Path.Data>
                </Path>
                <Path x:Name="AdzanStar" Fill="#FFE9A8"
                      Data="M 6,2.2 L 6.3,2.9 L 7,3.2 L 6.3,3.5 L 6,4.2 L 5.7,3.5 L 5,3.2 L 5.7,2.9 Z"/>
            </Canvas>

            <!-- Bluetooth terhubung -->
            <Canvas x:Name="IconBluetooth" Width="9" Height="9" Visibility="Collapsed">
                <Ellipse x:Name="BtRing" Width="9" Height="9"
                         Stroke="#6EA8FF" StrokeThickness="0.6"
                         Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="BtRingScale" ScaleX="0.7" ScaleY="0.7"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Path Data="M 3.2,5.8 L 5.8,3.2 L 4.5,2 L 4.5,7 L 5.8,5.8 L 3.2,3.2"
                      Stroke="#6EA8FF" StrokeThickness="0.8"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>

            <!-- Teks disalin: clipboard + centang -->
            <Canvas x:Name="IconCopied" Width="9" Height="9" Visibility="Collapsed">
                <Border Canvas.Left="2.5" Canvas.Top="2.3" Width="4" Height="5.2"
                        CornerRadius="0.8" BorderBrush="#E6E9F5" BorderThickness="0.7"/>
                <Border Canvas.Left="3.5" Canvas.Top="1.6" Width="2" Height="1.2"
                        CornerRadius="0.4" Background="#E6E9F5"/>
                <Path Data="M 3.5,5 L 4.3,5.8 L 5.6,4.2"
                      Stroke="#7CF2A0" StrokeThickness="0.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>

            <!-- Tangkapan layar: kamera -->
            <Canvas x:Name="IconScreenshot" Width="9" Height="9" Visibility="Collapsed">
                <Border Canvas.Left="1.8" Canvas.Top="3" Width="5.4" Height="3.8"
                        CornerRadius="0.9" Background="#E6E9F5"/>
                <Border Canvas.Left="3.4" Canvas.Top="2.2" Width="2.2" Height="1.2"
                        CornerRadius="0.4" Background="#E6E9F5"/>
                <Ellipse Canvas.Left="3.6" Canvas.Top="3.9" Width="1.8" Height="1.8"
                         Fill="{StaticResource PlateBrush}"/>
            </Canvas>
        </Canvas>

    </Canvas>
</UserControl>
